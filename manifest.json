{
  "manifest_version": 2,
  "name": "PaperMirror for Zotero",
  "version": "0.3.0",
  "description": "Bilingual side-by-side reading mode for the Zotero PDF reader (原文 + 译文双屏对照阅读)",
  "author": "PaperMirror Contributors",
  "homepage_url": "https://github.com/local/zotero-bilingual-reader",
  "icons": {
    "48": "content/icons/icon48.png",
    "96": "content/icons/icon96.png"
  },
  "applications": {
    "zotero": {
      "id": "zotero-bilingual-reader@local",
      "update_url": "https://raw.githubusercontent.com/local/zotero-bilingual-reader/main/updates.json",
      "strict_min_version": "9.0",
      "strict_max_version": "9.0.*"
    }
  }
}