{
	"name": "zotero-bilingual-reader",
	"version": "0.7.7",
	"description": "PaperMirror for Zotero — bilingual side-by-side reading mode for the Zotero PDF reader",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
		"build": "node scripts/build.mjs",
		"test": "npm run typecheck:tests && node scripts/test.mjs",
		"package": "node scripts/package.mjs",
		"gen:updates": "node scripts/gen-updates.mjs",
		"dev-install": "node scripts/dev-install.mjs"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"esbuild": "^0.24.0",
		"typescript": "^5.6.0"
	},
	"dependencies": {
		"@pdf-lib/fontkit": "^1.1.1",
		"pdf-lib": "^1.17.1"
	}
}
