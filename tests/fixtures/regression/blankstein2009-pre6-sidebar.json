5, 576.9615000000002], "evidence": "table-model"}}, {"id": "page-1-inline-abbrev-6", "pageIndex": 1, "order": 6, "type": "paragraph", "sourceText": "MPHR = maximal predicted heart rate", "fontSize": 6.5, "boundingBox": {"x": 456.69900000000007, "y": 220.03549999999973, "width": 58.67549999999994, "height": 15.996499999999969}, "lineRectsPdf": [[456.69900000000007, 547.4645000000003, 475.02900000000005, 553.9645000000003], [477.1935000000001, 547.4645000000003, 482.60800000000006, 553.9645000000003], [484.7725000000001, 547.4645000000003, 509.3425000000001, 553.9645000000003], [456.7055000000001, 537.9680000000003, 515.3745, 544.4680000000003]], "tableId": "page-1-inline-abbreviations", "tableRow": 6, "tableCol": 0, "tableSource": "abbreviation", "tableConfidence": "strong", "tableGeometry": "inferred", "tableContentRectPdf": [456.69900000000007, 537.9680000000003, 515.3745, 553.9645000000003], "translationMode": "translate", "readingIndex": 18, "sourceRegion": {"id": "page-1-cell-page-1-inline-abbreviations-6-0", "kind": "table-cell", "boundsPdf": [456.69900000000007, 537.9680000000003, 515.3745, 553.9645000000003], "evidence": "table-model"}}, {"id": "page-1-inline-abbrev-7", "pageIndex": 1, "order": 7, "type": "paragraph", "sourceText": "MPI = myocardial perfusion imaging", "fontSize": 6.5, "boundingBox": {"x": 456.7055000000001, "y": 243.0324999999997, "width": 81.84800000000001, "height": 15.996499999999969}, "lineRectsPdf": [[456.7055000000001, 524.4675000000003, 468.4055000000001, 530.9675000000003], [470.5700000000001, 524.4675000000003, 475.9845000000001, 530.9675000000003], [478.1490000000001, 524.4675000000003, 538.5535000000001, 530.9675000000003], [456.7120000000001, 514.9710000000003, 479.7220000000001, 521.4710000000003]], "tableId": "page-1-inline-abbreviations", "tableRow": 7, "tableCol": 0, "tableSource": "abbreviation", "tableConfidence": "strong", "tableGeometry": "inferred", "tableContentRectPdf": [456.7055000000001, 514.9710000000003, 538.5535000000001, 530.9675000000003], "translationMode": "translate", "readingIndex": 19, "sourceRegion": {"id": "page-1-cell-page-1-inline-abbreviations-7-0", "kind": "table-cell", "boundsPdf": [456.7055000000001, 514.9710000000003, 538.5535000000001, 530.9675000000003], "evidence": "table-model"}}, {"id": "page-1-inline-abbrev-8", "pageIndex": 1, "order": 8, "type": "paragraph", "sourceText": "MRI = magnetic resonance imaging", "fontSize": 6.5, "boundingBox": {"x": 456.7120000000001, "y": 266.0294999999997, "width": 81.06799999999998, "height": 15.996500000000026}, "lineRectsPdf": [[456.7120000000001, 501.4705000000003, 468.6720000000001, 507.9705000000003], [470.8365000000001, 501.4705000000003, 476.2510000000001, 507.9705000000003], [478.4155000000001, 501.4705000000003, 537.7800000000001, 507.9705000000003], [456.7185000000001, 491.9740000000003, 479.7285000000001, 498.4740000000003]], "tableId": "page-1-inline-abbreviations", "tableRow": 8, "tableCol": 0, "tableSource": "abbreviation", "tableConfidence": "strong", "tableGeometry": "inferred", "tableContentRectPdf": [456.7120000000001, 491.9740000000003, 537.7800000000001, 507.9705000000003], "translationMode": "translate", "readingIndex": 20, "sourceRegion": {"id": "page-1-cell-page-1-inline-abbreviations-8-0", "kind": "table-cell", "boundsPdf": [456.7120000000001, 491.9740000000003, 537.7800000000001, 507.9705000000003], "evidence": "table-model"}}, {"id": "page-1-inline-abbrev-9", "pageIndex": 1, "order": 9, "type": "paragraph", "sourceText": "SPECT = single-photon emission computed tomography", "fontSize": 6.5, "boundingBox": {"x": 456.7185000000001, "y": 289.0264999999997, "width": 68.11349999999999, "height": 25.493000000000052}, "lineRectsPdf": [[456.7185000000001, 478.4735000000003, 476.2185000000001, 484.9735000000003], [478.3830000000001, 478.4735000000003, 483.79750000000007, 484.9735000000003], [485.9620000000001, 478.4735000000003, 524.8320000000001, 484.9735000000003], [456.7250000000001, 468.97700000000026, 513.4895, 475.47700000000026], [456.7250000000001, 459.48050000000023, 491.0450000000001, 465.98050000000023]], "tableId": "page-1-inline-abbreviations", "tableRow": 9, "tableCol": 0, "tableSource": "abbreviation", "tableConfidence": "strong", "tableGeometry": "inferred", "tableContentRectPdf": [456.7185000000001, 459.48050000000023, 524.8320000000001, 484.9735000000003], "translationMode": "translate", "readingIndex": 21, "sourceRegion": {"id": "page-1-cell-page-1-inline-abbreviations-9-0", "kind": "table-cell", "boundsPdf": [456.7185000000001, 459.48050000000023, 524.8320000000001, 484.9735000000003], "evidence": "table-model"}}], "translations": [{"id": "page-1-region-0", "translatedText": "关于心肌灌注成像（MPI）预后价值的大量数据表明，梗死与缺血负荷的量与长期结局相关，并有助于决定哪些患者最适合血运重建而非药物治疗(2,3)。因此，将计算机断层扫描血管造影（CTA）的解剖数据与灌注提供的生理意义相结合可能有益(4,5)。CT识别静息心肌灌注缺损（即心肌梗死区域）的能力已在动物和人体研究中得到证实(6 –10)。此类研究显示，多排CT上的低强化区域直接对应于MRI所见的灌注缺损以及三苯基四氮唑氯化物染色所显示的心肌梗死区域。这些及其他研究表明，CT所用碘化对比剂的动力学与MRI所用钆相似(11)。因此，对比剂给药后即刻成像显示对应于灌注缺损的低强化区（即对比剂延迟流入），而给药后5至10分钟采集的延迟成像可显示对应于心肌坏死或瘢痕区域的局部延迟高强化（即对比剂延迟流出）(11)。近期，狭窄动物模型和初步人体研究显示，CT还可诊断腺苷诱导负荷下的缺血心肌区域(12–14)。在人体中实施包含冠状动脉成像、负荷与静息心肌灌注及延迟强化（DE）成像的综合性CT检查的可行性和准确性尚不明确。因此，我们旨在确定腺苷介导的负荷双源计算机断层扫描（DSCT）在识别血流动力学显著狭窄方面的可行性和诊断准确性，并以有创血管造影作为参考标准，与核素MPI进行比较。"}, {"id": "page-1-region-1", "translatedText": "方法"}, {"id": "page-1-region-2", "translatedText": "研究人群。纳入研究的合格受试者包括本机构的767名连续患者，年龄均为≤40岁，接受了核素负荷试验，并被转介以进行侵入性血管造影或具有很高的进行侵入性血管造影的可能性。纳入资格评估基于筛查以下2类人群：1）所有计划接受临床指征所需的侵入性血管造影且在先前3个月内已完成核素心肌灌注显像（MPI）的患者；以及2）所有接受核素MPI并发现具有高风险特征的患者（即很可能被转介进行侵入性血管造影的患者）。排除原因包括：不稳定的临床状态、急性冠状动脉综合征、哮喘、严重主动脉瓣狭窄，以及已知对含碘对比剂过敏。图1总结了患者流程以及具体的排除原因。CT结果被盲法处理，未提供给转介"}, {"id": "page-1-region-3", "translatedText": "医师，故未影响接受心导管检查的决定。研究经Partners Health Care System机构审查委员会批准，所有受试者均签署知情同意书。图像采集：综合CT方案。嘱患者扫描前至少24 h不摄入咖啡因。到达后置入2条静脉通路（18 G用于对比剂输注；20 G用于腺苷输注）。鉴于心脏CT常用药物（即硝酸甘油、β受体阻滞剂）可能影响心肌灌注(15)，除腺苷外未给予其他药物。CT采用64层DSCT扫描仪（Definition，Siemens Medical Systems，Forchheim，德国），机架旋转时间330 ms。沿z轴飞焦点（z-sharp技术）以两排32探测器采集64层0.6 mm重叠层。时间分辨率为83 ms。"}, {"id": "page-1-region-4", "translatedText": "图2显示了包括负荷、静息和DE采集的CT方案。获得定位像后，使用10至15 ml对比剂试验团注确定对比剂 timing。试验团注和图像采集的流速通常为4至5 ml/s，随后以20 ml生理盐水冲管。随后，对于负荷和静息扫描，图像采集时机通过在升主动脉对比剂强化峰值时间上增加2至4 s来确定，以使心肌得以灌注。"}, {"id": "page-1-region-5", "translatedText": "试验团注后，以140 μg/kg/min开始输注腺苷。输注开始3分钟后，采用回顾性门控扫描，并进行管电流调制和螺距适配。管电压（kV）和电流（mAs）根据患者体型选择。虽然大多数患者使用120 kV，但对于体重指数≤30 kg/m²的非肥胖者（即体重≤220磅），使用100 kV。该部分检查的典型对比剂剂量为65 ml碘帕醇，以4至5 ml/s的速率给药。在整个输注过程中，由心脏科医师监测患者症状、心率、血压和心电图。表1总结了CT扫描参数。负荷CT后立即停止腺苷输注。症状缓解且心率恢复至基线（通常5分钟）后，进行静息CT扫描。为减少辐射暴露，静息CT使用"}, {"id": "page-1-inline-abbrev-heading", "translatedText": "缩略语"}, {"id": "page-1-inline-abbrev-0", "translatedText": "CAD = 冠状动脉疾病"}, {"id": "page-1-inline-abbrev-1", "translatedText": "CT = 计算机断层扫描"}, {"id": "page-1-inline-abbrev-2", "translatedText": "CTA = 计算机断层扫描血管造影"}, {"id": "page-1-inline-abbrev-3", "translatedText": "CTP = 计算机断层扫描灌注成像"}, {"id": "page-1-inline-abbrev-4", "translatedText": "DE = 延迟增强"}, {"id": "page-1-inline-abbrev-5", "translatedText": "DSCT = 双源计算机断层扫描"}, {"id": "page-1-inline-abbrev-6", "translatedText": "MPHR = 最大预测心率"}, {"id": "page-1-inline-abbrev-7", "translatedText": "MPI = 心肌灌注成像"}, {"id": "page-1-inline-abbrev-8", "translatedText": "MRI = 磁共振成像"}, {"id": "page-1-inline-abbrev-9", "translatedText": "SPECT = 单光子发射计算机断层扫描"}]}]}