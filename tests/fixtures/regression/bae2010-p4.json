{"pageWidth":597,"pageHeight":786,"items":[{"text":"STATE OF THE ART:","rect":[84,781.365,150.6178236,790.365],"fontSize":9},{"text":"Contrast Medium Administration and Scan Timing at CT","rect":[152.778,781.365,329.0365470000002,790.365],"fontSize":9},{"text":"Bae","rect":[569.804,781.365,581.9738,790.365],"fontSize":9},{"text":"Radiology:","rect":[83.9999999538,57.3889,113.12700016379999,64.3889],"fontSize":7.0000000000000036},{"text":"Volume 256: Number 1—July 2010","rect":[114.904,57.3889,204.00260819999986,64.3889],"fontSize":7},{"text":"n","rect":[207.5126,58.5239,209.73659999999998,62.5239],"fontSize":4},{"text":"radiology.rsna.org","rect":[213.2369999538,57.3889,257.6660001638,64.3889],"fontSize":7.0000000000000036},{"text":"35","rect":[573.76,57.1689,582,65.16890000000001],"fontSize":8},{"text":"more distal from the injection site (typ-","rect":[84,266.23900000000003,242.0043247200001,275.03900000000004],"fontSize":8.8},{"text":"ically","rect":[84,255.239,104.07720049999998,264.039],"fontSize":8.8},{"text":"antecubital","rect":[111.24040069999997,255.239,154.83560169999993,264.039],"fontSize":8.8},{"text":"vein)—progressively","rect":[161.99880189999993,255.239,242.0297516199999,264.039],"fontSize":8.8},{"text":"broadened contrast enhancement pro-","rect":[84,244.239,242.00108016000007,253.03900000000002],"fontSize":8.8},{"text":"file with a more flattened peak. In addi-","rect":[84,233.239,242.00130576000018,242.03900000000002],"fontSize":8.8},{"text":"tion, contrast material–enhanced blood","rect":[84.00077999999999,222.239,242.03104781999977,231.03900000000002],"fontSize":8.8},{"text":"recirculates and may contribute to the","rect":[84.00077999999999,211.239,242.03033361999982,220.03900000000002],"fontSize":8.8},{"text":"overall pattern of contrast enhancement","rect":[84.00077999999999,200.239,242.02837668799978,209.03900000000002],"fontSize":8.8},{"text":"achieved","rect":[84.00077999999999,189.239,119.71123280000003,198.03900000000002],"fontSize":8.8},{"text":"at","rect":[126.02435280000003,189.239,133.90035280000004,198.03900000000002],"fontSize":8.8},{"text":"CT","rect":[140.21347280000003,189.239,151.99652848000005,198.03900000000002],"fontSize":8.8},{"text":"imaging","rect":[158.30964848000005,189.239,190.54404848000001,198.03900000000002],"fontSize":8.8},{"text":"acquisition","rect":[196.85716848000004,189.239,242.00116847999996,198.03900000000002],"fontSize":8.8},{"text":"(2,17–19). For very long injections, the","rect":[84.00077999999999,178.239,242.02092781999983,187.03900000000002],"fontSize":8.8},{"text":"recirculation can even occur during the","rect":[84.00077999999999,167.239,242.0307033199998,176.03900000000002],"fontSize":8.8},{"text":"infusion of the contrast material. Recir-","rect":[84.00077999999999,156.239,242.00496392000016,165.03900000000002],"fontSize":8.8},{"text":"culated","rect":[84.00077999999999,145.239,112.53566059999996,154.03900000000002],"fontSize":8.8},{"text":"contrast-enhanced","rect":[117.81566079999993,145.239,191.06243951999983,154.03900000000002],"fontSize":8.8},{"text":"blood","rect":[196.34243971999982,145.239,218.4075601199998,154.03900000000002],"fontSize":8.8},{"text":"does","rect":[223.68756031999976,145.239,242.02940061999973,154.03900000000002],"fontSize":8.8},{"text":"not reach a target organ simultaneously","rect":[84.00077999999999,134.239,242.03124891999983,143.03900000000002],"fontSize":8.8},{"text":"because","rect":[84.00077999999999,123.239,115.62798000000002,132.03900000000002],"fontSize":8.8},{"text":"of","rect":[121.53630000000001,123.239,129.17470000000003,132.03900000000002],"fontSize":8.8},{"text":"multiple","rect":[135.08302,123.239,167.16782000000003,132.03900000000002],"fontSize":8.8},{"text":"circulatory","rect":[173.07614000000007,123.239,215.5008185600001,132.03900000000002],"fontSize":8.8},{"text":"path-","rect":[221.40913856000012,123.239,242.00113856000013,132.03900000000002],"fontSize":8.8},{"text":"ways in the body. For example, blood in","rect":[84.00077999999999,112.239,242.02049267999988,121.039],"fontSize":8.8},{"text":"the cerebral circulation returns to the","rect":[84.00077999999999,101.239,242.0304929999998,110.039],"fontSize":8.8},{"text":"right heart and recirculates faster than","rect":[84.00077999999999,90.239,242.03299581999977,99.039],"fontSize":8.8},{"text":"blood in the portal circulation. The","rect":[84.00077999999999,79.239,242.00462159999995,88.039],"fontSize":8.8},{"text":"transit","rect":[254.00078,266.23900000000003,279.75384771999995,275.03900000000004],"fontSize":8.8},{"text":"time","rect":[285.9939279199999,266.23900000000003,303.6845682199999,275.03900000000004],"fontSize":8.8},{"text":"for","rect":[309.9246484199999,266.23900000000003,321.4456086199999,275.03900000000004],"fontSize":8.8},{"text":"normal","rect":[327.6856888199999,266.23900000000003,355.9116893199999,275.03900000000004],"fontSize":8.8},{"text":"recirculation","rect":[362.1517695199999,266.23900000000003,412.03019799999987,275.03900000000004],"fontSize":8.8},{"text":"may range 15–40 seconds depending on","rect":[254.00078,255.239,412.0248571799997,264.039],"fontSize":8.8},{"text":"circulatory","rect":[254.00078,244.239,297.5695923200002,253.03900000000002],"fontSize":8.8},{"text":"paths","rect":[303.5377523200002,244.239,325.5641523200003,253.03900000000002],"fontSize":8.8},{"text":"(faster","rect":[331.5323123200003,244.239,358.4603123200004,253.03900000000002],"fontSize":8.8},{"text":"for","rect":[364.4284723200004,244.239,376.17647232000047,253.03900000000002],"fontSize":8.8},{"text":"shorter","rect":[382.1446323200005,244.239,412.0030323200006,253.03900000000002],"fontSize":8.8},{"text":"paths). The recirculated contrast me-","rect":[254.00078,233.239,412.00484159999934,242.03900000000002],"fontSize":8.8},{"text":"dium is further diluted by intravascular","rect":[254.00078,222.239,412.03016841519985,231.03900000000002],"fontSize":8.8},{"text":"and extracellular volume, and the bolus","rect":[254.00078,211.239,412.0301427599999,220.03900000000002],"fontSize":8.8},{"text":"dispersion is largely governed by blood","rect":[254.00078,200.239,412.02871543519996,209.03900000000002],"fontSize":8.8},{"text":"flow and tissue perfusion.","rect":[254.00078,189.239,356.2195798487999,198.03900000000002],"fontSize":8.8},{"text":"The fractional contribution of recir-","rect":[268.00039,178.239,412.0018792799999,187.03900000000002],"fontSize":8.8},{"text":"culation to the overall magnitude of en-","rect":[254.00038999999998,167.239,412.00423599999976,176.03900000000002],"fontSize":8.8},{"text":"hancement depends on the duration of","rect":[254.00038999999998,156.239,412.00445160000004,165.03900000000002],"fontSize":8.8},{"text":"injection and the time course of en-","rect":[254.00038999999998,145.239,412.00437767999983,154.03900000000002],"fontSize":8.8},{"text":"hancement. For a short injection (","rect":[254.00038999999998,134.239,394.7036410399999,143.03900000000002],"fontSize":8.8},{"text":",","rect":[394.76139,134.239,402.09179,143.03900000000002],"fontSize":8.8},{"text":"15","rect":[402.15319,134.239,412.00039,143.03900000000002],"fontSize":8.8},{"text":"seconds), the contribution of recircu-","rect":[254.00019,123.239,412.00242999999995,132.03900000000002],"fontSize":8.8},{"text":"lated contrast medium to peak aortic","rect":[254.00019,112.239,412.00407999999993,121.039],"fontSize":8.8},{"text":"enhancement is likely small. The aortic","rect":[254.00019,101.239,412.0041776800001,110.039],"fontSize":8.8},{"text":"peak time-enhancement curve is simi-","rect":[254.00019,90.239,412.002298,99.039],"fontSize":8.8},{"text":"lar to a Gaussian curve (a rapid initial","rect":[254.00019,79.239,411.9998164,88.039],"fontSize":8.8},{"text":"rise followed by a short peak and rapid","rect":[424.00019,266.23900000000003,582.0025329599998,275.03900000000004],"fontSize":8.8},{"text":"decline) (Fig 2). Conversely, when con-","rect":[424.00019,255.239,581.9998920799999,264.039],"fontSize":8.8},{"text":"trast medium is injected at a constant","rect":[424.00019,244.239,582.00082928,253.03900000000002],"fontSize":8.8},{"text":"rate for a long injection, the new con-","rect":[424.00019,233.239,582.0023595999999,242.03900000000002],"fontSize":8.8},{"text":"trast media and the recirculated con-","rect":[424.00019,222.239,582.0042278399999,231.03900000000002],"fontSize":8.8},{"text":"trast media already in the body mix","rect":[424.00019,211.239,582.00069552,220.03900000000002],"fontSize":8.8},{"text":"and","rect":[424.00019,200.239,438.79299,209.03900000000002],"fontSize":8.8},{"text":"accumulate,","rect":[444.18474999999995,200.239,492.3911156799999,209.03900000000002],"fontSize":8.8},{"text":"resulting","rect":[497.78287568,200.239,532.65733728,209.03900000000002],"fontSize":8.8},{"text":"in","rect":[538.04909728,200.239,545.60829728,209.03900000000002],"fontSize":8.8},{"text":"a","rect":[551.00005728,200.239,555.5672572799999,209.03900000000002],"fontSize":8.8},{"text":"more","rect":[560.9590172799999,200.239,581.9997811999999,209.03900000000002],"fontSize":8.8},{"text":"gradual increase in aortic enhancement","rect":[424.00019,189.239,582.0041178399999,198.03900000000002],"fontSize":8.8},{"text":"over","rect":[424.00019,178.239,441.30101816,187.03900000000002],"fontSize":8.8},{"text":"time.","rect":[446.77725816000003,178.239,467.39581832000005,187.03900000000002],"fontSize":8.8},{"text":"A","rect":[472.87205832000006,178.239,479.2256583200001,187.03900000000002],"fontSize":8.8},{"text":"typical","rect":[484.7018983200001,178.239,511.14589832000013,187.03900000000002],"fontSize":8.8},{"text":"aortic","rect":[516.6221383200001,178.239,540.0741383200001,187.03900000000002],"fontSize":8.8},{"text":"enhance-","rect":[545.55037832,178.239,581.9999783200001,187.03900000000002],"fontSize":8.8},{"text":"ment profile for long-injection duration","rect":[424.00019,167.239,582.0017770399999,176.03900000000002],"fontSize":8.8},{"text":"then","rect":[424.00019,156.239,441.95219,165.03900000000002],"fontSize":8.8},{"text":"consists","rect":[447.68539,156.239,479.55899,165.03900000000002],"fontSize":8.8},{"text":"of","rect":[485.29218999999995,156.239,493.01858999999996,165.03900000000002],"fontSize":8.8},{"text":"a","rect":[498.75178999999997,156.239,503.31899,165.03900000000002],"fontSize":8.8},{"text":"rapid","rect":[509.05219,156.239,530.1545046399999,165.03900000000002],"fontSize":8.8},{"text":"initial","rect":[535.8877046399999,156.239,558.5917046399999,165.03900000000002],"fontSize":8.8},{"text":"rise,","rect":[564.32490464,156.239,582.00402104,165.03900000000002],"fontSize":8.8},{"text":"gradual increase, peak, and gradual de-","rect":[424.00019,145.239,582.0042419199999,154.03900000000002],"fontSize":8.8},{"text":"cline. The contribution of recirculation","rect":[424.00019,134.239,582.0027124799999,143.03900000000002],"fontSize":8.8},{"text":"to peak arterial enhancement is likely","rect":[424.00019,123.239,581.9998515999998,132.03900000000002],"fontSize":8.8},{"text":"10%–20% for a typical clinical injection","rect":[424.00019,112.239,582.0041204800003,121.039],"fontSize":8.8},{"text":"(","rect":[424.00019,101.239,427.58178999999996,110.039],"fontSize":8.8},{"text":".","rect":[427.49393999999995,101.239,434.82433999999995,110.039],"fontSize":8.8},{"text":"15 seconds). In a theoretical physio-","rect":[434.73612999999995,101.239,582.00441248,110.039],"fontSize":8.8},{"text":"logic model with no recirculation con-","rect":[424.00022999999993,90.239,582.0043523199997,99.039],"fontSize":8.8},{"text":"tribution, aortic contrast enhancement","rect":[424.00022999999993,79.239,582.0032162399998,88.039],"fontSize":8.8},{"text":"Figure 3:","rect":[141,381.909,169.721559415,390.409],"fontSize":8.5},{"text":"Time-enhancement curve diagrams illustrate the effect of the injection duration and recirculation on peak contrast","rect":[177.9062425,381.909,519.8733320500022,390.409],"fontSize":8.5},{"text":"enhancement. Top: In a theoretical physiologic model without recirculation or hemodynamic perturbation, aortic contrast en-","rect":[141,371.409,511.9604918000014,379.909],"fontSize":8.5},{"text":"hancement","rect":[141,360.909,174.524,369.409],"fontSize":8.5},{"text":"(CE)","rect":[176.5629999439,360.909,188.5225001989,369.409],"fontSize":8.500000000000004},{"text":"would show a rapid rise and then a uniform steady-state plateau (a flat broad peak). The time to the end of the","rect":[190.56199999999998,360.909,521.9700937500021,369.409],"fontSize":8.5},{"text":"plateau enhancement corresponds to the sum of the injection duration plus contrast material arrival time","rect":[141.00009999999997,350.409,454.42825000000136,358.909],"fontSize":8.5},{"text":"(Tarr)","rect":[456.4869999439,350.409,472.38200019889996,358.909],"fontSize":8.500000000000004},{"text":"(solid horizontal","rect":[474.4220085,350.409,521.1210085,358.909],"fontSize":8.5},{"text":"arrows). Bottom: In reality, however, a fast, large bolus of contrast medium affects and perturbs the hemodynamics of the","rect":[141,339.909,503.46550680000007,348.409],"fontSize":8.5},{"text":"cardiovascular system, particularly the slow peripheral venous blood flow. This will result in hastening contrast material arrival","rect":[141,329.409,516.904,337.909],"fontSize":8.5},{"text":"as the contrast material bolus increases. Because of recirculation (hatched vertical arrows) and hemodynamic perturbation","rect":[141,318.9086,508.0852432000015,327.4086],"fontSize":8.5},{"text":"(open horizontal arrows) effect, the steady-state plateau contrast enhancement cannot be sustained and becomes elevated and","rect":[141,308.4086,522.7655932000016,316.9086],"fontSize":8.5},{"text":"compressed, resulting in a higher and narrower peak contrast enhancement. The time to peak aortic enhancement becomes","rect":[141,297.9086,513.84421335,306.4086],"fontSize":8.5},{"text":"shorter than the sum of the injection duration plus contrast material arrival time.","rect":[141,287.4086,381.09100000000103,295.9086],"fontSize":8.5},{"text":"Figure 3","rect":[147,686.8779999999999,177.5818092,695.8779999999999],"fontSize":9}],"segments":[[46.38980000000001,72.45309999999999,73.38980000000001,72.45309999999999],[73.38980000000001,72.45309999999999,73.38980000000001,789.4171000000001],[73.38980000000001,789.4171000000001,46.38980000000001,789.4171000000001],[46.38980000000001,789.4171000000001,46.38980000000001,72.45309999999999],[46.38980000000001,72.45309999999999,73.38980000000001,72.45309999999999],[73.38980000000001,72.45309999999999,73.38980000000001,789.4171000000001],[73.38980000000001,789.4171000000001,46.38980000000001,789.4171000000001],[46.38980000000001,789.4171000000001,46.38980000000001,72.45309999999999],[46.38980000000001,72.45309999999999,73.38980000000001,72.45309999999999],[73.38980000000001,72.45309999999999,73.38980000000001,789.4171000000001],[73.38980000000001,789.4171000000001,46.38980000000001,789.4171000000001],[46.38980000000001,789.4171000000001,46.38980000000001,72.45309999999999],[64.3453,694.741,64.3453,696.5260000000001],[64.3453,696.5260000000001,51.07730000000001,696.5260000000001],[51.07730000000001,696.5260000000001,51.07730000000001,694.741],[51.07730000000001,694.741,50.5914,694.741],[57.8145,701.7810000000001,57.8535,701.7810000000001],[64.3453,707.745,64.83160000000001,707.745],[58.0977,700.34,58.0977,698.5550000000001],[58.0977,698.5550000000001,64.3453,698.5550000000001],[64.3453,698.5550000000001,64.3453,700.34],[64.3453,700.34,64.83160000000001,700.34],[64.83160000000001,694.741,64.3453,694.741],[57.61130000000001,698.5550000000001,57.61130000000001,700.34],[51.07730000000001,700.34,51.07730000000001,698.5550000000001],[51.07730000000001,698.5550000000001,57.61130000000001,698.5550000000001],[62.6016,713.464,62.6016,713.424],[59.4156,713.464,58.462500000000006,713.464],[58.8477,715.2080000000001,64.3863,715.2080000000001],[64.3863,715.2080000000001,64.3863,716.547],[64.3863,716.547,64.83160000000001,716.547],[64.83160000000001,713.464,62.6016,713.464],[61.01760000000001,713.464,59.863699999999994,713.464],[64.3859,739.5520000000001,64.3859,740.9720000000001],[64.3859,740.9720000000001,51.03790000000001,740.9720000000001],[51.03790000000001,740.9720000000001,51.03790000000001,739.5520000000001],[51.03790000000001,739.5520000000001,50.59100000000001,739.5520000000001],[50.59100000000001,742.716,64.3859,742.716],[64.3859,742.716,64.3859,744.136],[64.3859,744.136,64.8309,744.136],[64.8309,739.5520000000001,64.3859,739.5520000000001],[66.677,765.902,64.7711,766.6320000000001],[64.7711,766.6320000000001,56.3121,762.899],[56.3121,762.899,56.3121,761.966],[56.3121,761.966,55.8648,761.966],[55.8648,766.267,56.3121,766.267],[56.3121,766.267,56.3121,764.8470000000001],[56.3121,764.8470000000001,62.60080000000001,767.5450000000001],[62.60080000000001,767.5450000000001,58.4211,769.2280000000001],[56.3121,769.898,56.3121,768.823],[56.3121,768.823,55.8648,768.823],[55.8648,771.642,56.3121,771.642],[56.3121,771.642,56.3121,770.77],[58.564099999999996,769.654,66.8609,766.267],[62.659400000000005,723.283,62.659400000000005,723.2420000000001],[58.0156,723.2420000000001,58.0156,723.283],[58.0156,723.283,51.036300000000004,723.283],[51.036300000000004,723.283,51.036300000000004,721.863],[51.036300000000004,721.863,50.5914,721.863],[50.5914,725.027,64.38440000000001,725.027],[64.38440000000001,725.027,64.38440000000001,726.4470000000001],[64.38440000000001,726.4470000000001,64.83160000000001,726.215],[64.83160000000001,723.283,62.659400000000005,723.283],[64.38440000000001,725.982,64.38440000000001,727.4010000000001],[64.38440000000001,727.4010000000001,56.310500000000005,727.4010000000001],[56.310500000000005,727.4010000000001,56.310500000000005,725.982],[56.310500000000005,725.982,55.8656,725.982],[55.8656,729.1460000000001,64.38440000000001,729.1460000000001],[64.38440000000001,729.1460000000001,64.38440000000001,730.566],[64.38440000000001,730.566,64.83160000000001,730.566],[64.831