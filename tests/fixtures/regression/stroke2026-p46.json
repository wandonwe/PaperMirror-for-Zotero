e":7},{"text":"B-R","rect":[95.92660000000001,622.2090000000001,108.31660000000001,629.2090000000001],"fontSize":7},{"text":"4.","rect":[123.75,635.71,129.434,642.71],"fontSize":7},{"text":"In eligible patients with AIS within 4.5 hours from","rect":[131.331,635.71,276.58799999999997,642.71],"fontSize":7},{"text":"last known normal, IV mutant prourokinase in","rect":[131.3308,626.71,263.76939999999996,633.71],"fontSize":7},{"text":"conjunction with low-dose alteplase is not recom","rect":[131.3308,617.7080000000001,276.0208,624.7080000000001],"fontSize":7},{"text":"-","rect":[276.0207999999999,617.7080000000001,278.0647999999999,624.7080000000001],"fontSize":7},{"text":"mended to improve functional outcomes.","rect":[131.3308,608.7060000000001,252.10180000000003,615.7060000000001],"fontSize":7},{"text":"9,10","rect":[252.1004,611.68318,260.172618,615.76418],"fontSize":4.081},{"text":"3: No","rect":[58.4486,590.96,75.80160000000001,597.96],"fontSize":7},{"text":"Benefit","rect":[54.8786,581.9580000000001,79.3716,588.9580000000001],"fontSize":7},{"text":"B-R","rect":[95.92660000000001,586.4590000000001,108.31660000000001,593.4590000000001],"fontSize":7},{"text":"5.","rect":[123.75,595.46,129.434,602.46],"fontSize":7},{"text":"In eligible patients with AIS within 6 hours from","rect":[131.331,595.46,270.90399999999994,602.46],"fontSize":7},{"text":"last known normal, IV urokinase is not beneficial","rect":[131.3308,586.46,272.8008,593.46],"fontSize":7},{"text":"for decreasing the odds of death or dependency.","rect":[131.3308,577.4580000000001,276.30639999999994,584.4580000000001],"fontSize":7},{"text":"8","rect":[276.3062,580.43318,278.685423,584.51418],"fontSize":4.081},{"text":"3: Harm","rect":[54.0736,546.21,80.17660000000001,553.21],"fontSize":7},{"text":"A","rect":[99.64359999999999,546.21,104.5996,553.21],"fontSize":7},{"text":"6.","rect":[123.75,564.21,129.329,571.21],"fontSize":7},{"text":"In eligible patients with AIS within 6 hours from","rect":[131.016,564.21,265.5490000000003,571.21],"fontSize":7},{"text":"last known normal, IV streptokinase should not be","rect":[131.0158,555.21,273.13680000000033,562.21],"fontSize":7},{"text":"administered because it does not result in improved","rect":[131.0158,546.2080000000001,279.1918000000003,553.2080000000001],"fontSize":7},{"text":"rate of functional independence at 90 days and is","rect":[131.0158,537.2060000000001,272.9828000000003,544.2060000000001],"fontSize":7},{"text":"associated with increased early mortality.","rect":[131.0158,528.2040000000002,248.05580000000037,535.2040000000002],"fontSize":7},{"text":"8","rect":[247.9492,531.18318,250.328423,535.26418],"fontSize":4.081},{"text":"Sonothrombolysis","rect":[53.75,514.96,107.132,521.96],"fontSize":7},{"text":"3: No","rect":[58.447,488.21299999999997,75.80000000000001,495.21299999999997],"fontSize":7},{"text":"Benefit","rect":[54.877,479.21099999999996,79.37,486.21099999999996],"fontSize":7},{"text":"A","rect":[99.642,483.71199999999993,104.598,490.71199999999993],"fontSize":7},{"text":"7.","rect":[123.75,501.71,128.419,508.71],"fontSize":7},{"text":"In patients with AIS, sonothrombolysis as an","rect":[130.316,501.71,261.4329999999999,508.71],"fontSize":7},{"text":"adjunctive therapy to IVT compared with IVT","rect":[130.3159,492.71,261.1388999999999,499.71],"fontSize":7},{"text":"alone is not recommended as it did not increase","rect":[130.3159,483.70799999999997,272.9618999999999,490.70799999999997],"fontSize":7},{"text":"the odds of early neurological improvement nor","rect":[130.3159,474.70599999999996,269.6089,481.70599999999996],"fontSize":7},{"text":"improve functional outcome at 90 days.","rect":[130.3159,465.70399999999995,247.28449999999995,472.70399999999995],"fontSize":7},{"text":"11,12","rect":[247.2845,468.68318,257.735941,472.76418],"fontSize":4.081},{"text":"Synopsis","rect":[49.5,436.925,89.9,446.925],"fontSize":10},{"text":"In addition to alteplase and tenecteplase for acute treat","rect":[49.5,424.925,279.9300000000001,434.925],"fontSize":10},{"text":"-","rect":[279.96,424.925,283.5,434.925],"fontSize":10},{"text":"ment of patients with AIS, previous trials have studied","rect":[49.5,412.925,283.50000000000006,422.925],"fontSize":10},{"text":"desmoteplase,","rect":[49.5,400.925,109.3,410.925],"fontSize":10},{"text":"urokinase,","rect":[116.27999999999997,400.925,158.57999999999998,410.925],"fontSize":10},{"text":"prourokinase,","rect":[165.55999999999997,400.925,221.40999999999997,410.925],"fontSize":10},{"text":"and","rect":[228.39000000000001,400.925,243.81,410.925],"fontSize":10},{"text":"strepto","rect":[250.79000000000002,400.925,279.97,410.925],"fontSize":10},{"text":"-","rect":[279.96,400.925,283.5,410.925],"fontSize":10},{"text":"kinase. The trials did not demonstrate any benefit over","rect":[49.5,388.925,283.5000000000002,398.925],"fontSize":10},{"text":"placebo in improving functional outcomes. However, IV","rect":[49.5,376.925,283.49,386.925],"fontSize":10},{"text":"reteplase was compared with alteplase in a study per","rect":[49.5,364.925,279.9300000000001,374.925],"fontSize":10},{"text":"-","rect":[279.96,364.925,283.5,374.925],"fontSize":10},{"text":"formed in China and showed superiority of reteplase over","rect":[49.5,352.925,283.5040000000001,362.925],"fontSize":10},{"text":"alteplase in achieving excellent functional outcome.","rect":[49.5,340.925,262.4590000000001,350.925],"fontSize":10},{"text":"Sonothrombolysis is a noninvasive ultrasound-based","rect":[61.5,328.925,283.49900000000014,338.925],"fontSize":10},{"text":"therapy that uses pulse waves to lyse intracranial thrombi.","rect":[49.5,316.925,283.53000000000003,326.925],"fontSize":10},{"text":"An individual patient data meta-analysis showed that this","rect":[49.5,304.925,283.50100000000003,314.925],"fontSize":10},{"text":"adjunctive treatment was associated with increased odds","rect":[49.5,292.925,283.51000000000005,302.925],"fontSize":10},{"text":"of full recanalization in patients with intracranial LVOs but","rect":[49.5,280.925,283.53000000000003,290.925],"fontSize":10},{"text":"with no effect on clinical outcomes.","rect":[49.5,268.925,193.49,278.925],"fontSize":10},{"text":"13","rect":[193.4914,273.1724,200.28918,279.00239999999997],"fontSize":5.83},{"text":"Similarly, 2 random","rect":[202.5391,268.925,279.95809999999994,278.925],"fontSize":10},{"text":"-","rect":[279.95809999999994,268.925,283.49809999999997,278.925],"fontSize":10},{"text":"ized trials of sonothrombolysis did not show any clinical","rect":[49.49909999999997,256.925,283.52909999999997,266.925],"fontSize":10},{"text":"outcome benefit from sonothrombolysis as an adjunctive","rect":[49.49909999999997,244.925,283.4991,254.925],"fontSize":10},{"text":"treatment to IVT.","rect":[49.49909999999997,232.925,117.87809999999995,242.925],"fontSize":10},{"text":"Recommendation-Specific Supportive Text","rect":[49.49909999999997,208.925,239.92710000000002,218.925],"fontSize":10},{"text":"1.","rect":[59.6,196.925,67.1,206.925],"fontSize":10},{"text":"Reteplase","rect":[74,196.925,115.88000000000001,206.925],"fontSize":10},{"text":"was","rect":[122.90999999999997,196.925,139.36999999999998,206.925],"fontSize":10},{"text":"compared","rect":[146.39999999999998,196.925,187.86999999999998,206.925],"fontSize":10},{"text":"with","rect":[194.9,196.925,211.99,206.925],"fontSize":10},{"text":"alteplase","rect":[219.02,196.925,256.31,206.925],"fontSize":10},{"text":"in","rect":[263.34000000000003,196.925,270.63000000000005,206.925],"fontSize":10},{"text":"2","rect":[277.65999999999997,196.925,283.48999999999995,206.925],"fontSize":10},{"text":"RCTs.","rect":[74,184.925,97.77999999999999,194.925],"fontSize":10},{"text":"1,2","rect":[97.7798,189.1724,105.55118999999999,195.00240000000002],"fontSize":5.83},{"text":"Both were performed in China and enrolled","rect":[107.571,184.925,283.50100000000015,194.925],"fontSize":10},{"text":"patients 18 to 80 years of age not selected for","rect":[74.001,172.925,283.50100000000015,182.925],"fontSize":10},{"text":"EVT. The first one was a Phase 2 trial of 180","rect":[74.001,160.925,283.501,170.925],"fontSize":10},{"text":"patients using 2 doses of reteplase 12 mg + 12","rect":[74.001,148.925,283.471,158.925],"fontSize":10},{"text":"mg and 18 mg + 18 mg (given 30 minutes apart)","rect":[74.001,136.925,283.5010000000001,146.925],"fontSize":10},{"text":"and showed that both doses of reteplase had simi","rect":[74.001,124.925,279.97000000000014,134.925],"fontSize":10},{"text":"-","rect":[279.961,124.925,283.50100000000003,134.925],"fontSize":10},{"text":"lar efficacy and safety profiles as alteplase.","rect":[74.001,112.925,260.43100000000004,122.925],"fontSize":10},{"text":"2","rect":[260.4393,117.1724,263.83819,123.0024],"fontSize":5.83},{"text":"The","rect":[267.8581,112.925,283.49809999999997,122.925],"fontSize":10},{"text":"second was an RCT comparing reteplase 18 mg","rect":[73.99809999999997,100.925,283.4881,110.925],"fontSize":10},{"text":"+ 18 mg versus standard dose alteplase.","rect":[73.99809999999997,88.925,242.76810000000006,98.925],"fontSize":10},{"text":"1","rect":[242.7933,93.1724,246.19218999999998,99.0024],"fontSize":5.83},{"text":"This trial","rect":[248.6921,88.925,283.49210000000005,98.925],"fontSize":10},{"text":"showed that reteplase was superior to alteplase","rect":[74.00210000000001,76.925,283.4821000000001,86.925],"fontSize":10},{"text":"in achieving excellent functional outcome at 90","rect":[74.00210000000001,64.925,283.52110000000016,74.925],"fontSize":10},{"text":"days defined as mRS 0–1 (risk ratio, 1.13 [95%","rect":[74.00210000000001,52.925,283.48209999999995,62.925],"fontSize":10},{"text":"CI, 1.05–1.21];","rect":[326.00210000000004,713.355,389.8921,723.355],"fontSize":10},{"text":"P","rect":[394.0021,713.355,400.3021,723.355],"fontSize":10},{"text":"=0.002) with no significant dif","rect":[400.3021,713.355,531.9621000000001,723.355],"fontSize":10},{"text":"-","rect":[531.9621,713.355,535.5020999999999,723.355],"fontSize":10},{"text":"ference in sICH between the 2. The 2 trials have","rect":[326.00210000000004,701.355,535.5220999999999,711.355],"fontSize":10},{"text":"several limitations, including exclusion of patients","rect":[326.00210000000004,689.355,535.5031000000002,699.355],"fontSize":10},{"text":"over 80 years and those who underwent throm","rect":[326.00210000000004,677.355,531.9821000000001,687.355],"fontSize":10},{"text":"-","rect":[531.9621000000001,677.355,535.5021,687.355],"fontSize":10},{"text":"bectomy, underrepresentation of women (29% of","rect":[326.00210000000004,665.355,535.5121,675.355],"fontSize":10},{"text":"trial population), and not including patients outside","rect":[326.00210000000004,653.355,535.5121000000001,663.355],"fontSize":10},{"text":"China. Therefore, the generalizability of these find","rect":[326.00210000000004,641.355,531.9721000000003,651.355],"fontSize":10},{"text":"-","rect":[531.9621000000001,641.355,535.5021,651.355],"fontSize":10},{"text":"ings remains uncertain.","rect":[326.00210000000004,629.355,422.0621,639.355],"fontSize":10},{"text":"2.","rect":[311.6,617.3598999999999,319.1,627.3598999999999],"fontSize":10},{"text":"Two","rect":[326,617.3598999999999,342.48,627.3598999999999],"fontSize":10},{"text":"RCTs","rect":[349.29,617.3598999999999,371.40000000000003,627.3598999999999],"fontSize":10},{"text":"conducted","rect":[378.21000000000004,617.3598999999999,421.97,627.3598999999999],"fontSize":10},{"text":"in","rect":[428.78,617.3598999999999,436.07,627.3598999999999],"fontSize":10},{"text":"China","rect":[442.87999999999994,617.3598999999999,467.04999999999995,627.3598999999999],"fontSize":10},{"text":"compared","rect":[473.8599999999999,617.3598999999999,515.3299999999999,627.3598999999999],"fontSize":10},{"text":"the","rect":[522.1399999999998,617.3598999999999,535.4799999999998,627.3598999999999],"fontSize":10},{"text":"safety and efficacy of IV mutant prourokinase to","rect":[326,605.3598999999999,535.5099999999999,615.3598999999999],"fontSize":10},{"text":"IV alteplase in patients with AIS within 4.5 hours","rect":[326,593.3598999999999,535.5,603.3598999999999],"fontSize":10},{"text":"from last known normal. The Prourokinase in the","rect":[326,581.3598999999999,535.5200000000002,591.3598999999999],"fontSize":10},{"text":"Treatment of AIS Within 4.5 hours of Stroke Onset","rect":[326,569.3598999999999,535.52,579.3598999999999],"fontSize":10},{"text":"(PROST) trial was a phase III RCT from China of","rect":[326,557.3598999999999,535.52,567.3598999999999],"fontSize":10},{"text":"663 patients allocated to prourokinase (35 mg","rect":[326,545.3598999999999,535.5200000000001,555.3598999999999],"fontSize":10},{"text":"intravenous dose) versus alteplase (standard dose)","rect":[326,533.3598999999999,535.52,543.3598999999999],"fontSize":10},{"text":"in a 1:1 fashion that showed no significant differ","rect":[326,521.3598999999999,531.9699999999999,531.3598999999999],"fontSize":10},{"text":"-","rect":[531.96,521.3598999999999,535.5,531.3598999999999],"fontSize":10},{"text":"ence in the primary outcome (mRS score 0–1 at","rect":[326,509.3599,535.4999999999999,519.3598999999999],"fontSize":10},{"text":"90 days) (65.2% versus 64.3%) or sICH (1.5%","rect":[326,497.3599,535.4899999999999,507.3599],"fontSize":10},{"text":"versus 1.8%) across the 2 groups (prourokinase","rect":[326,485.3599,535.5199999999999,495.3599],"fontSize":10},{"text":"versus alteplase) but a lower risk of systemic","rect":[326,473.3599,535.52,483.3599],"fontSize":10},{"text":"bleeding within 90 days with prourokinase (25.8%","rect":[326,461.3599,535.49,471.3599],"fontSize":10},{"text":"versus 42.2%;","rect":[326,449.3599,386.19,459.3599],"fontSize":10},{"text":"P","rect":[389.52,449.3599,395.82,459.3599],"fontSize":10},{"text":"<","rect":[395.8172,450.19,401.48670000000004,458.69],"fontSize":8.5},{"text":"0.001).","rect":[401.4866,449.36,431.27660000000003,459.36],"fontSize":10},{"text":"3","rect":[431.276,453.6074,434.67489,459.43739999999997],"fontSize":5.83},{"text":"The PROST-2 trial was","rect":[437.9949,449.36,535.4849,459.36],"fontSize":10},{"text":"an open label noninferiority trial of 1552 patients","rect":[326.00489999999996,437.36,535.5289,447.36],"fontSize":10},{"text":"allocated to prourokinase versus alteplase in a 1:1","rect":[326.00489999999996,425.36,535.5068999999999,435.36],"fontSize":10},{"text":"fashion. Noninferiority was found in the primary","rect":[326.00489999999996,413.36,535.5149000000001,423.36],"fontSize":10},{"text":"outcome (mRS score at 90 days, 0–1) (72.0% ver","rect":[326.00489999999996,401.36,531.9438999999999,411.36],"fontSize":10},{"text":"-","rect":[531.9649,401.36,535.5048999999999,411.36],"fontSize":10},{"text":"sus 68.7%;","rect":[326.0048999999999,389.36,374.7948999999999,399.36],"fontSize":10},{"text":"P","rect":[379.01489999999984,389.36,385.31489999999985,399.36],"fontSize":10},{"text":"<","rect":[385.3151,390.19,390.9846,398.69],"fontSize":8.5},{"text":"0.0001) but a lower risk of sICH","rect":[390.9846,389.36,535.4836,399.36],"fontSize":10},{"text":"(0.3% versus 1.0%;","rect":[326.0046,377.36,411.30459999999994,387.36],"fontSize":10},{"text":"P","rect":[415.8345999999998,377.36,422.1345999999998,387.36],"fontSize":10},{"text":"=0.021) and major bleed","rect":[422.1345999999998,377.36,531.9695999999998,387.36],"fontSize":10},{"text":"-","rect":[531.9695999999998,377.36,535.5095999999998,387.36],"fontSize":10},{"text":"ing at 7 days (0.5% versus 2.1%;","rect":[326.0046,365.36,466.3545999999999,375.36],"fontSize":10},{"text":"P","rect":[469.4446,365.36,475.7446,375.36],"fontSize":10},{"text":"=0.0072) with","rect":[475.7446,365.36,535.5046,375.36],"fontSize":10},{"text":"prourokinase.","rect":[326.0046,353.36,381.8546,363.36],"fontSize":10},{"text":"4","rect":[381.8493,357.6074,385.24819,363.43739999999997],"fontSize":5.83},{"text":"3.","rect":[311.6,341.36,319.1,351.36],"fontSize":10},{"text":"Randomized","rect"