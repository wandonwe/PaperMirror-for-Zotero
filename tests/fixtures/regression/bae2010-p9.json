{"pageWidth":594,"pageHeight":783,"items":[{"text":"STATE OF THE ART:","rect":[84,781.365,150.6178236,790.365],"fontSize":9},{"text":"Contrast Medium Administration and Scan Timing at CT","rect":[152.778,781.365,329.0365470000002,790.365],"fontSize":9},{"text":"Bae","rect":[569.804,781.365,581.9738,790.365],"fontSize":9},{"text":"40","rect":[84,57.168999999999976,92.24000000000001,65.16899999999998],"fontSize":8},{"text":"radiology.rsna.org","rect":[408.3349999538,57.3889,452.76400016379995,64.3889],"fontSize":7.0000000000000036},{"text":"n","rect":[456.263,58.5239,458.48699999999997,62.5239],"fontSize":4},{"text":"Radiology:","rect":[461.9869999538,57.3889,491.11400016380003,64.3889],"fontSize":7.0000000000000036},{"text":"Volume 256: Number 1—July 2010","rect":[492.891,57.3889,581.9895956000009,64.3889],"fontSize":7},{"text":"of peak hepatic enhancement increases","rect":[84,387.22900000000004,242.00232536,396.02900000000005],"fontSize":8.8},{"text":"only slightly. The kidney also enhances","rect":[84,376.22900000000004,242.00404224000002,385.02900000000005],"fontSize":8.8},{"text":"intensely with reduced cardiac output,","rect":[84,365.22900000000004,242.00034623999994,374.02900000000005],"fontSize":8.8},{"text":"because it has a high capillary density","rect":[84,354.22900000000004,242.00223999999997,363.02900000000005],"fontSize":8.8},{"text":"per organ volume and because excreted","rect":[84,343.22900000000004,242.00389264000006,352.02900000000005],"fontSize":8.8},{"text":"contrast medium is cleared slowly with","rect":[84,332.22900000000004,242.00440568000002,341.02900000000005],"fontSize":8.8},{"text":"reduced cardiac output.","rect":[84,321.22900000000004,179.65585391999997,330.02900000000005],"fontSize":8.8},{"text":"In addition to the individual patient’s","rect":[98,310.22900000000004,242.0032,319.02900000000005],"fontSize":8.8},{"text":"variation in cardiac function, coexisting","rect":[84,299.22900000000004,242.00037224,308.02900000000005],"fontSize":8.8},{"text":"vascular disorders such as the presence","rect":[84,288.22900000000004,242.00373336000004,297.02900000000005],"fontSize":8.8},{"text":"of vascular stenosis or aneurysm may","rect":[84,277.22900000000004,242.00390496000009,286.02900000000005],"fontSize":8.8},{"text":"substantially affect the timing of con-","rect":[84,266.22900000000004,242.004,275.02900000000005],"fontSize":8.8},{"text":"trast enhancement, particularly at pe-","rect":[84,255.229,242.00214232,264.029],"fontSize":8.8},{"text":"ripheral (66,67) and cerebral CT angi-","rect":[84,244.229,242.00361032000012,253.02900000000002],"fontSize":8.8},{"text":"ography and CT perfusion (68,69). A","rect":[84.00010000000002,233.229,241.99918000000002,242.02900000000002],"fontSize":8.8},{"text":"wide range of contrast material bolus","rect":[83.99970000000002,222.229,242.00340784000002,231.02900000000002],"fontSize":8.8},{"text":"transit times from the injection site","rect":[83.99970000000002,211.229,242.0036278399998,220.02900000000002],"fontSize":8.8},{"text":"to the aorta (14–32 seconds; median,","rect":[83.99970000000002,200.229,241.99930000000006,209.02900000000002],"fontSize":8.8},{"text":"18 seconds) and from the aorta to the","rect":[83.99970000000002,189.229,242.00453159999998,198.02900000000002],"fontSize":8.8},{"text":"pedal arteries (6–39 seconds; median,","rect":[83.99970000000002,178.229,242.00018000000003,187.02900000000002],"fontSize":8.8},{"text":"15 seconds) have been reported (67).","rect":[83.99970000000002,167.229,242.00064319999998,176.02900000000002],"fontSize":8.8},{"text":"The large variations in downstream con-","rect":[84.00070000000002,156.229,242.0047528000003,165.02900000000002],"fontSize":8.8},{"text":"trast material bolus flow make it challeng-","rect":[84.00070000000002,145.229,242.00105324000032,154.02900000000002],"fontSize":8.8},{"text":"ing to determine a precise scan delay","rect":[84.00070000000002,134.229,242.00145176,143.02900000000002],"fontSize":8.8},{"text":"based on the contrast medium arrival in","rect":[84.00070000000002,123.22900000000001,242.00484784000008,132.02900000000002],"fontSize":8.8},{"text":"the upstream aorta. With a fast acqui-","rect":[84.00070000000002,112.22900000000001,242.0009969600001,121.02900000000001],"fontSize":8.8},{"text":"sition speed, the contrast material bolus","rect":[84.00070000000002,101.22900000000001,242.00472464000018,110.02900000000001],"fontSize":8.8},{"text":"may be outpaced by CT scanning and","rect":[84.00070000000002,90.22900000000001,241.99971304000007,99.02900000000001],"fontSize":8.8},{"text":"table movement, resulting in an inade-","rect":[84.00070000000002,79.22900000000001,241.99999404,88.02900000000001],"fontSize":8.8},{"text":"quate enhancement of distal arteries.","rect":[254.00070000000002,387.22900000000004,412.0010215999996,396.02900000000005],"fontSize":8.8},{"text":"Strategies to prevent the occurrence","rect":[254.00070000000002,376.22900000000004,412.00295583999974,385.02900000000005],"fontSize":8.8},{"text":"of such situations at peripheral runoff","rect":[254.00070000000002,365.22900000000004,412.0048099999997,374.02900000000005],"fontSize":8.8},{"text":"CT angiography are discussed in Ap-","rect":[254.00070000000002,354.22900000000004,412.00090000000006,363.02900000000005],"fontSize":8.8},{"text":"pendix E1 (online).","rect":[254.00070000000002,343.22900000000004,331.4142648000001,352.02900000000005],"fontSize":8.8},{"text":"Key points.—","rect":[269.00070000000005,332.22900000000004,322.1208633599999,341.02900000000005],"fontSize":8.8},{"text":"1. The most important","rect":[322.03310000000005,332.22900000000004,412.0027335999996,341.02900000000005],"fontSize":8.8},{"text":"patient-related factor affecting the timing","rect":[254.00110000000006,321.22900000000004,412.00513696000064,330.02900000000005],"fontSize":8.8},{"text":"of contrast enhancement is cardiac out-","rect":[254.00110000000006,310.22900000000004,412.00500319999946,319.02900000000005],"fontSize":8.8},{"text":"put and cardiovascular circulation.","rect":[254.00110000000006,299.22900000000004,389.35390439999946,308.02900000000005],"fontSize":8.8},{"text":"2. When cardiac output decreases,","rect":[269.0001000000001,288.22900000000004,412.00353464000017,297.02900000000005],"fontSize":8.8},{"text":"contrast material bolus arrives slowly","rect":[254.0001000000001,277.22900000000004,412.00264888000004,286.02900000000005],"fontSize":8.8},{"text":"and clears slowly, resulting in delayed","rect":[254.0001000000001,266.22900000000004,412.00363360000017,275.02900000000005],"fontSize":8.8},{"text":"contrast material bolus arrival and de-","rect":[254.0001000000001,255.229,412.00410264000016,264.029],"fontSize":8.8},{"text":"layed but stronger peak arterial and pa-","rect":[254.0001000000001,244.229,412.0037004800003,253.02900000000002],"fontSize":8.8},{"text":"renchymal enhancement.","rect":[254.0001000000001,233.229,354.5401017600001,242.02900000000002],"fontSize":8.8},{"text":"3. When scan timing is critical, CT","rect":[269.0001000000001,222.229,412.00172800000024,231.02900000000002],"fontSize":8.8},{"text":"scan delay should be individualized by","rect":[254.0001000000001,211.229,412.00400584000016,220.02900000000002],"fontSize":8.8},{"text":"using a test-bolus or a bolus-tracking","rect":[254.0001000000001,200.229,412.0041616000002,209.02900000000002],"fontSize":8.8},{"text":"technique to account for circulatory","rect":[254.0001000000001,189.229,412.000714640001,198.02900000000002],"fontSize":8.8},{"text":"variations among patients.","rect":[254.0001000000001,178.229,359.9344040800001,187.02900000000002],"fontSize":8.8},{"text":"Sex and Age","rect":[254.000018,158.185,300.1790179999999,167.185],"fontSize":9},{"text":"There","rect":[254,145.22899999999998,278.5078169600001,154.029],"fontSize":8.8},{"text":"are","rect":[285.55925696000014,145.22899999999998,298.8738400000002,154.029],"fontSize":8.8},{"text":"numerous","rect":[305.9252800000002,145.22899999999998,347.0652192800004,154.029],"fontSize":8.8},{"text":"miscellaneous","rect":[354.1166592800005,145.22899999999998,412.0030592800008,154.029],"fontSize":8.8},{"text":"patient-related factors or sources of","rect":[254,134.22899999999998,412.0019839199996,143.029],"fontSize":8.8},{"text":"biologic","rect":[254,123.22899999999998,286.48960000000005,132.029],"fontSize":8.8},{"text":"variations","rect":[293.3439200000001,123.22899999999998,334.67763176000017,132.029],"fontSize":8.8},{"text":"that","rect":[341.53195176000014,123.22899999999998,358.1375517600002,132.029],"fontSize":8.8},{"text":"may","rect":[364.9918717600002,123.22899999999998,381.8175835200002,132.029],"fontSize":8.8},{"text":"affect","rect":[388.6719035200002,123.22899999999998,412.0007035200003,132.029],"fontSize":8.8},{"text":"contrast enhancement. The effects of","rect":[254,112.22899999999998,412.0023746399997,121.02899999999998],"fontSize":8.8},{"text":"these factors are largely unknown with","rect":[254,101.22899999999998,412.0038072800004,110.02899999999998],"fontSize":8.8},{"text":"little published clinical data. Some of","rect":[254,90.22899999999998,412.0039999999996,99.02899999999998],"fontSize":8.8},{"text":"the effects may be inferred from the","rect":[254,79.22899999999998,412.0042340799997,88.02899999999998],"fontSize":8.8},{"text":"available physiologic data and contrast","rect":[424,387.229,582.0016839200001,396.029],"fontSize":8.8},{"text":"material pharmacokinetics. For exam-","rect":[424,376.229,582.0032326399999,385.029],"fontSize":8.8},{"text":"ple, the magnitude and timing of con-","rect":[424,365.229,582.0016000000004,374.029],"fontSize":8.8},{"text":"trast enhancement are likely slightly","rect":[424,354.229,582.0021801600005,363.029],"fontSize":8.8},{"text":"different between men and women, in","rect":[424,343.229,581.99997176,352.029],"fontSize":8.8},{"text":"part because of their difference in blood","rect":[424,332.229,582.00225232,341.029],"fontSize":8.8},{"text":"volume (Eqq [1, 2]). Blood volumes in","rect":[424,321.229,581.99869888,330.029],"fontSize":8.8},{"text":"female patients are less than (by 5%–","rect":[424,310.229,582.0037826399999,319.029],"fontSize":8.8},{"text":"10% for an average-sized adult) those","rect":[424,299.229,581.99898576,308.029],"fontSize":8.8},{"text":"in male patients for a given weight and","rect":[424,288.229,582.00305048,297.029],"fontSize":8.8},{"text":"height. This difference may explain the","rect":[424,277.229,582.0038935200001,286.029],"fontSize":8.8},{"text":"clinical observation of higher contrast","rect":[424,266.229,582.0040263999998,275.029],"fontSize":8.8},{"text":"enhancement in female patients than","rect":[424,255.22899999999996,582.0004799999999,264.02899999999994],"fontSize":8.8},{"text":"male patients with the administration","rect":[424,244.22899999999996,582.0004923199999,253.02899999999997],"fontSize":8.8},{"text":"of a fixed iodine load per body weight","rect":[424,233.22899999999996,582.0026712,242.02899999999997],"fontSize":8.8},{"text":"(70). Furthermore, the decreased blood","rect":[424,222.22899999999996,582.0040533599998,231.02899999999997],"fontSize":8.8},{"text":"volume in female patients for a given","rect":[424.00001000000003,211.22899999999996,581.99846512,220.02899999999997],"fontSize":8.8},{"text":"cardiac output should affect the timing","rect":[424.00001000000003,200.22899999999996,582.0007700000003,209.02899999999997],"fontSize":8.8},{"text":"of","rect":[424.00001,189.22899999999996,431.92881,198.02899999999997],"fontSize":8.8},{"text":"contrast","rect":[439.23193000000003,189.22899999999996,473.6663916000001,198.02899999999997],"fontSize":8.8},{"text":"enhancement;","rect":[480.96951160000015,189.22899999999996,540.2639116000003,198.02899999999997],"fontSize":8.8},{"text":"contrast","rect":[547.5670316000002,189.22899999999996,582.0015416000002,198.02899999999997],"fontSize":8.8},{"text":"material bolus arrives slightly earlier in","rect":[424.00001,178.22899999999996,582.00407248,187.02899999999997],"fontSize":8.8},{"text":"female","rect":[424.00001,167.22899999999996,450.40880999999996,176.02899999999997],"fontSize":8.8},{"text":"patients","rect":[458.20473000000004,167.22899999999996,489.99033000000003,176.02899999999997],"fontSize":8.8},{"text":"than","rect":[497.78625000000005,167.22899999999996,515.5534500000001,176.02899999999997],"fontSize":8.8},{"text":"male","rect":[523.3493700000001,167.22899999999996,542.4189700000002,176.02899999999997],"fontSize":8.8},{"text":"patients","rect":[550.21489,167.22899999999996,582.00049,176.02899999999997],"fontSize":8.8},{"text":"(66,71,72). Some earlier studies, how-","rect":[424.00001,156.22899999999996,582.0025856799998,165.02899999999997],"fontSize":8.8},{"text":"ever, reported no significant difference","rect":[424.00007,145.22899999999996,582.00166632,154.02899999999997],"fontSize":8.8},{"text":"between sex in contrast enhancement","rect":[424.00007000000005,134.22899999999996,582.0005403200001,143.02899999999997],"fontSize":8.8},{"text":"timing (43,60).","rect":[424.00007000000005,123.22899999999996,484.6233844000001,132.02899999999997],"fontSize":8.8},{"text":"Age","rect":[438.0008700000001,112.22899999999996,453.0692719200001,121.02899999999995],"fontSize":8.8},{"text":"is","rect":[458.48215192000015,112.22899999999996,464.7943919200002,121.02899999999995],"fontSize":8.8},{"text":"likely","rect":[470.20727192000015,112.22899999999996,490.69539848000016,121.02899999999995],"fontSize":8.8},{"text":"related","rect":[496.1082784800002,112.22899999999996,523.7271920000001,121.02899999999995],"fontSize":8.8},{"text":"to","rect":[529.140072,112.22899999999996,537.089112,121.02899999999995],"fontSize":8.8},{"text":"a","rect":[542.501992,112.22899999999996,547.0691919999999,121.02899999999995],"fontSize":8.8},{"text":"delayed","rect":[552.4820719999999,112.22899999999996,582.0579323975996,121.02899999999995],"fontSize":8.8},{"text":"contrast enhancement because cardiac","rect":[424.0008700000001,101.22899999999996,582.0296340799998,110.02899999999995],"fontSize":8.8},{"text":"output is reduced with age (2,73,74).","rect":[424.0008700000001,90.22899999999996,582.0236700000003,99.02899999999995],"fontSize":8.8},{"text":"Some studies reported a mild positive","rect":[424.00167,79.22899999999996,582.0778634399993,88.02899999999995],"fontSize":8.8},{"text":"Figure 7:","rect":[84,441.325,112.721559415,449.825],"fontSize":8.5},{"text":"Simulated contrast enhancement curves of the","rect":[121.2207,441.325,261.4257460500004,449.825],"fontSize":8.5},{"text":"(a)","rect":[263.4647,441.325,271.8032,449.825],"fontSize":8.5},{"text":"abdominal aorta and","rect":[273.84220849999997,441.325,335.5369085000005,449.825],"fontSize":8.5},{"text":"(b)","rect":[337.58189999999996,441.325,346.0734,449.825],"fontSize":8.5},{"text":"liver based on a hypothetical adult male (30 years old; weight, 70 kg; height,","rect":[348.11292849999995,441.325,578.1059285000001,449.825],"fontSize":8.5},{"text":"170 cm) who underwent injection of 125 mL of contrast agent (350 mg of iodine per milliliter) at 4 mL/sec. A set of aortic and hepatic contrast enhancement curves","rect":[83.99891999999994,430.825,577.0926614000018,439.325],"fontSize":8.5},{"text":"was generated by reducing the baseline cardiac output","rect":[83.99891999999994,420.325,248.70767000000038,428.825],"fontSize":8.5},{"text":"(CO)","rect":[250.7729999439,420.325,263.68450019889997,428.825],"fontSize":8.500000000000004},{"text":"by 20%, 40%, and 60%. With a reduced cardiac output, contrast material bolus arrives slowly and clears","rect":[265.7260085,420.325,580.2695752500013,428.825],"fontSize":8.5},{"text":"slowly, resulting in delayed contrast material bolus arrival and delayed and elevated peak arterial and hepatic parenchymal enhancement.","rect":[83.99999999999997,409.825,495.6210000000002,418.325],"fontSize":8.5},{"text":"Figure 7","rect":[90,686.895,120.58180920000001,695.895],"fontSize":9}],"segments":[[49.38980000000001,73.95309999999999,76.38980000000001,73.95309999999999],[76.38980000000001,73.95309999999999,76.38980000000001,790.9171000000001],[76.38980000000001,790.9171000000001,49.38980000000001,790.9171000000001],[49.38980000000001,790.9171000000001,49.38980000000001,73.95309999999999],[49.38980000000001,73.95309999999999,76.38980000000001,73.95309999999999],[76.38980000000001,73.95309999999999,76.38980000000001,790.9171000000001],[76.38980000000001,790.9171000000001,49.38980000000001,790.9171000000001],[49.38980000000001,790.9171000000001,49.38980000000001,73.95309999999999],[49.38980000000001,73.95309999999999,76.38980000000001,73.95309999999999],[76.38980000000001,73.95309999999999,76.38980000000001,790.9171000000001],[76.38980000000001,790.9171000000001,49.38980000000001,790.9171000000001],[49.38980000000001,790.9171000000001,49.38980000000001,73.95309999999999],[67.3453,696.241,67.3453,698.0260000000001],[67.3453,698.0260000000001,54.07730000000001,698.0260000000001],[54.07730000000001,698.0260000000001,54.07730000000001,696.241],[54.07730000000001,696.241,53.5914,696.241],[60.8145,703.2810000000001,60.8535,703.2810000000001],[67.3453,709.245,67.83160000000001,709.245],[61.0977,701.84,61.0977,700.0550000000001],[61.0977,700.0550000000001,67.3453,700.0550000000001],[67.3453,700.0550000000001,67.3453,701.84],[67.3453,701.84,67.83160000000001,701.84],[67.83160000000001,696.241,67.3453,696.241],[60.61130000000001,700.0550000000001,60.61130000000001,701.84],[54.07730000000001,701.84,54.07730000000001,700.0550000000001],[54.07730000000001,700.0550000000001,60.61130000000001,700.0550000000001],[65.6016,714.964,65.6016,714.924],[62.4156,714.964,61.462500000000006,714.964],[61.8477,716.7080000000001,67.3863,716.7080000000001],[67.3863,716.7080000000001,67.3863,718.047],[67.3863,718.047,67.83160000000001,718.047],[67.83160000000001,714.964,65.6016,714.964],[64.0176,714.964,62.863699999999994,714.964],[67.3859,741.0520000000001,67.3859,742.4720000000001],[67.3859,742.4720000000001,54.03790000000001,742.4720000000001],[54.03790000000001,742.4720000000001,54.03790000000001,741.0520000000001],[54.03790000000001,741.0520000000001,53.591,741.0520000000001],[53.591,744.216,67.3859,744.216],[67.3859,744.216,67.3859,745.636],[67.3859,745.636,67.8309,745.636],[67.8309,741.0520000000001,67.3859,741.0520000000001],[69.677,767.402,67.7711,768.1320000000001],[67.7711,768.1320000000001,59.3121,764.399],[59.3121,764.399,59.3121,763.466],[59.3121,763.466,58.8648,763.466],[58.8648,767.767,59.3121,767.767],[59.3121,767.767,59.3121,766.3470000000001],[59.3121,766.3470000000001,65.6008,769.0450000000001],[65.6008,769.0450000000001,61.4211,770.7280000000001],[59.3121,771.398,59.3121,770.323],[59.3121,770.323,58.8648,770.323],[58.8648,773.142,59.3121,773.142],[59.3121,773.142,59.3121,772.27],[61.564099999999996,771.154,69.8609,767.767],[65.6594,724.783,65.6594,724.7420000000001],[61.0156,724.7420000000001,61.0156,724.783],[61.0156,724.783,54.03630000000001,724.783],[54.03630000000001,724.783,54.03630000000001,723.363],[54.03630000000001,723.363,53.5914,723.363],[53.5914,726.527,67.38440000000001,726.527],[67.38440000000001,726.527,67.38440000000001,727.9470000000001],[67.38440000000001,727.9470000000001,67.83160000000001,727.715],[67.83160000000001,724.783,65.6594,724.783],[67.38440000000001,727.482,67.38440000000001,728.9010000000001],[67.38440000000001,728.9010000000001,59.310500000000005,728.9010000000001],[59.310500000000005,728.9010000000001,59.310500000000005,727.482],[59.310500000000005,727.482,58.8656,727.482],[58.8656,730.6460000000001,67.38440000000001,730.6460000000001],[67.38440000000001,730.6460000000001,67.38440000000001,732.066],[67.38440000000001,732.066,67.83160000000001,732.066],[67.83160000000001,727.715,67.38440000000001,727.482],[59.3102,760.0970000000001,58.8629,759.2560000000001],[58.8629,762.6030000000001,59.3102,762.6030000000001],[59.3102,762.6030000000001,59.3102,760.0970000000001],[68.6816,760.8050000000001,68.51950000000001,758.4720000000001],[66.91760000000001,758.797,67.01950000000001,760.258],[84,74,582,74],[84,699,582,699],[84,777.1750000000001,582,777.1750000000001],[84,691.875,582,691.875],[18,819,3,819],[648,819,663,819],[18,36,3,36],[648,36,663,36],[36,837,36,852],[36,18,36,3],[630,837,630,852],[630,18,630,3],[18,819,3,819],[648,819,663,819],[18,36,3,36],[648,36,663,36],[36,837,36,852],[36,18,36,3],[630,837,630,852],[630,18,630,3]]}
