4.1465499999999,396.69308],"fontSize":7.721},{"text":"£","rect":[327.9116911,377.00993470000003,331.7721911,384.73093470000003],"fontSize":7.721},{"text":"391/patient/year","rect":[331.7667864,377.00993470000003,392.4754652,384.73093470000003],"fontSize":7.721},{"text":"and","rect":[398.38280230000004,377.00993470000003,412.39332890000003,384.73093470000003],"fontSize":7.721},{"text":"a","rect":[418.33927100000005,377.00993470000003,422.43912200000005,384.73093470000003],"fontSize":7.721},{"text":"reduction","rect":[428.37425470000005,377.00993470000003,464.40275700000007,384.73093470000003],"fontSize":7.721},{"text":"in","rect":[470.3286245000001,377.00993470000003,477.6689792000001,384.73093470000003],"fontSize":7.721},{"text":"ICA","rect":[483.59484670000006,377.00993470000003,496.85643630000004,384.73093470000003],"fontSize":7.721},{"text":"by","rect":[502.81318780000004,377.00993470000003,511.8220506,384.73093470000003],"fontSize":7.721},{"text":"60%","rect":[517.723983,377.00993470000003,534.1589036,384.73093470000003],"fontSize":7.721},{"text":"(48,53). Experts in the","rect":[327.9116911,365.04778940000006,412.5971632999999,372.76878940000006],"fontSize":7.721},{"text":"fi","rect":[415.55893889999993,365.04778940000006,420.53898389999995,372.76878940000006],"fontSize":7.721},{"text":"eld raised the following ques-","rect":[420.60461239999995,365.04778940000006,534.1643082999999,372.76878940000006],"fontSize":7.721},{"text":"tion","rect":[327.9116911,353.0856441000001,342.7746161,360.8066441000001],"fontSize":7.721},{"text":"in","rect":[348.0766268,353.0856441000001,355.4270188,360.8066441000001],"fontSize":7.721},{"text":"the","rect":[360.6718941,353.0856441000001,372.80158509999995,360.8066441000001],"fontSize":7.721},{"text":"European","rect":[378.08506539999996,353.0856441000001,413.1090656000001,360.8066441000001],"fontSize":7.721},{"text":"Heart","rect":[418.36706660000004,353.0856441000001,439.13964500000014,360.8066441000001],"fontSize":7.721},{"text"