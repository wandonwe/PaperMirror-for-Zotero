{"pageWidth":576,"pageHeight":773.972,"items":[{"text":"COST-EFFECTIVENESS OF FFR","rect":[109.7574,448.501556,248.8501423200001,456.47175599999997],"fontSize":7.9702},{"text":"C T","rect":[249.5054,447.725606,258.34956104,453.03830600000003],"fontSize":5.3127},{"text":"Diagnosis solely based on noninvasive imaging is not","rect":[109.7574,424.80208,315.9992078,432.52308],"fontSize":7.721},{"text":"only bene","rect":[109.7574,412.8399347,147.43974050000003,420.5609347],"fontSize":7.721},{"text":"fi","rect":[147.68526830000002,412.8399347,152.6653133,420.5609347],"fontSize":7.721},{"text":"cial for the patient from a medical point of","rect":[152.9008038,412.8399347,315.99225890000025,420.5609347],"fontSize":7.721},{"text":"view,","rect":[109.75740000000002,400.87778940000004,130.59792320000003,408.59878940000004],"fontSize":7.721},{"text":"but","rect":[135.57951240000003,400.87778940000004,148.39482820000003,408.59878940000004],"fontSize":7.721},{"text":"it","rect":[153.37950580000003,400.87778940000004,158.86141580000003,408.59878940000004],"fontSize":7.721},{"text":"is","rect":[163.84609340000003,400.87778940000004,169.93332980000005,408.59878940000004],"fontSize":7.721},{"text":"also","rect":[174.95738450000002,400.87778940000004,190.15540090000005,408.59878940000004],"fontSize":7.721},{"text":"cost","rect":[195.1786835,400.87778940000004,210.60060890000003,408.59878940000004],"fontSize":7.721},{"text":"effective","rect":[215.5852865,400.87778940000004,249.15619450000005,408.59878940000004],"fontSize":7.721},{"text":"from","rect":[254.22039840000002,400.87778940000004,272.5261173,408.59878940000004],"fontSize":7.721},{"text":"a","rect":[277.5941817000001,400.87778940000004,281.6940327000001,408.59878940000004],"fontSize":7.721},{"text":"societal","rect":[286.6648125000001,400.87778940000004,315.9783611000001,408.59878940000004],"fontSize":7.721},{"text":"perspective. In the United States, CTA ($301) with","rect":[109.75740000000002,388.91564410000007,316.0177381999999,396.63664410000007],"fontSize":7.721},{"text":"FFR","rect":[109.75740000000002,376.9534988000001,125.15307400000003,384.6744988000001],"fontSize":7.721},{"text":"CT","rect":[125.4047,376.215648,133.16468306000002,381.36224799999997],"fontSize":5.1466},{"text":"($1,500) is $1,138 cheaper than ICA ($2,838)","rect":[137.6503,376.95328,315.9999953,384.67428],"fontSize":7.721},{"text":"with FFR ($101) (39,47). In the United Kingdom, ac-","rect":[109.75741539999997,364.99113470000003,315.96216240000007,372.71213470000004],"fontSize":7.721},{"text":"cording to the National Institute for Health and Care","rect":[109.75741539999994,353.02898940000006,316.0146651999999,360.74998940000006],"fontSize":7.721},{"text":"Excellence (NICE) guidance updated in 2021, the cost","rect":[109.75741539999994,341.12320740000007,315.9112038000002,348.8442074000001],"fontSize":7.721},{"text":"of CTA (","rect":[109.75741539999994,329.1610621000001,140.07083349999994,336.8820621000001],"fontSize":7.721},{"text":"£","rect":[140.31481709999994,329.1610621000001,144.17531709999994,336.8820621000001],"fontSize":7.721},{"text":"290) with FFR","rect":[144.16991239999993,329.1610621000001,197.8300903,336.8820621000001],"fontSize":7.721},{"text":"CT","rect":[198.0283,328.423548,205.78828306,333.57014799999996],"fontSize":5.1466},{"text":"(","rect":[207.8929,329.16107999999997,210.541203,336.88208],"fontSize":7.721},{"text":"£","rect":[210.7844145,329.16107999999997,214.6449145,336.88208],"fontSize":7.721},{"text":"700) is also lower than ICA","rect":[214.63950979999998,329.16107999999997,315.9730021999998,336.88208],"fontSize":7.721},{"text":"(","rect":[109.75744579999999,317.1989347,112.40574879999998,324.9199347],"fontSize":7.721},{"text":"£","rect":[112.64896029999998,317.1989347,116.50946029999999,324.9199347],"fontSize":7.721},{"text":"2,369) with FFR (48).","rect":[116.50405559999999,317.1989347,198.77285479999998,324.9199347],"fontSize":7.721},{"text":"The","rect":[119.73529409999999,305.2367894,133.89020340000002,312.9577894],"fontSize":7.721},{"text":"prospective,","rect":[144.22630610000002,305.2367894,189.98481260000003,312.9577894],"fontSize":7.721},{"text":"randomized","rect":[200.35257139999996,305.2367894,244.97686299999995,312.9577894],"fontSize":7.721},{"text":"PROMISE","rect":[255.40175719999996,305.2367894,290.4759439,312.9577894],"fontSize":7.721},{"text":"trial","rect":[300.9270895,305.2367894,315.95910440000006,312.9577894],"fontSize":7.721},{"text":"compared","rect":[109.75744579999999,293.27464410000005,146.78427340000002,300.99564410000005],"fontSize":7.721},{"text":"an","rect":[151.9936321,293.27464410000005,160.99631810000002,300.99564410000005],"fontSize":7.721},{"text":"anatomical","rect":[166.2805705,293.27464410000005,207.23970340000005,300.99564410000005],"fontSize":7.721},{"text":"testing","rect":[212.48689500000003,293.27464410000005,238.00943260000003,300.99564410000005],"fontSize":7.721},{"text":"strategy","rect":[243.21493080000002,293.27464410000005,273.1430710000001,300.99564410000005],"fontSize":7.721},{"text":"with","rect":[278.3647833,293.27464410000005,295.1000508,300.99564410000005],"fontSize":7.721},{"text":"CTA","rect":[300.36191230000003,293.27464410000005,315.94829500000003,300.99564410000005],"fontSize":7.721},{"text":"(n","rect":[109.75744579999999,281.31249880000007,117.38116119999998,289.0334988000001],"fontSize":7.721},{"text":"¼","rect":[119.16857269999998,281.31249880000007,125.11374269999999,289.0334988000001],"fontSize":7.721},{"text":"4,996) with a functional testing strategy (n","rect":[126.87876329999999,281.31249880000007,283.4946157,289.0334988000001],"fontSize":7.721},{"text":"¼","rect":[285.2789388,281.31249880000007,291.2241088,289.0334988000001],"fontSize":7.721},{"text":"5,007)","rect":[292.98912939999997,281.31249880000007,315.98998839999996,289.0334988000001],"fontSize":7.721},{"text":"in patients with stable chest pain, with ICA showing","rect":[109.75744579999997,269.3503535000001,315.9606486,277.0713535000001],"fontSize":7.721},{"text":"nonobstructive CAD assessed as a secondary endpoint","rect":[109.75744579999997,257.3882082000001,315.95678810000004,265.1092082000001],"fontSize":7.721},{"text":"(49). In the anatomical testing group, 609 patients un-","rect":[109.75744579999997,245.48242620000013,315.9506112999999,253.20342620000014],"fontSize":7.721},{"text":"derwent an ICA, and among them 311 (51.1%) received","rect":[109.75744579999997,233.52028090000013,315.95756020000005,241.24128090000013],"fontSize":7.721},{"text":"revascularization. ICA was performed in 406 patients in","rect":[109.75744579999997,221.55813560000013,316.0293654999999,229.27913560000013],"fontSize":7.721},{"text":"the functional-testing group, and revascularization was","rect":[109.75744579999997,209.59599030000012,315.9776347999999,217.31699030000013],"fontSize":7.721},{"text":"performed in 158 patients (38.9%). In the PROMISE trial,","rect":[109.75744579999997,197.63384500000012,315.90969,205.35484500000013],"fontSize":7.721},{"text":"FFR","rect":[109.75744579999997,185.67169970000012,124.86975909999998,193.39269970000012],"fontSize":7.721},{"text":"CT","rect":[124.9511,184.933848,132.4846706,190.08044800000002],"fontSize":5.1466},{"text":"was retrospectively calculated in 181 patients with","rect":[133.9086,185.67138,315.90646780000003,193.39238],"fontSize":7.721},{"text":"CTA and ICA, and 50 patients (27.7%) had an FFR","rect":[109.75731200000001,173.7092347,308.2248449000001,181.4302347],"fontSize":7.721},{"text":"CT","rect":[308.3527,173.028348,315.9991873000001,178.174948],"fontSize":5.1466},{"text":">","rect":[109.7574,161.74698,115.70257000000001,169.46798],"fontSize":7.721},{"text":"0.80, which suggested that FFR","rect":[115.710291,161.74698,236.79024090000004,169.46798],"fontSize":7.721},{"text":"CT","rect":[236.9196,161.066148,244.5660873,166.212748],"fontSize":5.1466},{"text":"could additionally","rect":[247.5212,161.74698,315.8968318,169.46798],"fontSize":7.721},{"text":"reduce","rect":[109.75771329999998,149.84119800000002,135.07873279999995,157.56219800000002],"fontSize":7.721},{"text":"unnecessary","rect":[139.91593929999996,149.84119800000002,186.2187762999999,157.56219800000002],"fontSize":7.721},{"text":"ICA","rect":[191.0436291999999,149.84119800000002,204.26815799999991,157.56219800000002],"fontSize":7.721},{"text":"(50).","rect":[209.1292995999999,149.84119800000002,225.9996846,157.56219800000002],"fontSize":7.721},{"text":"The","rect":[230.81141179999997,149.84119800000002,244.96863739999998,157.56219800000002],"fontSize":7.721},{"text":"PLATFORM","rect":[249.74870849999996,149.84119800000002,293.0411276,157.56219800000002],"fontSize":7.721},{"text":"(Pro-","rect":[297.84590590000005,149.84119800000002,315.9385252000001,157.56219800000002],"fontSize":7.721},{"text":"spective Longitudinal Trial of FFRCT: Outcome and","rect":[109.75771329999998,137.87905270000002,315.98407909999986,145.60005270000002],"fontSize":7.721},{"text":"Resource Impacts) trial prospectively compared usual","rect":[109.75771329999998,125.91690740000001,315.9609161000002,133.63790740000002],"fontSize":7.721},{"text":"care to FFR","rect":[109.75771329999998,113.95476210000001,151.7429671,121.67576210000001],"fontSize":7.721},{"text":"CT","rect":[151.8236,113.217348,159.3571706,118.36394800000001],"fontSize":5.1466},{"text":"-guided evaluation in stable, symptomatic","rect":[159.4771,113.95487999999999,315.9771373999997,121.67587999999999],"fontSize":7.721},{"text":"patients with suspected CAD. In 58% (112 of 193) of pa-","rect":[109.7577205,101.99273469999999,315.9161414999999,109.71373469999999],"fontSize":7.721},{"text":"tients, scheduled ICA was no longer required following","rect":[109.7577205,90.03058939999998,315.95860700000003,97.75158939999999],"fontSize":7.721},{"text":"their FFR","rect":[109.7577205,78.06844409999998,144.37945660000003,85.78944409999998],"fontSize":7.721},{"text":"CT,","rect":[144.5669,77.387348,153.96909722,82.53394800000001],"fontSize":5.1466},{"text":"which was associated with lower costs (39).","rect":[155.9055,78.06828,315.9564253,85.78928],"fontSize":7.721},{"text":"NICE advocates CTA as the","rect":[119.73570340000003,66.1061347,220.35809169999996,73.8271347],"fontSize":7.721},{"text":"fi","rect":[222.68983370000004,66.1061347,227.66987870000003,73.8271347],"fontSize":7.721},{"text":"rst-line test for patients","rect":[227.73550720000003,66.1061347,315.97341150000005,73.8271347],"fontSize":7.721},{"text":"with CAD with a potential increase in CTA by 400%","rect":[109.75785510000003,54.2003527,315.8954293999999,61.9213527],"fontSize":7.721},{"text":"(4,51).","rect":[109.75785510000003,42.2382074,132.29390990000002,49.9592074],"fontSize":7.721},{"text":"In","rect":[137.16200040000004,42.2382074,144.80887880000006,49.9592074],"fontSize":7.721},{"text":"the","rect":[149.65689470000007,42.2382074,161.65069610000006,49.9592074],"fontSize":7.721},{"text":"2019","rect":[166.59445240000008,42.2382074,183.4918609000001,49.9592074],"fontSize":7.721},{"text":"ESC","rect":[188.34450940000005,42.2382074,202.66078760000005,49.9592074],"fontSize":7.721},{"text":"guidelines,","rect":[207.56362260000006,42.2382074,248.53588120000018,49.9592074],"fontSize":7.721},{"text":"CTA","rect":[253.40397170000014,42.2382074,268.9903544000002,49.9592074],"fontSize":7.721},{"text":"along","rect":[273.87002640000014,42.2382074,294.30442500000015,49.9592074],"fontSize":7.721},{"text":"with","rect":[299.1701992000002,42.2382074,315.89542940000024,49.9592074],"fontSize":7.721},{"text":"noninvasive functional imaging was given a Class I,","rect":[327.9108496,448.72569439999995,534.1796808999998,456.44669439999996],"fontSize":7.721},{"text":"Level of Evidence: B recommendation as the initial test","rect":[327.9108496,436.7635491,534.2167417000003,444.4845491],"fontSize":7.721},{"text":"to","rect":[327.9108496,424.8014038,335.41720580000003,432.5224038],"fontSize":7.721},{"text":"diagnose","rect":[340.099