{"pageWidth":594,"pageHeight":783,"items":[{"text":"STATE OF THE ART:","rect":[84,781.365,150.6178236,790.365],"fontSize":9},{"text":"Contrast Medium Administration and Scan Timing at CT","rect":[152.778,781.365,329.0365470000002,790.365],"fontSize":9},{"text":"Bae","rect":[569.804,781.365,581.9738,790.365],"fontSize":9},{"text":"50","rect":[84,57.168999999999976,92.24000000000001,65.16899999999998],"fontSize":8},{"text":"radiology.rsna.org","rect":[408.3349999538,57.3889,452.76400016379995,64.3889],"fontSize":7.0000000000000036},{"text":"n","rect":[456.263,58.5239,458.48699999999997,62.5239],"fontSize":4},{"text":"Radiology:","rect":[461.9869999538,57.3889,491.11400016380003,64.3889],"fontSize":7.0000000000000036},{"text":"Volume 256: Number 1—July 2010","rect":[492.891,57.3889,581.9895956000009,64.3889],"fontSize":7},{"text":"clinical images are routinely acquired in","rect":[84,684.2339999999999,242.03216440000028,693.0339999999999],"fontSize":8.8},{"text":"less than 10 seconds. Clinical CT appli-","rect":[84,673.2339999999999,242.03477008000024,682.0339999999999],"fontSize":8.8},{"text":"cations requiring long scans include","rect":[84,662.2339999999999,227.1840669600002,671.0339999999999],"fontSize":8.8},{"text":"(a)","rect":[230.358,662.2339999999999,242.00216000000003,671.0339999999999],"fontSize":8.8},{"text":"peripheral runoff CT angiography that","rect":[84.0002,651.2339999999999,242.00053872000012,660.0339999999999],"fontSize":8.8},{"text":"involves large anatomic coverage and is","rect":[84.00020000000002,640.2339999999999,242.02820760400004,649.0339999999999],"fontSize":8.8},{"text":"often","rect":[84.00020000000002,629.2339999999999,104.21556000000004,638.0339999999999],"fontSize":8.8},{"text":"delayed","rect":[109.54836000000003,629.2339999999999,139.12684432000006,638.0339999999999],"fontSize":8.8},{"text":"intentionally","rect":[144.45964432000005,629.2339999999999,193.1905243200001,638.0339999999999],"fontSize":8.8},{"text":"to","rect":[198.5233243200001,629.2339999999999,206.4723643200001,638.0339999999999],"fontSize":8.8},{"text":"allow","rect":[211.8051643200001,629.2339999999999,232.1762772800001,638.0339999999999],"fontSize":8.8},{"text":"a","rect":[237.5090772800001,629.2339999999999,242.0762772800001,638.0339999999999],"fontSize":8.8},{"text":"slow","rect":[84.00020000000002,618.2339999999999,101.46808560000002,627.0339999999999],"fontSize":8.8},{"text":"contrast","rect":[107.59376560000003,618.2339999999999,139.87209256,627.0339999999999],"fontSize":8.8},{"text":"material","rect":[145.99777256,618.2339999999999,178.7777725599999,627.0339999999999],"fontSize":8.8},{"text":"bolus","rect":[184.90345255999995,618.2339999999999,205.7506525599999,627.0339999999999],"fontSize":8.8},{"text":"flow","rect":[211.87633255999987,618.2339999999999,227.92760000000007,627.0339999999999],"fontSize":8.8},{"text":"to","rect":[234.05432016000006,618.2339999999999,242.00063304000005,627.0339999999999],"fontSize":8.8},{"text":"transit into distal arteries,","rect":[84.00020000000004,607.2339999999999,191.79821696,616.0339999999999],"fontSize":8.8},{"text":"(b)","rect":[195.74910000000003,607.2339999999999,208.1571,616.0339999999999],"fontSize":8.8},{"text":"cardiac","rect":[212.10830000000004,607.2339999999999,242.00205927999997,616.0339999999999],"fontSize":8.8},{"text":"CT angiography that may require a high","rect":[84.00110000000004,596.2339999999999,242.02996476000004,605.0339999999999],"fontSize":8.8},{"text":"degree of scan overlap, and","rect":[84.00110000000004,585.2339999999999,199.2285050399999,594.0339999999999],"fontSize":8.8},{"text":"(c)","rect":[203.49710000000005,585.2339999999999,214.6467,594.0339999999999],"fontSize":8.8},{"text":"multi-","rect":[218.91940000000002,585.2339999999999,242.00179999999997,594.0339999999999],"fontSize":8.8},{"text":"phasic and perfusion acquisitions that","rect":[84.00100000000003,574.2339999999999,242.00147999999973,583.0339999999999],"fontSize":8.8},{"text":"are obtained at different phases or time","rect":[84.00100000000003,563.2339999999999,241.9943933599998,572.0339999999999],"fontSize":8.8},{"text":"points of contrast enhancement.","rect":[84.00100000000003,552.2339999999999,212.60609940000006,561.0339999999999],"fontSize":8.8},{"text":"As","rect":[98.00100000000003,541.2339999999999,108.48180000000004,550.0339999999999],"fontSize":8.8},{"text":"contrast","rect":[115.63268000000004,541.2339999999999,149.75909232,550.0339999999999],"fontSize":8.8},{"text":"medium","rect":[156.90997232,541.2339999999999,190.27957232,550.0339999999999],"fontSize":8.8},{"text":"distributes","rect":[197.43045232000003,541.2339999999999,242.00245232000003,550.0339999999999],"fontSize":8.8},{"text":"throughout body via the central blood","rect":[84.00100000000003,530.2339999999999,242.00475008,539.0339999999999],"fontSize":8.8},{"text":"circulation, contrast enhancement is re-","rect":[84.00100000000003,519.2339999999999,242.0034001600001,528.0339999999999],"fontSize":8.8},{"text":"duced as the contrast material propa-","rect":[84.00100000000003,508.234,242.00506160000012,517.034],"fontSize":8.8},{"text":"gates downstream in the circulation. CT","rect":[84.00100000000003,497.234,242.0045652800001,506.034],"fontSize":8.8},{"text":"scanning following along this directional","rect":[84.00100000000003,486.234,242.0053678400001,495.034],"fontSize":8.8},{"text":"flow of contrast medium would improve","rect":[84.00100000000003,475.234,242.00022064000004,484.034],"fontSize":8.8},{"text":"contrast enhancement and makes effi-","rect":[84.00100000000003,464.234,242.00139999999996,473.034],"fontSize":8.8},{"text":"cient use of contrast medium. Thus, the","rect":[84.00100000000003,453.234,242.00355768000003,462.034],"fontSize":8.8},{"text":"maximal contrast enhancement may be","rect":[84.00100000000003,442.234,242.0016656800001,451.034],"fontSize":8.8},{"text":"achieved by starting the scan at the up-","rect":[84.00100000000003,431.234,242.00152223999999,440.034],"fontSize":8.8},{"text":"stream peak enhancement and moving","rect":[84.00100000000003,420.234,242.00170176000006,429.034],"fontSize":8.8},{"text":"downstream","rect":[84.00100000000003,409.234,132.49788800000005,418.034],"fontSize":8.8},{"text":"at","rect":[137.83156800000006,409.234,145.43476800000008,418.034],"fontSize":8.8},{"text":"the","rect":[150.7684480000001,409.234,163.3612480000001,418.034],"fontSize":8.8},{"text":"same","rect":[168.69492800000012,409.234,189.20772800000012,418.034],"fontSize":8.8},{"text":"rate","rect":[194.54140800000016,409.234,210.32854728000018,418.034],"fontSize":8.8},{"text":"as","rect":[215.6622272800002,409.234,224.0750272800002,418.034],"fontSize":8.8},{"text":"the","rect":[229.40870728000021,409.234,242.00150728000023,418.034],"fontSize":8.8},{"text":"propagation of peak enhancement with-","rect":[84.00100000000003,398.234,242.00321008,407.034],"fontSize":8.8},{"text":"out","rect":[84.00100000000003,387.234,96.76100000000004,396.034],"fontSize":8.8},{"text":"outrunning","rect":[102.85060000000003,387.234,145.97940000000006,396.034],"fontSize":8.8},{"text":"or","rect":[152.06900000000002,387.234,160.80740000000003,396.034],"fontSize":8.8},{"text":"falling","rect":[166.897,387.234,190.3226,396.034],"fontSize":8.8},{"text":"behind","rect":[196.4122,387.234,223.32260000000002,396.034],"fontSize":8.8},{"text":"the","rect":[229.4122,387.234,242.00500000000002,396.034],"fontSize":8.8},{"text":"peak enhancement of the contrast mate-","rect":[84.00100000000003,376.234,242.00489000000007,385.034],"fontSize":8.8},{"text":"rial bolus. Chasing the contrast material","rect":[84.00100000000003,365.234,242.0049146400001,374.034],"fontSize":8.8},{"text":"bolus may not be feasible with a slow CT","rect":[84.00100000000003,354.234,242.00301384000014,363.034],"fontSize":8.8},{"text":"scanner, and there may be a consider-","rect":[84.00100000000003,343.234,242.00482312000008,352.034],"fontSize":8.8},{"text":"able craniocaudal difference in contrast","rect":[84.00100000000003,332.234,242.00526928000008,341.034],"fontSize":8.8},{"text":"enhancement depending on scan direc-","rect":[84.00100000000003,321.234,242.00313,330.034],"fontSize":8.8},{"text":"tion, even for a relatively small scanning","rect":[84.00100000000003,310.234,242.00346528000017,319.034],"fontSize":8.8},{"text":"volume such the liver (44,193,194). The","rect":[84.00100000000003,299.234,242.0011000000001,308.034],"fontSize":8.8},{"text":"differential contrast enhancement asso-","rect":[84.00210000000007,288.234,242.0044623200001,297.034],"fontSize":8.8},{"text":"ciated with scanning in the craniocaudal","rect":[84.00210000000007,277.234,242.00624696000014,286.034],"fontSize":8.8},{"text":"direction would be reduced by extend-","rect":[84.00210000000007,266.234,242.00149056000015,275.034],"fontSize":8.8},{"text":"ing the injection duration, maintaining","rect":[84.00210000000007,255.23399999999995,242.00415696000013,264.03399999999993],"fontSize":8.8},{"text":"uniform","rect":[84.00210000000007,244.23399999999995,115.25090000000009,253.03399999999996],"fontSize":8.8},{"text":"contrast","rect":[120.68842000000008,244.23399999999995,152.8434739200001,253.03399999999996],"fontSize":8.8},{"text":"enhancement","rect":[158.2809939200001,244.23399999999995,211.12499392000012,253.03399999999996],"fontSize":8.8},{"text":"during","rect":[216.56251392000016,244.23399999999995,242.00331392000015,253.03399999999996],"fontSize":8.8},{"text":"the","rect":[84.00210000000007,233.23399999999995,96.59490000000008,242.03399999999996],"fontSize":8.8},{"text":"CT","rect":[102.37738000000007,233.23399999999995,113.88770872000008,242.03399999999996],"fontSize":8.8},{"text":"scan,","rect":[119.67018872000008,233.23399999999995,140.11258872000008,242.03399999999996],"fontSize":8.8},{"text":"or","rect":[145.89506872000007,233.23399999999995,154.63346872000008,242.03399999999996],"fontSize":8.8},{"text":"increasing","rect":[160.41594872000005,233.23399999999995,200.27119800000006,242.03399999999996],"fontSize":8.8},{"text":"the","rect":[206.05367800000008,233.23399999999995,218.6464780000001,242.03399999999996],"fontSize":8.8},{"text":"scan","rect":[224.42895800000008,233.23399999999995,242.00255800000008,242.03399999999996],"fontSize":8.8},{"text":"speed. However, scanning too fast may","rect":[84.00210000000007,222.23399999999995,242.00253640000008,231.03399999999996],"fontSize":8.8},{"text":"outpace the propagation of contrast en-","rect":[84.00290000000008,211.23399999999995,242.00685160000012,220.03399999999996],"fontSize":8.8},{"text":"hancement and reach the downstream","rect":[84.00290000000008,200.23399999999995,242.00329552000017,209.03399999999996],"fontSize":8.8},{"text":"distal arteries before the transit of con-","rect":[84.00290000000008,189.23399999999995,242.00369856000015,198.03399999999996],"fontSize":8.8},{"text":"trast medium, resulting in weak down-","rect":[84.00290000000008,178.23399999999995,242.0022421600001,187.03399999999996],"fontSize":8.8},{"text":"stream enhancement (67).","rect":[84.00290000000008,167.23399999999995,189.31969928000007,176.03399999999996],"fontSize":8.8},{"text":"While clinical contrast-enhanced CT","rect":[98.00290000000008,156.23399999999995,242.00412264000005,165.03399999999996],"fontSize":8.8},{"text":"scans are usually performed with the","rect":[84.00290000000008,145.23399999999995,242.00691232000014,154.03399999999996],"fontSize":8.8},{"text":"scan direction commensurate with the","rect":[84.00290000000008,134.23399999999995,242.00363696000005,143.03399999999996],"fontSize":8.8},{"text":"direction","rect":[84.00290000000008,123.23399999999995,119.52840232000008,132.03399999999996],"fontSize":8.8},{"text":"of","rect":[126.55696232000005,123.23399999999995,134.22176232000007,132.03399999999996],"fontSize":8.8},{"text":"contrast","rect":[141.25032232000004,123.23399999999995,173.83662464000005,132.03399999999996],"fontSize":8.8},{"text":"material","rect":[180.86518464000002,123.23399999999995,213.95318464000002,132.03399999999996],"fontSize":8.8},{"text":"bolus","rect":[220.98174464000007,123.23399999999995,242.00494464000008,132.03399999999996],"fontSize":8.8},{"text":"propagation, one notable exception is","rect":[84.00290000000008,112.23399999999995,242.0048592799999,121.03399999999995],"fontSize":8.8},{"text":"caudocranial scanning at pulmonary CT","rect":[84.00290000000008,101.23399999999995,242.0037240800001,110.03399999999995],"fontSize":8.8},{"text":"angiography for the detection of pulmo-","rect":[84.00290000000008,90.23399999999995,242.0070980000001,99.03399999999995],"fontSize":8.8},{"text":"nary emboli. Scanning the lower lobes","rect":[84.00290000000008,79.23399999999995,242.00219816000003,88.03399999999995],"fontSize":8.8},{"text":"first","rect":[254.00290000000007,684.2339999999999,269.47332840000007,693.0339999999999],"fontSize":8.8},{"text":"is","rect":[274.9011684,684.2339999999999,281.2547684,693.0339999999999],"fontSize":8.8},{"text":"beneficial","rect":[286.6826084,684.2339999999999,324.1691212,693.0339999999999],"fontSize":8.8},{"text":"because","rect":[329.5969612,684.2339999999999,361.3825612,693.0339999999999],"fontSize":8.8},{"text":"emboli","rect":[366.81040120000006,684.2339999999999,393.7032012000001,693.0339999999999],"fontSize":8.8},{"text":"are","rect":[399.1310412000001,684.2339999999999,412.0052581600001,693.0339999999999],"fontSize":8.8},{"text":"more frequently located in the lower","rect":[254.00290000000007,673.2339999999999,412.00228439999995,682.0339999999999],"fontSize":8.8},{"text":"lobes and, if the patient breathes dur-","rect":[254.00290000000007,662.2339999999999,412.0050792800001,671.0339999999999],"fontSize":8.8},{"text":"ing image acquisition, there is more ex-","rect":[254.00290000000007,651.2339999999999,412.0032216000001,660.0339999999999],"fontSize":8.8},{"text":"cursion of the lower lobes than the up-","rect":[254.00290000000007,640.2339999999999,412.00163583999995,649.0339999999999],"fontSize":8.8},{"text":"per lobes (195). A secondary benefit of","rect":[254.00290000000007,629.2339999999999,412.00325943999997,638.0339999999999],"fontSize":8.8},{"text":"caudocranial","rect":[254.0045000000001,618.2339999999999,304.5254592800001,627.0339999999999],"fontSize":8.8},{"text":"scanning","rect":[310.0052192800002,618.2339999999999,344.7124192800002,627.0339999999999],"fontSize":8.8},{"text":"is","rect":[350.1921792800001,618.2339999999999,356.54577928000015,627.0339999999999],"fontSize":8.8},{"text":"that","rect":[362.0255392800001,618.2339999999999,377.8391392800001,627.0339999999999],"fontSize":8.8},{"text":"artifact","rect":[383.3188992800001,618.2339999999999,412.0068992800001,627.0339999999999],"fontSize":8.8},{"text":"from dense contrast medium flowing in","rect":[254.0045000000001,607.2339999999999,412.0049568,616.0339999999999],"fontSize":8.8},{"text":"the","rect":[254.00450000000006,596.2339999999999,266.7205000000001,605.0339999999999],"fontSize":8.8},{"text":"superior","rect":[272.4713000000001,596.2339999999999,306.0433000000001,605.0339999999999],"fontSize":8.8},{"text":"vena","rect":[311.7941000000001,596.2339999999999,330.0541624800001,605.0339999999999],"fontSize":8.8},{"text":"cava","rect":[335.80496248000014,596.2339999999999,352.92091760000017,605.0339999999999],"fontSize":8.8},{"text":"is","rect":[358.6717176000002,596.2339999999999,365.0253176000002,605.0339999999999],"fontSize":8.8},{"text":"minimized","rect":[370.7761176000002,596.2339999999999,412.0041176000002,605.0339999999999],"fontSize":8.8},{"text":"when scanning later after the contrast","rect":[254.00450000000006,585.2339999999999,412.00853696000013,594.0339999999999],"fontSize":8.8},{"text":"medium","rect":[254.00450000000006,574.2339999999999,286.2741000000001,583.0339999999999],"fontSize":8.8},{"text":"has","rect":[292.8732200000001,574.2339999999999,306.3988200000001,583.0339999999999],"fontSize":8.8},{"text":"been","rect":[312.99794000000014,574.2339999999999,332.23474000000016,583.0339999999999],"fontSize":8.8},{"text":"flushed","rect":[338.8338600000002,574.2339999999999,367.0291000000001,583.0339999999999],"fontSize":8.8},{"text":"from","rect":[373.62913520000006,574.2339999999999,392.6900452000001,583.0339999999999],"fontSize":8.8},{"text":"the","rect":[399.2892972000001,574.2339999999999,412.0052972000001,583.0339999999999],"fontSize":8.8},{"text":"veins. A similar benefit in artifact re-","rect":[254.00450000000006,563.2339999999999,412.00482776000024,572.0339999999999],"fontSize":8.8},{"text":"duction was observed at carotid artery","rect":[254.00450000000006,552.2339999999999,412.00858888000005,561.0339999999999],"fontSize":8.8},{"text":"CT angiography performed with use of","rect":[254.00450000000006,541.2339999999999,412.00406744000003,550.0339999999999],"fontSize":8.8},{"text":"a","rect":[254.00450000000006,530.2339999999999,258.5717000000001,539.0339999999999],"fontSize":8.8},{"text":"craniocaudal","rect":[264.7862600000001,530.2339999999999,315.3071946400001,539.0339999999999],"fontSize":8.8},{"text":"scan","rect":[321.52175464000015,530.2339999999999,339.28015464000015,539.0339999999999],"fontSize":8.8},{"text":"direction","rect":[345.49471464000015,530.2339999999999,381.0202292800002,539.0339999999999],"fontSize":8.8},{"text":"(196).","rect":[387.23478928000014,530.2339999999999,412.0040232000001,539.0339999999999],"fontSize":8.8},{"text":"However, when the scan direction is op-","rect":[254.0045000000001,519.2339999999999,412.00473695999995,528.0339999999999],"fontSize":8.8},{"text":"posite to the flow of contrast medium","rect":[254.00450000000006,508.234,412.00559688,517.034],"fontSize":8.8},{"text":"for a long scan, contrast material injec-","rect":[254.00450000000006,497.234,412.0065815999999,506.034],"fontSize":8.8},{"text":"tion duration may need to be increased","rect":[254.00450000000006,486.234,412.0082465599999,495.034],"fontSize":8.8},{"text":"to ensure adequate enhancement of the","rect":[254.00450000000006,475.234,412.00858536,484.034],"fontSize":8.8},{"text":"upstream structures.","rect":[254.00450000000006,464.234,337.41927408000004,473.034],"fontSize":8.8},{"text":"Fast scan speed and coverage with","rect":[268.00450000000006,453.234,412.00735240000006,462.034],"fontSize":8.8},{"text":"multidetector CT facilitates acquisition","rect":[254.00450000000006,442.234,412.00668104,451.034],"fontSize":8.8},{"text":"at multiple precisely defined phases of","rect":[254.00450000000006,431.234,412.0058705600002,440.034],"fontSize":8.8},{"text":"contrast enhancement and may improve","rect":[254.00450000000006,420.234,412.0049254400001,429.034],"fontSize":8.8},{"text":"the","rect":[254.00450000000006,409.234,266.7205000000001,418.034],"fontSize":8.8},{"text":"detection","rect":[272.1149000000001,409.234,309.1189000000001,418.034],"fontSize":8.8},{"text":"and","rect":[314.51330000000013,409.234,329.18290000000013,418.034],"fontSize":8.8},{"text":"characterization","rect":[334.57730000000015,409.234,398.94936160000015,418.034],"fontSize":8.8},{"text":"of","rect":[404.34376160000016,409.234,412.0085616000002,418.034],"fontSize":8.8},{"text":"lesions in various organs including the","rect":[254.00450000000006,398.234,412.00823336,407.034],"fontSize":8.8},{"text":"liver, pancreas, kidney, and vessels. Op-","rect":[254.00450000000006,387.234,412.00844016,396.034],"fontSize":8.8},{"text":"timization of phase-specific contrast en-","rect":[254.00450000000006,376.234,412.00525984,385.034],"fontSize":8.8},{"text":"hancement in an organ is complex and","rect":[254.00450000000006,365.234,412.0067162400002,374.034],"fontSize":8.8},{"text":"requires consideration of multiple injec-","rect":[254.00450000000006,354.234,412.00844016,363.034],"fontSize":8.8},{"text":"tion and scanning factors as well as in-","rect":[254.00450000000006,343.234,412.00507944000003,352.034],"fontSize":8.8},{"text":"dividual patient’s circulation time. This","rect":[254.00450000000006,332.234,412.00654640000016,341.034],"fontSize":8.8},{"text":"is","rect":[254.00450000000006,321.234,260.35810000000004,330.034],"fontSize":8.8},{"text":"discussed","rect":[266.02354,321.234,303.98674000000005,330.034],"fontSize":8.8},{"text":"in","rect":[309.65218,321.234,317.14977999999996,330.034],"fontSize":8.8},{"text":"detail","rect":[322.81521999999995,321.234,344.82401999999996,330.034],"fontSize":8.8},{"text":"in","rect":[350.48945999999995,321.234,357.98705999999993,330.034],"fontSize":8.8},{"text":"each","rect":[363.6524999999999,321.234,382.07089999999994,330.034],"fontSize":8.8},{"text":"corre-","rect":[387.7363399999999,321.234,412.0067769599999,330.034],"fontSize":8.8},{"text":"sponding clinical application in the clin-","rect":[254.00450000000006,310.234,412.00850000000014,319.034],"fontSize":8.8},{"text":"ical considerations section in Appendix","rect":[254.00450000000006,299.234,412.00470000000007,308.034],"fontSize":8.8},{"text":"E1 (online).","rect":[254.00450000000006,288.234,301.7532032000001,297.034],"fontSize":8.8},{"text":"Key points.—","rect":[269.00450000000006,277.234,323.58099032000007,286.034],"fontSize":8.8},{"text":"1. Scan duration infor-","rect":[323.5803000000001,277.234,412.0052762800005,286.034],"fontSize":8.8},{"text":"mation is crucial for the calculation of the","rect":[254.0037000000001,266.234,412.0041800000007,275.034],"fontSize":8.8},{"text":"injection duration and scan timing. For a","rect":[254.0037000000001,255.23399999999995,412.0040216000008,264.03399999999993],"fontSize":8.8},{"text":"long scan, an extended injection is likely","rect":[254.0037000000001,244.23399999999995,412.0059162400006,253.03399999999996],"fontSize":8.8},{"text":"required.","rect":[254.0037000000001,233.23399999999995,289.6524762400002,242.03399999999996],"fontSize":8.8},{"text":"2. While clinical contrast-enhanced","rect":[269.0034000000001,222.23399999999995,412.00710304000006,231.03399999999996],"fontSize":8.8},{"text":"CT is performed with the scan direc-","rect":[254.0034000000001,211.23399999999995,412.00725568,220.03399999999996],"fontSize":8.8},{"text":"tion commensurate with the direction","rect":[254.0034000000001,200.23399999999995,412.00390552000005,209.03399999999996],"fontSize":8.8},{"text":"of contrast material bolus propagation,","rect":[254.0034000000001,189.23399999999995,412.00722928000016,198.03399999999996],"fontSize":8.8},{"text":"one notable exception is caudocranial","rect":[254.0034000000001,178.23399999999995,412.0040392800002,187.03399999999996],"fontSize":8.8},{"text":"scanning at pulmonary CT angiography","rect":[254.0034000000001,167.23399999999995,412.00572976000024,176.03399999999996],"fontSize":8.8},{"text":"for the detection of pulmonary emboli.","rect":[254.0034000000001,156.23399999999995,410.1330000000002,165.03399999999996],"fontSize":8.8},{"text":"Determination of Contrast Material Arrival","rect":[254.000018,136.19,411.55368932,145.19],"fontSize":9},{"text":"Time: Test Bolus versus Bolus-tracking","rect":[254,125.18999999999998,399.8722294999999,134.19],"fontSize":9},{"text":"Method","rect":[254,114.18999999999998,282.008,123.18999999999998],"fontSize":9},{"text":"As discussed in the patient factors sec-","rect":[254,101.234,412.0024230400006,110.03399999999999],"fontSize":8.8},{"text":"tion, a patient’s cardiovascular circula-","rect":[254,90.234,412.00419976000063,99.03399999999999],"fontSize":8.8},{"text":"tion critically affects contrast enhance-","rect":[254,79.234,412.0012015999997,88.03399999999999],"fontSize":8.8},{"text":"ment timing and should be considered","rect":[424,684.2339999999999,582.0009592800002,693.0339999999999],"fontSize":8.8},{"text":"when","rect":[423.99999999999994,673.2339999999999,446.0439999999999,682.0339999999999],"fontSize":8.8},{"text":"determining","rect":[451.8159199999999,673.2339999999999,501.8175199999998,682.0339999999999],"fontSize":8.8},{"text":"individualized","rect":[507.5894399999997,673.2339999999999,564.4814400000002,682.0339999999999],"fontSize":8.8},{"text":"CT","rect":[570.2533600000002,673.2339999999999,582.0012280000002,682.0339999999999],"fontSize":8.8},{"text":"scan timing. For this purpose, the con-","rect":[423.99999999999994,662.2339999999999,582.0002274400005,671.0339999999999],"fontSize":8.8},{"text":"trast material bolus transit time (which","rect":[423.99999999999994,651.2339999999999,582.0039762400006,660.0339999999999],"fontSize":8.8},{"text":"is closely associated with an individual","rect":[423.99999999999994,640.2339999999999,582.0040000000007,649.0339999999999],"fontSize":8.8},{"text":"patient’s circulation time) can be mea-","rect":[423.99999999999994,629.2339999999999,582.0020799999996,638.0339999999999],"fontSize":8.8},{"text":"sured prior to diagnostic CT and fac-","rect":[424,618.2339999999999,582.0010800000001,627.0339999999999],"fontSize":8.8},{"text":"tored into the determination of scan tim-","rect":[424.00000000000006,607.2339999999999,582.0023016000008,616.0339999999999],"fontSize":8.8},{"text":"ing for diagnostic CT. Two methods, test","rect":[424.00000000000006,596.2339999999999,582.0043696000007,605.0339999999999],"fontSize":8.8},{"text":"bolus and bolus tracking, are commonly","rect":[424.00000000000006,585.2339999999999,582.0005999999998,594.0339999999999],"fontSize":8.8},{"text":"used to measure the transit time (ie, con-","rect":[424.00000000000006,574.2339999999999,581.9995886799993,583.0339999999999],"fontSize":8.8},{"text":"trast material arrival time) (Fig 13).","rect":[424.00000000000006,563.2339999999999,569.3306344000002,572.0339999999999],"fontSize":8.8},{"text":"The","rect":[438.00100000000003,552.2339999999999,453.4978000000001,561.0339999999999],"fontSize":8.8},{"text":"test-bolus","rect":[460.4146000000001,552.2339999999999,499.8298000000003,561.0339999999999],"fontSize":8.8},{"text":"method","rect":[506.7466000000004,552.2339999999999,537.5026000000003,561.0339999999999],"fontSize":8.8},{"text":"is","rect":[544.4194000000001,552.2339999999999,550.8610000000001,561.0339999999999],"fontSize":8.8},{"text":"predi-","rect":[557.7778000000001,552.2339999999999,582.00435928,561.0339999999999],"fontSize":8.8},{"text":"cated on injecting a small test bolus","rect":[424.00100000000003,541.2339999999999,582.00324,550.0339999999999],"fontSize":8.8},{"text":"(10–20 mL) of contrast medium prior","rect":[424.00100000000003,530.2339999999999,582.0006897599999,539.0339999999999],"fontSize":8.8},{"text":"to performing diagnostic CT with a full","rect":[424.00100000000003,519.2339999999999,582.0032540799998,528.0339999999999],"fontSize":8.8},{"text":"bolus of contrast medium. The test bo-","rect":[424.00100000000003,508.234,582.00305696,517.034],"fontSize":8.8},{"text":"lus and full bolus are usually injected","rect":[424.00100000000003,497.234,582.0013946400001,506.034],"fontSize":8.8},{"text":"at the same rate. Immediately follow-","rect":[424.00100000000003,486.234,582.0005427999998,495.034],"fontSize":8.8},{"text":"ing","rect":[424.00100000000003,475.234,436.0746000000001,484.034],"fontSize":8.8},{"text":"the","rect":[441.7699600000001,475.234,454.66196000000014,484.034],"fontSize":8.8},{"text":"test-bolus","rect":[460.3573200000002,475.234,499.7725200000004,484.034],"fontSize":8.8},{"text":"injection,","rect":[505.4678800000005,475.234,543.4222800000002,484.034],"fontSize":8.8},{"text":"multiple","rect":[549.1176400000002,475.234,582.0032399999999,484.034],"fontSize":8.8},{"text":"low-radiation-dose","rect":[424.00100000000003,464.234,499.3289296000004,473.034],"fontSize":8.8},{"text":"sequential","rect":[506.0644496000005,464.234,547.2836496000002,473.034],"fontSize":8.8},{"text":"images","rect":[554.0191696,464.234,582.0031695999999,473.034],"fontSize":8.8},{"text":"are acquired at a fixed scan level (com-","rect":[424.00100000000003,453.234,582.0023670399999,462.034],"fontSize":8.8},{"text":"monly at the starting level of diagnostic","rect":[424.00100000000003,442.234,582.00507744,451.034],"fontSize":8.8},{"text":"scan).","rect":[424.00100000000003,431.234,448.71140000000014,440.034],"fontSize":8.8},{"text":"A","rect":[454.4595600000002,431.234,460.81316000000015,440.034],"fontSize":8.8},{"text":"time-enhancement","rect":[466.5613200000002,431.234,542.0389200000002,440.034],"fontSize":8.8},{"text":"curve","rect":[547.7870800000002,431.234,569.81349408,440.034],"fontSize":8.8},{"text":"is","rect":[575.5616540799999,431.234,582.0032540799999,440.034],"fontSize":8.8},{"text":"obtained","rect":[424.00100000000003,420.234,459.3418000000002,429.034],"fontSize":8.8},{"text":"by","rect":[464.7969200000002,420.234,474.01038800000026,429.034],"fontSize":8.8},{"text":"measuring","rect":[479.4655080000002,420.234,521.5647080000003,429.034],"fontSize":8.8},{"text":"the","rect":[527.0198280000003,420.234,539.9118280000002,429.034],"fontSize":8.8},{"text":"enhance-","rect":[545.3669480000002,420.234,582.001348,429.034],"fontSize":8.8},{"text":"ment within a region of interest placed","rect":[424.00100000000003,409.234,582.0017,418.034],"fontSize":8.8},{"text":"over a target organ (commonly aorta","rect":[424.00100000000003,398.234,582.0004090399998,407.034],"fontSize":8.8},{"text":"or cardiac chamber). The time to peak","rect":[424.00100000000003,387.234,582.0049639199999,396.034],"fontSize":8.8},{"text":"test-bolus contrast enhancement (con-","rect":[424.00100000000003,376.234,582.00232392,385.034],"fontSize":8.8},{"text":"trast","rect":[424.00100000000003,365.234,442.7626616000001,374.034],"fontSize":8.8},{"text":"material","rect":[448.07434160000014,365.234,481.7783416000003,374.034],"fontSize":8.8},{"text":"arrival","rect":[487.09002160000034,365.234,513.3666403200004,374.034],"fontSize":8.8},{"text":"time)","rect":[518.6783203200004,365.234,540.3791203200002,374.034],"fontSize":8.8},{"text":"is","rect":[545.6908003200001,365.234,552.1324003200001,374.034],"fontSize":8.8},{"text":"deter-","rect":[557.44408032,365.234,582.0048803199999,374.034],"fontSize":8.8},{"text":"mined from the time to peak enhance-","rect":[424.00100000000003,354.234,582.0032045199998,363.034],"fontSize":8.8},{"text":"ment","rect":[424.00100000000003,343.234,444.6370000000001,352.034],"fontSize":8.8},{"text":"and","rect":[450.76620000000014,343.234,465.6118000000002,352.034],"fontSize":8.8},{"text":"is","rect":[471.7410000000002,343.234,478.1826000000002,352.034],"fontSize":8.8},{"text":"used","rect":[484.31180000000023,343.234,502.9942000000003,352.034],"fontSize":8.8},{"text":"to","rect":[509.12340000000034,343.234,517.2018000000003,352.034],"fontSize":8.8},{"text":"estimate","rect":[523.3310000000002,343.234,557.8534,352.034],"fontSize":8.8},{"text":"scan","rect":[563.9825999999999,343.234,582.0049999999999,352.034],"fontSize":8.8},{"text":"delays for full-bolus diagnostic CT. For","rect":[424.00100000000003,332.234,582.00461984,341.034],"fontSize":8.8},{"text":"a single-detector CT angiographic scan,","rect":[424.00100000000003,321.234,582.0012626399999,330.034],"fontSize":8.8},{"text":"contrast","rect":[424.00100000000003,310.234,457.2033146400002,319.034],"fontSize":8.8},{"text":"material","rect":[465.10747464000025,310.234,498.8114746400004,319.034],"fontSize":8.8},{"text":"arrival","rect":[506.7156346400005,310.234,532.9924487200003,319.034],"fontSize":8.8},{"text":"time","rect":[540.8966087200002,310.234,558.9278087200001,319.034],"fontSize":8.8},{"text":"was","rect":[566.8319687200001,310.234,582.0032804800001,319.034],"fontSize":8.8},{"text":"commonly selected to be the diagnos-","rect":[424.00100000000003,299.234,582.0006,308.034],"fontSize":8.8},{"text":"tic scan delay (113,197). Variations of","rect":[424.00100000000003,288.234,582.0003143999995,297.034],"fontSize":8.8},{"text":"this scheme were used by different in-","rect":[424.0010000000001,277.234,582.00177656,286.034],"fontSize":8.8},{"text":"vestigators (18). With fast multidetec-","rect":[424.0010000000001,266.234,582.0012799999997,275.034],"fontSize":8.8},{"text":"tor CT, a direct use of contrast mate-","rect":[424.0010200000001,255.23399999999995,581.9996739999999,264.03399999999993],"fontSize":8.8},{"text":"rial arrival time as a scan delay may","rect":[424.0010200000001,244.23399999999995,582.0017851200001,253.03399999999996],"fontSize":8.8},{"text":"result in scanning too early (198,199).","rect":[424.0010200000001,233.23399999999995,582.0011496,242.03399999999996],"fontSize":8.8},{"text":"Therefore,","rect":[424.0010200000001,222.23399999999995,466.99785872000024,231.03399999999996],"fontSize":8.8},{"text":"the","rect":[472.3940187200003,222.23399999999995,485.28601872000036,231.03399999999996],"fontSize":8.8},{"text":"scan","rect":[490.68217872000037,222.23399999999995,508.7045787200004,231.03399999999996],"fontSize":8.8},{"text":"delay","rect":[514.1007387200004,222.23399999999995,534.9920504800004,231.03399999999996],"fontSize":8.8},{"text":"should","rect":[540.3882104800002,222.23399999999995,566.90261048,231.03399999999996],"fontSize":8.8},{"text":"be","rect":[572.2987704799999,222.23399999999995,582.0051704799998,231.03399999999996],"fontSize":8.8},{"text":"calculated as the sum of contrast mate-","rect":[424.0010200000001,211.23399999999995,582.0050815999999,220.03399999999996],"fontSize":8.8},{"text":"rial arrival time plus an additional de-","rect":[424.0010200000001,200.23399999999995,582.0034201599999,209.03399999999996],"fontSize":8.8},{"text":"lay (also called diagnostic delay) such","rect":[424.0010200000001,189.23399999999995,582.0052426399999,198.03399999999996],"fontSize":8.8},{"text":"that","rect":[424.0010200000001,178.23399999999995,440.07862000000017,187.03399999999996],"fontSize":8.8},{"text":"the","rect":[445.8523000000002,178.23399999999995,458.74430000000024,187.03399999999996],"fontSize":8.8},{"text":"diagnostic","rect":[464.51798000000025,178.23399999999995,505.40278000000046,187.03399999999996],"fontSize":8.8},{"text":"CT","rect":[511.1764600000004,178.23399999999995,522.8366201600004,187.03399999999996],"fontSize":8.8},{"text":"scan","rect":[528.610300160