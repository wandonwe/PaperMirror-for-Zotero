{"pageWidth":585,"pageHeight":783,"items":[{"text":"CLINICAL STATEMENTS","rect":[565.4300000000001,631.5849999999996,576.4300000000001,713.9134],"fontSize":11},{"text":"AND GUIDELINES","rect":[554.4300000000001,640.4949999999997,565.4300000000001,702.4195000000001],"fontSize":11},{"text":"Stroke.","rect":[49.5,24.712999999999997,73.05199999999999,32.712999999999994],"fontSize":8},{"text":"2026;57:e316–e436. DOI: 10.1161/STR.0000000000000513","rect":[75.22000000000001,24.712999999999997,291.31439999999986,32.712999999999994],"fontSize":8},{"text":"August 2026","rect":[460.6727,24.712999999999997,505.3367,32.712999999999994],"fontSize":8},{"text":"e355","rect":[517.3367,24.712999999999997,535.4966999999999,32.712999999999994],"fontSize":8},{"text":"Prabhakaran et al","rect":[49,749.74,107.85600000000002,757.74],"fontSize":8},{"text":"2026 Acute Ischemic Stroke Guideline","rect":[405.328,749.74,534.9992,757.74],"fontSize":8},{"text":"ischemic changes, should reinforce the decision to","rect":[74,503.0528,283.4800000000001,513.0527999999999],"fontSize":10},{"text":"treat with IVT despite initial glucose derangements.","rect":[74,491.0528,283.5200000000001,501.0528],"fontSize":10},{"text":"7.","rect":[59.6,479.0528,65.64999999999999,489.0528],"fontSize":10},{"text":"Early ischemic changes of mild to moderate extent","rect":[74,479.0528,283.5000000000001,489.0528],"fontSize":10},{"text":"on CT scan did not modify the treatment effect of","rect":[74,467.0528,283.53000000000014,477.0528],"fontSize":10},{"text":"IVT in the NINDS tPA trial and therefore should not","rect":[74,455.0528,283.47900000000016,465.0528],"fontSize":10},{"text":"be considered a contraindication.","rect":[74,443.0528,209.37,453.0528],"fontSize":10},{"text":"21,22","rect":[209.38,447.3002,223.94916999999998,453.1302],"fontSize":5.83},{"text":"A large extent","rect":[226.0789,443.0528,283.48890000000006,453.0528],"fontSize":10},{"text":"of hypodensity, such as ASPECTS 0 to 2, was rare","rect":[73.99890000000002,431.0528,283.5239,441.0528],"fontSize":10},{"text":"(n=16) in the NINDS tPA Study. Extensive early","rect":[73.99890000000002,419.0528,283.50790000000006,429.0528],"fontSize":10},{"text":"ischemic changes or frank hypodensity (ie, severe","rect":[73.99890000000002,407.0528,283.47890000000007,417.0528],"fontSize":10},{"text":"hypoattenuation as seen with subacute stroke)","rect":[73.99890000000002,395.0528,283.4789000000002,405.0528],"fontSize":10},{"text":"should lead to revisitation of the timing of symptom","rect":[73.99890000000002,383.0528,283.50890000000015,393.0528],"fontSize":10},{"text":"onset to ensure eligibility in the 4.5-hour window.","rect":[73.99890000000002,371.0528,277.3759000000001,381.0528],"fontSize":10},{"text":"8.","rect":[59.6,359.0528,67.1,369.0528],"fontSize":10},{"text":"A multicenter RCT evaluated IV alteplase versus","rect":[74,359.0528,283.5,369.0528],"fontSize":10},{"text":"aspirin in patients with mild AIS and nondisabling","rect":[74,347.0528,283.51000000000005,357.0528],"fontSize":10},{"text":"deficits. The study showed no significant difference","rect":[74,335.0528,283.50500000000005,345.0528],"fontSize":10},{"text":"in the adjusted percentage with favorable functional","rect":[74,323.0528,283.5100000000001,333.0528],"fontSize":10},{"text":"outcome at 90 days (78% versus 81%).","rect":[326,503.0528,492.5990000000001,513.0527999999999],"fontSize":10},{"text":"25","rect":[492.6192,507.3002,499.41697999999997,513.1302000000001],"fontSize":5.83},{"text":"Another","rect":[502.1469,503.0528,535.4969,513.0527999999999],"fontSize":10},{"text":"observational, retrospective study of 319 patients","rect":[325.9969,491.0528,535.4969,501.0528],"fontSize":10},{"text":"with stroke presenting with nondisabling deficits","rect":[325.9969,479.0528,535.5068999999999,489.0528],"fontSize":10},{"text":"within 4.5 hours revealed that although alteplase","rect":[325.9969,467.0528,535.5069000000001,477.0528],"fontSize":10},{"text":"was safe, there were no associations with better","rect":[325.9969,455.0528,535.5168999999999,465.0528],"fontSize":10},{"text":"functional outcome.","rect":[325.9969,443.0528,408.3169,453.0528],"fontSize":10},{"text":"46","rect":[408.3214,447.3002,415.24161,453.1302],"fontSize":5.83},{"text":"Subsequent trials also have","rect":[418.7915,443.0528,535.4915,453.0528],"fontSize":10},{"text":"not demonstrated benefit of IVT in mild stroke pop","rect":[326.00149999999996,431.0528,531.9715000000001,441.0528],"fontSize":10},{"text":"-","rect":[531.9615,431.0528,535.5015,441.0528],"fontSize":10},{"text":"ulations but either did not define mild severity with","rect":[326.00149999999996,419.0528,535.5215000000001,429.0528],"fontSize":10},{"text":"individual","rect":[326.00149999999996,407.0528,364.33149999999995,417.0528],"fontSize":10},{"text":"considerations","rect":[370.45149999999984,407.0528,430.87149999999986,417.0528],"fontSize":10},{"text":"(ARAMIS)","rect":[436.9914999999997,407.0528,479.7204999999997,417.0528],"fontSize":10},{"text":"or","rect":[485.8404999999997,407.0528,494.18049999999965,417.0528],"fontSize":10},{"text":"explicitly","rect":[500.30049999999966,407.0528,535.4994999999997,417.0528],"fontSize":10},{"text":"beyond local clinical judgment (TEMPO-2).","rect":[326.00149999999996,395.0528,504.76949999999994,405.0528],"fontSize":10},{"text":"23–27","rect":[504.7672,399.3002,521.76165,405.1302],"fontSize":5.83},{"text":"Earlier studies have confirmed the efficacy and","rect":[338,383.0528,535.5039999999999,393.0528],"fontSize":10},{"text":"safety of DAPT in patients presenting with minor","rect":[326,371.0528,535.511,381.0528],"fontSize":10},{"text":"Table 4.","rect":[49.5,715.24,78.668,723.24],"fontSize":8},{"text":"Guidance for Determining Deficits to be Clearly Disabling at Presentation","rect":[86.6678,715.24,366.49979999999994,723.24],"fontSize":8},{"text":"43","rect":[366.496,718.63792,371.738336,723.30192],"fontSize":4.664},{"text":"Among patients with NIHSS scores 0","rect":[53.75,700.085,177.72560000000001,707.085],"fontSize":7},{"text":"–","rect":[177.72559999999996,700.085,181.80659999999995,707.085],"fontSize":7},{"text":"5 at presentation, if the observed deficits persist, would they still be able to do basic activities of daily","rect":[181.80659999999995,700.085,521.7405999999999,707.085],"fontSize":7},{"text":"living and/or return to work (if applicable)?","rect":[53.75,691.0830000000001,198.265,698.0830000000001],"fontSize":7},{"text":"Basic activities of daily living include bathing/dressing, ambulating, toileting, hygiene, and eating (BATHE","rect":[60.75,679.085,370.76250000000005,686.085],"fontSize":7},{"text":"mnemonic).","rect":[372.663,679.085,407.089,686.085],"fontSize":7},{"text":"To fully evaluate the level of deficits, the ability to ambulate and swallow independently should be assessed.","rect":[60.75,667.085,378.2174999999999,674.085],"fontSize":7},{"text":"The clinician should make this determination in consultation with the patient and available family.","rect":[60.75,655.085,344.5629,662.085],"fontSize":7},{"text":"As a guideline, while always considering individual circumstances:","rect":[53.75,641.835,275.279,648.835],"fontSize":7},{"text":"The following deficits would typically be considered clearly disabling:","rect":[53.75,628.2760000000001,272.02959999999996,635.2760000000001],"fontSize":7},{"text":"Complete hemianopsia (","rect":[60.75,616.2778000000001,133.23499999999999,623.2778000000001],"fontSize":7},{"text":"≥","rect":[133.2342,616.2778000000001,137.07719999999998,623.2778000000001],"fontSize":7},{"text":"2 on the NIHSS “vision” question)","rect":[137.07719999999998,616.2778000000001,239.03149999999994,623.2778000000001],"fontSize":7},{"text":"Severe aphasia (","rect":[60.75,604.2778000000001,110.48500000000001,611.2778000000001],"fontSize":7},{"text":"≥","rect":[110.4844,604.2778000000001,114.3274,611.2778000000001],"fontSize":7},{"text":"2 on the NIHSS “best language” question)","rect":[114.3274,604.2778000000001,241.6567,611.2778000000001],"fontSize":7},{"text":"Severe hemi-attention or extinction to","rect":[60.75,592.2778000000001,171.18900000000002,599.2778000000001],"fontSize":7},{"text":">","rect":[173.0844,592.4978,177.0864,598.4978],"fontSize":6},{"text":"1 modality (","rect":[177.0864,592.2778000000001,211.7924,599.2778000000001],"fontSize":7},{"text":"≥","rect":[211.79239999999996,592.2778000000001,215.63539999999995,599.2778000000001],"fontSize":7},{"text":"2 on the NIHSS","rect":[215.63539999999995,592.2778000000001,264.0676999999999,599.2778000000001],"fontSize":7},{"text":"“extinction and inattention” question)","rect":[60.7534,583.2758000000001,169.56840000000005,590.2758000000001],"fontSize":7},{"text":"Any weakness limiting sustained effort against gravity (","rect":[60.75,571.2778000000001,222.625,578.2778000000001],"fontSize":7},{"text":"≥","rect":[222.6228,571.2778000000001,226.4658,578.2778000000001],"fontSize":7},{"text":"2 on the NIHSS","rect":[226.4658,571.2778000000001,274.89809999999994,578.2778000000001],"fontSize":7},{"text":"“motor” questions)","rect":[60.74780000000001,562.2758000000001,116.18080000000002,569.2758000000001],"fontSize":7},{"text":"The following deficits may not be clearly disabling in an individual patient:","rect":[292.6228,628.2788000000002,525.4917999999998,635.2788000000002],"fontSize":7},{"text":"Isolated mild aphasia (but still able to communicate meaningfully)","rect":[299.625,616.2778000000001,491.978,623.2778000000001],"fontSize":7},{"text":"Isolated facial droop","rect":[299.625,604.2778000000001,359.85299999999995,611.2778000000001],"fontSize":7},{"text":"Mild cortical hand weakness (especially nondominant, NIHSS score, 0)","rect":[299.625,592.2778000000001,511.0942999999999,599.2778000000001],"fontSize":7},{"text":"Mild hemimotor loss","rect":[299.625,580.2778000000001,359.272,587.2778000000001],"fontSize":7},{"text":"Hemisensory loss","rect":[299.625,568.2778000000001,352.125,575.2778000000001],"fontSize":7},{"text":"Mild hemisensorimotor loss","rect":[299.625,556.2778000000001,380.71299999999997,563.2778000000001],"fontSize":7},{"text":"Mild hemiataxia (but can still ambulate)","rect":[299.625,544.2778000000001,414.39699999999993,551.2778000000001],"fontSize":7},{"text":"NIHSS indicates National Institutes of Health Stroke Scale.","rect":[57.5,531.1528000000001,230.3293,538.1528000000001],"fontSize":7},{"text":"Table 5.","rect":[49.5,302.04720000000003,78.108,310.04720000000003],"fontSize":8},{"text":"Management of Symptomatic Intracranial Bleeding","rect":[85.9478,302.04720000000003,277.41979999999967,310.04720000000003],"fontSize":8},{"text":"Occurring Within 24 Hours After Administration of IV Alteplase","rect":[49.5,292.04720000000003,283.29999999999967,300.04720000000003],"fontSize":8},{"text":"or Tenecteplase for Treatment of AIS in Adults","rect":[49.5,282.04720000000003,222.0759999999997,290.04720000000003],"fontSize":8},{"text":"Stop alteplase infusion or tenecteplase (if still being pushed)","rect":[53.75,266.3922,258.19899999999984,273.3922],"fontSize":7},{"text":"Emergent CBC, PT (INR), aPTT, fibrinogen level, and type and cross-match","rect":[53.75,253.14120000000003,277.06820000000005,260.1412],"fontSize":7},{"text":"Emergent nonenhanced head CT if a clinical concern exists","rect":[53.75,239.89020000000002,229.65929999999994,246.89020000000002],"fontSize":7},{"text":"Cryoprecipitate (includes factor VIII): 10 U infused over 10–30 min to","rect":[53.75,226.63920000000002,260.56219999999985,233.63920000000002],"fontSize":7},{"text":"maintain fibrinogen level of","rect":[53.75,217.6372,132.79400000000004,224.6372],"fontSize":7},{"text":"≥","rect":[134.69100000000006,217.6372,138.53400000000005,224.6372],"fontSize":7},{"text":"150 mg/dL; as a rule of thumb 10 U of","rect":[138.53400000000005,217.6372,253.46000000000004,224.6372],"fontSize":7},{"text":"cryoprecipitate increase fibrinogen level by nearly 50 mg/dL)","rect":[53.75,208.6352,233.55689999999996,215.6352],"fontSize":7},{"text":"Tranexamic acid 1000 mg IV infused over 10 min OR e-aminocaproic acid 4–5","rect":[53.75,195.3842,277.4490000000003,202.3842],"fontSize":7},{"text":"g over 1 h, followed by 1 g IV until bleeding is controlled (peak onset in 3 h)","rect":[53.75,186.38219999999998,267.26400000000035,193.38219999999998],"fontSize":7},{"text":"Potential for benefit in all patients, but particularly when blood products are","rect":[53.75,173.3832,275.881,180.3832],"fontSize":7},{"text":"contraindicated by patient/family or if cryoprecipitate is not available in a","rect":[53.75,164.38119999999998,267.2479,171.38119999999998],"fontSize":7},{"text":"timely manner","rect":[53.75,155.37919999999997,94.735,162.37919999999997],"fontSize":7},{"text":"Hematology and neurosurgery consultations as necessary","rect":[53.75,142.12819999999996,225.56290000000004,149.12819999999996],"fontSize":7},{"text":"Supportive therapy, including BP management, ICP, CPP, MAP,","rect":[53.75,128.87719999999996,242.0548999999999,135.87719999999996],"fontSize":7},{"text":"temperature, and glucose control","rect":[53.75,119.87519999999995,152.06500000000003,126.87519999999995],"fontSize":7},{"text":"Adapted with permission from Sloan et al,","rect":[57.502,106.75019999999995,182.62700000000007,113.75019999999995],"fontSize":7},{"text":"4","rect":[182.611,109.74038,184.990223,113.82138],"fontSize":4.081},{"text":"Mahaffey et al,","rect":[187.5382,106.76719999999999,231.5892,113.76719999999999],"fontSize":7},{"text":"5","rect":[231.5825,109.74038,233.961723,113.82138],"fontSize":4.081},{"text":"Goldstein et al,","rect":[236.5097,106.76719999999999,281.1277,113.76719999999999],"fontSize":7},{"text":"6","rect":[281.1208,109.74038,283.500023,113.82138],"fontSize":4.081},{"text":"French et al,","rect":[49.496999999999986,97.7652,85.246,104.7652],"fontSize":7},{"text":"7","rect":[85.2486,100.74038,87.62782299999999,104.82138],"fontSize":4.081},{"text":"Yaghi et al,","rect":[89.5248,97.76719999999999,121.03880000000001,104.76719999999999],"fontSize":7},{"text":"8–10","rect":[121.0385,100.74038,130.555392,104.82138],"fontSize":4.081},{"text":"Stone et al,","rect":[132.4522,97.76719999999999,165.27519999999998,104.76719999999999],"fontSize":7},{"text":"11","rect":[165.2747,100.74038,170.033146,104.82138],"fontSize":4.081},{"text":"and Frontera et al.","rect":[171.93009999999998,97.76719999999999,224.89209999999997,104.76719999999999],"fontSize":7},{"text":"12","rect":[224.8915,100.74038,229.649946,104.82138],"fontSize":4.081},{"text":"AIS indicates acute ischemic stroke; aPTT, activated partial thromboplastin","rect":[57.5,88.76719999999999,283.50059999999996,95.76719999999999],"fontSize":7},{"text":"time; BP, blood pressure; CBC, complete blood count; COR, class of recommen","rect":[49.499,79.7652,281.04430000000013,86.7652],"fontSize":7},{"text":"-","rect":[281.02400000000006,79.7652,283.50200000000007,86.7652],"fontSize":7},{"text":"dation; CPP, cerebral perfusion pressure; CT, computed tomography; ICP, intra","rect":[49.499000000000024,70.7632,280.9960000000002,77.7632],"fontSize":7},{"text":"-","rect":[281.02400000000006,70.7632,283.50200000000007,77.7632],"fontSize":7},{"text":"cranial pressure; INR, international normalized ratio; IV, intravenous; LOE, level of","rect":[49.499000000000024,61.7612,283.5195000000001,68.7612],"fontSize":7},{"text":"evidence; MAP, mean arterial pressure; and PT, prothrombin time.","rect":[49.499000000000024,52.7592,238.42760000000007,59.7592],"fontSize":7},{"text":"Table 6.","rect":[301.5,342.04720000000003,330.668,350.04720000000003],"fontSize":8},{"text":"Management of Orolingual Angioedema","rect":[338.6678,342.04720000000003,492.4917999999999,350.04720000000003],"fontSize":8},{"text":"Associated With IV Thrombolytic Administration for AIS in","rect":[301.4978,332.04720000000003,523.1913999999999,340.04720000000003],"fontSize":8},{"text":"Adults","rect":[301.4978,322.04720000000003,326.00179999999995,330.04720000000003],"fontSize":8},{"text":"53,54","rect":[326.0037,325.44512000000003,337.75231599999995,330.10912],"fontSize":4.664},{"text":"Maintain Airway","rect":[305.75,306.3922,359.8593,313.3922],"fontSize":7},{"text":"Endotracheal intubation may not be necessary if edema is limited to the","rect":[305.75,293.1412,516.9455999999999,300.1412],"fontSize":7},{"text":"anterior tongue and lips.","rect":[305.75,284.1392,377.50699999999995,291.1392],"fontSize":7},{"text":"Edema involving the larynx, palate, floor of mouth, or oropharynx with rapid","rect":[305.75,270.88820000000004,524.8149999999999,277.88820000000004],"fontSize":7},{"text":"progression (within 30 min) poses a higher risk of requiring intubation.","rect":[305.75,261.88620000000003,513.4315999999999,268.88620000000003],"fontSize":7},{"text":"Awake fiberoptic intubation is optimal. Nasal-tracheal intubation may be","rect":[305.75,248.63520000000005,517.0779,255.63520000000005],"fontSize":7},{"text":"required but poses risk of epistaxis after IV thrombolytic use. Cricothyroidotomy","rect":[305.75,239.63320000000004,529.8060000000008,246.63320000000004],"fontSize":7},{"text":"is rarely needed and also problematic after IV thrombolytic use.","rect":[305.75,230.63120000000004,492.13899999999995,237.63120000000004],"fontSize":7},{"text":"Discontinue IV thrombolytic infusion (if alteplase) and hold ACE inhibitors.","rect":[305.75,217.38020000000003,524.0771999999998,224.38020000000003],"fontSize":7},{"text":"Administer IV methylprednisolone 125 mg.","rect":[305.75,204.12920000000003,431.74299999999994,211.12920000000003],"fontSize":7},{"text":"Administer IV diphenhydramine 50 mg.","rect":[305.75,190.87820000000002,420.80060000000003,197.87820000000002],"fontSize":7},{"text":"Administer ranitidine 50 mg IV or famotidine 20 mg IV.","rect":[305.75,177.62720000000002,466.0268999999999,184.62720000000002],"fontSize":7},{"text":"If there is further increase in angioedema, administer 0.1% epinephrine (1","rect":[305.75,164.3762,523.506,171.3762],"fontSize":7},{"text":"mg/mL concentration) 0.3 mL intramuscularly or by nebulizer 0.5 mg/dL.","rect":[305.75,155.3742,519.5579999999999,162.3742],"fontSize":7},{"text":"Icatibant, a selective bradykinin B2 receptor antagonist, 3 mL (30 mg)","rect":[305.75,142.1232,512.9892,149.1232],"fontSize":7},{"text":"subcutaneously in abdominal area; additional injection of 30 mg may be","rect":[305.75,133.1212,518.0789,140.1212],"fontSize":7},{"text":"administered at intervals of 6 h not to exceed a total of 3 injections in 24 h;","rect":[305.75,124.11919999999998,527.4518999999999,131.11919999999998],"fontSize":7},{"text":"and plasma-derived C1 esterase inhibitor (20 IU/kg) has been successfully","rect":[305.75,115.11719999999998,527.8508999999999,122.11719999999998],"fontSize":7},{"text":"used in hereditary angioedema and ACE inhibitor-related angioedema.","rect":[305.75,106.11519999999999,513.8656,113.11519999999999],"fontSize":7},{"text":"Provide supportive care.","rect":[305.75,92.86419999999998,377.647,99.86419999999998],"fontSize":7},{"text":"Adapted with permission from Sloan et al,","rect":[309.502,79.73919999999998,434.62700000000007,86.73919999999998],"fontSize":7},{"text":"4","rect":[434.611,82.74038,436.990223,86.82138],"fontSize":4.081},{"text":"Mahaffey et al,","rect":[439.5382,79.76719999999999,483.5892,86.76719999999999],"fontSize":7},{"text":"5","rect":[483.5825,82.74038,485.961723,86.82138],"fontSize":4.081},{"text":"Goldstein et al,","rect":[488.5097,79.76719999999999,533.1277,86.76719999999999],"fontSize":7},{"text":"6","rect":[533.1208,82.74038,535.500023,86.82138],"fontSize":4.081},{"text":"French et al,","rect":[301.49699999999996,70.7652,337.246,77.7652],"fontSize":7},{"text":"7","rect":[337.2487,73.74038,339.627923,77.82138],"fontSize":4.081},{"text":"Yaghi et al,","rect":[341.52479999999997,70.76719999999999,373.0388,77.76719999999999],"fontSize":7},{"text":"8–10","rect":[373.0385,73.74038,382.555392,77.82138],"fontSize":4.081},{"text":"Stone et al,","rect":[384.4522,70.76719999999999,417.2752,77.76719999999999],"fontSize":7},{"text":"11","rect":[417.2747,73.74038,422.033146,77.82138],"fontSize":4.081},{"text":"and Frontera et al.","rect":[423.9301,70.76719999999999,476.89209999999997,77.76719999999999],"fontSize":7},{"text":"12","rect":[476.8915,73.74038,481.649946,77.82138],"fontSize":4.081},{"text":"ACE indicates angiotensin-converting enzyme; AIS, acute ischemic stroke;","rect":[309.5,61.7672,535.5160000000001,68.7672],"fontSize":7},{"text":"COR, class of recommendation; IV, intravenous; and LOE, level of evidence.","rect":[301.499,52.7652,519.2808999999999,59.7652],"fontSize":7},{"text":"Downloaded from http://ahajournals.org by on August 3, 2026","rect":[18.24,291.39599999999996,26.24,491.604],"fontSize":8}],"segments":[[551.424981,720.75,551.424981,624.75],[563.424981,612.75,604.799981,612.75],[616.799981,624.75,616.799981,720.75],[604.799981,732.75,563.424981,732.75],[49.5,731,283.5,731],[301.5,731,535.5,731],[49.5,731,317,731],[301.5,731,535.5,731],[49.625,652.625,535.375,652.625],[535.375,652.625,535.375,639.375],[535.375,639.375,49.625,639.375],[49.625,639.375,49.625,652.625],[535.375,652.75,535.375,710.75],[535.375,639.5,535.375,652.5],[49.5,710.875,288.5,710.875],[49.625,652.75,49.625,710.75],[288.5,710.875,535.5,710.875],[49.5,652.625,288.5,652.625],[49.625,639.5,49.625,652.5],[288.5,652.625,535.5,652.625],[49.5,639.375,288.5,639.375],[49.625,541.9428024,49.625,639.2498024],[49.5,541.8178024,288.5,541.8178024],[288.5,639.375,535.5,639.375],[288.5,541.9428024,288.5,639.2498024],[535.375,541.9428024,535.375,639.2498024],[288.5,541.8178024,535.5,541.8178024],[49.625,277.6819924,283.375,277.6819924],[283.375,277.6819924,283.375,263.9319924],[283.375,263.9319924,49.625,263.9319924],[49.625,263.9319924,49.625,277.6819924],[49.5,277.6821824,283.5,277.6821824],[49.625,264.0571824,49.625,277.5571824],[283.375,264.0571824,283.375,277.5571824],[49.5,263.9321824,283.5,263.932