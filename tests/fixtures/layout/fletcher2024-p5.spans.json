   "rect": [
    47.97727411443536,
    710.2272699529474,
    240.29544483531603,
    720.227273420854
   ],
   "fontSize": 10.000003467906595
  },
  {
   "text": "obstructive pulmonary disease biomarker quantifi-",
   "rect": [
    47.97727411443536,
    698.1818223433061,
    240.27272311123932,
    708.1818154074928
   ],
   "fontSize": 9.999993064186697
  },
  {
