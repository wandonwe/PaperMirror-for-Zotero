    62.989587783813484,
    582.2500019073486,
    270.74999809265137,
    590.7499961853028
   ],
   "fontSize": 8.499994277954215
  },
  {
   "text": "cardiac, vascular, thoracic, and musculoskeletal applications.",
   "rect": [
    62.989587783813484,
    572.7812461853028,
    259.47916984558105,
    581.2812500000001
