    53.968753814697266,
    654.1770820617676,
    86.32291793823242,
    666.177080154419
   ],
   "fontSize": 11.999998092651367
  },
  {
   "text": "Photon-counting CT offers improved spatial resolution and spectral",
   "rect": [
    53.968753814697266,
    642.2604160308838,
    270.6458473205567,
    650.760419845581
   ],
   "fontSize": 8.500003814697266
  },
  {
   "text": "reconstructions, yielding advantages for cardiac, vascular, thoracic, and",
   "rect": [
    53.968753814697266,
    632.7187519073486,
    278.63542556762695,
    641.2187461853027
   ],
   "fontSize": 8.499994277954102
  },
  {
   "text": "musculoskeletal CT imaging.",
   "rect": [
    53.968753814697266,
    623.2499961853027,
    147.58333206176758,
    631.75
   ],
   "fontSize": 8.500003814697266
  },
  {
   "text": "Essentials",
   "rect": [
    53.968753814697266,
    603.7812595367432,
    85.87499618530275,
    615.7812576293945
