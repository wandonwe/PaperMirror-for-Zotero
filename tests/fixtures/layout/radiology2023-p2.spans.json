    692.7291660308838,
    251.52082443237308,
    701.229169845581
   ],
   "fontSize": 8.500003814697266
  },
  {
   "text": "PCD = photon-counting detector, VMI = virtual monoener-",
   "rect": [
    53.968753814697266,
    683.1875019073487,
    251.5312385559082,
    691.6874961853027
   ],
   "fontSize": 8.499994277953988
  },
  {
   "text": "getic image, VNC = virtual noncontrast",
   "rect": [
    53.968753814697266,
    673.7187461853027,
    181.05208396911624,
    682.21875
   ],
   "fontSize": 8.500003814697266
  },
  {
   "text": "Summary",
