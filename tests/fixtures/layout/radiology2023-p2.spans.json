    53.968753814697266,
    560.2604274749756,
    59.104166030883796,
    568.7604217529297
   ],
   "fontSize": 8.499994277954102
  },
  {
   "text": "All these applications benefit from the improved spatial resolution",
   "rect": [
    62.989587783813484,
    560.2604274749756,
    278.6250019073487,
    568.7604217529297
   ],
   "fontSize": 8.499994277954102
  },
  {
   "text": "as well as noise and artifact reduction offered by PCCT and allow",
   "rect": [
    62.989587783813484,
    550.7916526794434,
    277.23958015441895,
    559.2916564941406
   ],
   "fontSize": 8.500003814697266
  },
  {
   "text": "detection of smaller structures, more subtle anomalies, and signs",
   "rect": [
    62.989587783813484,
    541.322925567627,
    273.0104160308838,
    549.8229293823242
   ],
   "fontSize": 8.500003814697266
  },
  {
   "text": "of pathologic abnormalities.",
   "rect": [
    62.989587783813484,
    531.7708377838135,
    154.66666221618652,
    540.2708320617676
   ],
   "fontSize": 8.499994277954102
  },
  {
   "text": "■",
   "rect": [
    53.968753814697266,
    519.3333320617676,
    59.104166030883796,
    527.8333358764648
   ],
   "fontSize": 8.500003814697266
  },
  {
   "text": "Spectral PCCT allows for a wide range of additional reconstruc-",
   "rect": [
    62.989587783813484,
    519.3333320617676,
    272.57290840148926,
    527.8333358764648
   ],
   "fontSize": 8.500003814697266
  },
  {
   "text": "tions from a single acquisition, thereby enabling a reduction in",
   "rect": [
    62.989587783813484,
    509.7812633514405,
    268.0833339691162,
