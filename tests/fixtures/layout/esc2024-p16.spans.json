{"source":"2024_EHJ_Ehae177_NeedReview.pdf","page":16,"pageWidth":595.276,"pageHeight":793.701,"items":[{"text":"Table 4","rect":[42.8598,731.622,75.9852,740.622],"fontSize":9},{"text":"Revised recommendations","rect":[84.9825,731.622,198.08190000000002,740.622],"fontSize":9},{"text":"Recommendations in 2019 version","rect":[42.8598,710.646,173.23097034,718.6459],"fontSize":7.9999},{"text":"Class","rect":[229.15107133,710.646,248.60682813,718.6459],"fontSize":7.9999},{"text":"a","rect":[248.598,714.217,251.7538948,719.5495],"fontSize":5.9998},{"text":"Level","rect":[264.756,710.646,284.77174979999995,718.6459],"fontSize":7.9999},{"text":"b","rect":[284.769,714.217,288.3568804,719.5495],"fontSize":5.9998},{"text":"Recommendations in 2024 version","rect":[322.753,710.646,453.18096963000005,718.6459],"fontSize":7.9999},{"text":"Class","rect":[487.55813991,710.646,507.01389671000004,718.6459],"fontSize":7.9999},{"text":"a","rect":[507.005,714.217,510.1608948,719.5495],"fontSize":5.9998},{"text":"Level","rect":[523.162,710.646,543.1777498,718.6459],"fontSize":7.9999},{"text":"b","rect":[543.175,714.217,546.7628804,719.5495],"fontSize":5.9998},{"text":"Recommendations for antianginal drugs in patients with chronic coronary syndrome—","rect":[42.8598,691.143,370.08690961000013,699.1429],"fontSize":7.9999},{"text":"Section 4","rect":[370.08690960999996,691.143,402.6073031,699.1429],"fontSize":7.9999},{"text":"Nicorandil, ranolazine, ivabradine, or trimetazidine","rect":[42.8598,676.63038141,202.19780824999998,684.6302814100001],"fontSize":7.9999},{"text":"should be considered as a second-line treatment to","rect":[42.859799999999986,664.6681309400001,206.10495941,672.6680309400001],"fontSize":7.9999},{"text":"reduce angina frequency and improve exercise","rect":[42.8598,652.64908118,190.48915460999996,660.6489811800001],"fontSize":7.9999},{"text":"tolerance in subjects who cannot tolerate, have","rect":[42.859799999999986,640.63003142,193.417918,648.62993142],"fontSize":7.9999},{"text":"contraindications to, or whose symptoms are not","rect":[42.85979999999997,628.6677809500001,200.54022897,636.6676809500001],"fontSize":7.9999},{"text":"adequately controlled by beta-blockers, CCBs, and","rect":[42.85979999999994,616.64953118,203.60419066999998,624.6494311800001],"fontSize":7.9999},{"text":"long-acting nitrates.","rect":[42.85979999999994,604.63048142,104.52702914999995,612.63038142],"fontSize":7.9999},{"text":"IIa","rect":[235.78458840999994,640.91402787,245.08047220999995,648.9139278700001],"fontSize":7.9999},{"text":"B","rect":[273.82491289999996,640.91402787,279.28884459999995,648.9139278700001],"fontSize":7.9999},{"text":"Long-acting nitrates or ranolazine should be considered","rect":[301.37816847999994,676.63038141,474.55680371999983,684.6302814100001],"fontSize":7.9999},{"text":"as add-on therapy in patients with inadequate control of","rect":[301.37816848,664.6681309400001,474.52720408999966,672.6680309400001],"fontSize":7.9999},{"text":"symptoms while on treatment with beta-blockers and/","rect":[301.37816847999994,652.64908118,474.4952044899996,660.6489811800001],"fontSize":7.9999},{"text":"or CCBs, or as part of initial treatment in properly","rect":[301.37816847999994,640.63003142,462.59935318999976,648.62993142],"fontSize":7.9999},{"text":"selected patients.","rect":[301.37816848000006,628.6677809500001,355.81588799999986,636.6676809500001],"fontSize":7.9999},{"text":"IIa","rect":[494.18935831,640.91402787,503.48524211,648.9139278700001],"fontSize":7.9999},{"text":"B","rect":[532.23048279,640.91402787,537.69441449,648.9139278700001],"fontSize":7.9999},{"text":"In selected patients, the combination of a beta-blocker","rect":[42.8598,591.6474437100001,215.90963684999997,599.6473437100001],"fontSize":7.9999},{"text":"or a CCB with second-line drugs (ranolazine, nicorandil,","rect":[42.8598,579.62919394,216.15683375999993,587.6290939400001],"fontSize":7.9999},{"text":"ivabradine, and trimetazidine) may be considered for","rect":[42.85979999999997,567.66694347,209.84891261000004,575.66684347],"fontSize":7.9999},{"text":"first-line treatment according to heart rate, blood","rect":[42.85979999999997,555.6478937100001,200.36743112999997,563.6477937100001],"fontSize":7.9999},{"text":"pressure, and tolerance.","rect":[42.85979999999997,543.62884395,118.84525016999999,551.6287439500001],"fontSize":7.9999},{"text":"IIb","rect":[235.50139195,567.89334064,245.37326855,575.89324064],"fontSize":7.9999},{"text":"B","rect":[273.82491289999996,567.89334064,279.28884459999995,575.89324064],"fontSize":7.9999},{"text":"Nicorandil or trimetazidine may be considered as","rect":[301.37816848,591.6474437100001,458.16020867999964,599.6473437100001],"fontSize":7.9999},{"text":"add-on therapy in patients with inadequate control of","rect":[301.37816848,579.62919394,471.91923668999965,587.6290939400001],"fontSize":7.9999},{"text":"symptoms while on treatment with beta-blockers and/","rect":[301.37816847999994,567.66694347,474.4952044899996,575.66684347],"fontSize":7.9999},{"text":"or CCBs, or as part of initial treatment in properly","rect":[301.37816847999994,555.6478937100001,462.59935318999976,563.6477937100001],"fontSize":7.9999},{"text":"selected patients.","rect":[301.37816848000006,543.62884395,355.81588799999986,551.6287439500001],"fontSize":7.9999},{"text":"IIb","rect":[493.90616185000005,567.89334064,503.77803845000005,575.89324064],"fontSize":7.9999},{"text":"B","rect":[532.23048279,567.89334064,537.69441449,575.89324064],"fontSize":7.9999},{"text":"Antithrombotic therapy in patients with chronic coronary syndrome—","rect":[42.8598,529.17222466,311.18364591,537.17212466],"fontSize":7.9999},{"text":"Section 4","rect":[311.18364591,529.17222466,343.76083869,537.17212466],"fontSize":7.9999},{"text":"Aspirin 75–100 mg daily is recommended in patients","rect":[42.8598,514.65880608,209.77051359,522.65870608],"fontSize":7.9999},{"text":"with a previous MI or revascularization.","rect":[42.8598,502.64055631,167.61984048,510.64045631000005],"fontSize":7.9999},{"text":"I","rect":[239.18614589,502.92375277,241.73011409,510.92365277000005],"fontSize":7.9999},{"text":"A","rect":[273.48491715,502.92375277,279.69283955,510.92365277000005],"fontSize":7.9999},{"text":"In CCS patients with a prior MI or remote PCI, aspirin","rect":[301.37816848,514.65880608,474.5144042499998,522.65870608],"fontSize":7.9999},{"text":"75–100 mg daily is recommended lifelong after an initial","rect":[301.37816848000006,502.64055631,474.5256041099998,510.64045631000005],"fontSize":7.9999},{"text":"period of DAPT.","rect":[301.37816848000006,490.62150655000005,354.60390314999995,498.6214065500001],"fontSize":7.9999},{"text":"I","rect":[497.5909157900001,502.92375277,500.1348839900001,510.92365277000005],"fontSize":7.9999},{"text":"A","rect":[531.8336877500001,502.92375277,538.0416101500001,510.92365277000005],"fontSize":7.9999},{"text":"Clopidogrel 75 mg daily is recommended as an","rect":[42.85980000000006,477.63926883000005,191.70033947000013,485.6391688300001],"fontSize":7.9999},{"text":"alternative to aspirin in patients with aspirin intolerance.","rect":[42.85980000000006,465.67701836000003,216.13443404000006,473.67691836000006],"fontSize":7.9999},{"text":"I","rect":[239.18614589000006,471.91294041000003,241.73011409000006,479.91284041000006],"fontSize":7.9999},{"text":"B","rect":[273.8249129000001,471.91294041000003,279.28884460000006,479.91284041000006],"fontSize":7.9999},{"text":"In CCS patients with a prior MI or remote PCI,","rect":[301.3781684800001,477.63926883000005,452.0354852399998,485.6391688300001],"fontSize":7.9999},{"text":"clopidogrel 75 mg daily is recommended as a safe and","rect":[301.37816848000017,465.67701836000003,472.15763370999997,473.67691836000006],"fontSize":7.9999},{"text":"effective alternative to aspirin monotherapy.","rect":[301.37816848000017,453.6579686,441.5300165599998,461.65786860000003],"fontSize":7.9999},{"text":"I","rect":[497.5909157900002,447.42204655,500.1348839900002,455.42194655000003],"fontSize":7.9999},{"text":"A","rect":[531.8336877500002,447.42204655,538.0416101500002,455.42194655000003],"fontSize":7.9999},{"text":"Clopidogrel 75 mg daily may be considered in","rect":[42.85980000000017,452.63718136000006,188.2803822200002,460.6370813600001],"fontSize":7.9999},{"text":"preference to aspirin in symptomatic and asymptomatic","rect":[42.85980000000017,440.67493089000004,216.14163395000014,448.67483089000007],"fontSize":7.9999},{"text":"patients with either PAD or a history of ischaemic","rect":[42.85980000000017,428.65668112000003,202.6266028900002,436.65658112000006],"fontSize":7.9999},{"text":"stroke or transient ischaemic attack.","rect":[42.8598000000002,416.63763136,157.70876437000018,424.63753136],"fontSize":7.9999},{"text":"IIb","rect":[235.5013919500002,434.89260317000003,245.3732685500002,442.89250317000005],"fontSize":7.9999},{"text":"B","rect":[274.3353065200002,434.89260317000003,279.7992382200002,442.89250317000005],"fontSize":7.9999},{"text":"Aspirin 75–100 mg daily may be considered in patients","rect":[42.8598000000002,403.65459365,216.1768335100002,411.65449365],"fontSize":7.9999},{"text":"without a history of MI or revascularization, but with","rect":[42.8598000000002,391.63634388,211.02409792000023,399.63624388000005],"fontSize":7.9999},{"text":"definitive evidence of CAD on imaging.","rect":[42.8598000000002,379.67409341,166.35905624000014,387.67399341000004],"fontSize":7.9999},{"text":"IIb","rect":[235.5013919500002,391.91954034,245.3732685500002,399.91944034000005],"fontSize":7.9999},{"text":"C","rect":[273.65531502000016,391.91954034,279.5112418200002,399.91944034000005],"fontSize":7.9999},{"text":"In patients","rect":[301.3781684800002,403.65459365000004,333.53056657000025,411.65449365000006],"fontSize":7.9999},{"text":"without","rect":[335.0529475400002,403.65459365000004,357.29266954000025,411.65449365000006],"fontSize":7.9999},{"text":"prior MI or revascularization but with","rect":[358.8078506000002,403.65459365000004,474.53120404000003,411.65449365000006],"fontSize":7.9999},{"text":"evidence of significant obstructive CAD, aspirin 75–100","rect":[301.37816848000017,391.6363438800001,474.5360039799997,399.6362438800001],"fontSize":7.9999},{"text":"mg daily is recommended lifelong.","rect":[301.37816848000017,379.67409341000007,408.53202904,387.6739934100001],"fontSize":7.9999},{"text":"I","rect":[497.59091579000017,391.9195403400001,500.13488399000016,399.9194403400001],"fontSize":7.9999},{"text":"B","rect":[532.2304827900001,391.9195403400001,537.6944144900001,399.9194403400001],"fontSize":7.9999},{"text":"Antithrombotic therapy post-percutaneous coronary intervention in patients with chronic coronary syndrome and no indication for","rect":[42.859800000000114,365.16067483000006,544.5871283299999,373.1605748300001],"fontSize":7.9999},{"text":"oral anticoagulation—","rect":[42.85980000000017,353.1416250700001,126.14835888000019,361.1415250700001],"fontSize":7.9999},{"text":"Section 4","rect":[126.14835888000019,353.1416250700001,158.65915249000017,361.1415250700001],"fontSize":7.9999},{"text":"Aspirin 75–100 mg daily is recommended following","rect":[42.85980000000017,338.6282064900001,205.67456479000018,346.6281064900001],"fontSize":7.9999},{"text":"stenting.","rect":[42.85980000000014,326.66595602000007,69.16347120000015,334.6658560200001],"fontSize":7.9999},{"text":"I","rect":[239.18614589000015,332.9026780600001,241.73011409000014,340.9025780600001],"fontSize":7.9999},{"text":"A","rect":[273.4849171500002,332.9026780600001,279.69283955000014,340.9025780600001],"fontSize":7.9999},{"text":"In CCS patients with no indication for oral","rect":[301.37816848000017,338.6282064900001,436.68847708000004,346.6281064900001],"fontSize":7.9999},{"text":"anticoagulation, DAPT consisting of aspirin 75–100 mg","rect":[301.3781684800002,326.66595602000007,474.5288040700001,334.6658560200001],"fontSize":7.9999},{"text":"and clopidogrel 75 mg daily for up to 6 months is","rect":[301.3781684800002,314.64770625000006,458.5954032399999,322.6476062500001],"fontSize":7.9999},{"text":"recommended as the default antithrombotic strategy","rect":[301.3781684800003,302.6286564900001,469.38006843000005,310.6285564900001],"fontSize":7.9999},{"text":"after PCI-stenting.","rect":[301.3781684800003,290.66640602000007,358.71345178000024,298.6663060200001],"fontSize":7.9999},{"text":"I","rect":[497.5909157900003,296.3927344400001,500.1348839900003,304.3926344400001],"fontSize":7.9999},{"text":"A","rect":[531.8336877500002,296.3927344400001,538.0416101500002,304.3926344400001],"fontSize":7.9999},{"text":"Clopidogrel 75 mg daily following appropriate loading","rect":[42.85980000000023,313.62691901000005,213.09127208000027,321.6268190100001],"fontSize":7.9999},{"text":"(e.g. 600 mg or","rect":[42.85980000000023,301.66466854000004,91.10319695000024,309.66456854000006],"fontSize":7.9999},{"text":">","rect":[93.37276858000024,301.66466854000004,98.85270008000025,309.66456854000006],"fontSize":7.9999},{"text":"5 days of maintenance therapy) is","rect":[98.85270008000023,301.66466854000004,205.34896886000024,309.66456854000006],"fontSize":7.9999},{"text":"recommended, in addition to aspirin, for 6 months","rect":[42.85980000000023,289.6464187700001,203.8121880700002,297.6463187700001],"fontSize":7.9999},{"text":"following coronary stenting, irrespective of stent type,","rect":[42.8598000000002,277.62736901000005,214.38245594000017,285.6272690100001],"fontSize":7.9999},{"text":"unless a shorter durations (1–3 months) is indicated due","rect":[42.8598000000002,265.66511854000004,216.16163370000018,273.66501854000006],"fontSize":7.9999},{"text":"to risk of occurrence of life-threatening bleeding.","rect":[42.8598000000002,253.64606878000006,198.05786000000023,261.6459687800001],"fontSize":7.9999},{"text":"I","rect":[239.18614589000018,283.92009035000007,241.73011409000017,291.9199903500001],"fontSize":7.9999},{"text":"A","rect":[273.93851148000016,283.92009035000007,280.14643388000013,291.9199903500001],"fontSize":7.9999},{"text":"Clopidogrel 75 mg daily following appropriate loading","rect":[42.85980000000017,240.66383106000006,213.0912720800002,248.66373106000006],"fontSize":7.9999},{"text":"(e.g. 600 mg or","rect":[42.85980000000017,228.64478130000003,88.83602529000017,236.64468130000003],"fontSize":7.9999},{"text":">","rect":[90.31120685000016,228.64478130000003,95.79113835000017,236.64468130000003],"fontSize":7.9999},{"text":"5 days of maintenance therapy) may be","rect":[95.79113835000018,228.64478130000003,216.16163370000024,236.64468130000003],"fontSize":7.9999},{"text":"considered for 1 month in patients with very high risk of","rect":[42.85980000000014,216.62573154000006,216.17843349000015,224.62563154000006],"fontSize":7.9999},{"text":"life-threatening bleeding.","rect":[42.859800000000114,204.66348107000005,120.10603441000009,212.66338107000004],"fontSize":7.9999},{"text":"IIb","rect":[235.50139195000014,222.91845288000002,245.37326855000015,230.91835288000001],"fontSize":7.9999},{"text":"C","rect":[273.6553150200001,222.91845288000002,279.5112418200001,230.91835288000001],"fontSize":7.9999},{"text":"In patients at high bleeding risk but not at high ischaemic","rect":[301.37816848000017,240.66383106000006,474.5240041299998,248.66373106000006],"fontSize":7.9999},{"text":"risk, it is recommended to discontinue DAPT 1–3","rect":[301.37816848000006,228.64478130000003,459.8145879999997,236.64468130000003],"fontSize":7.9999},{"text":"months after PCI and continue single antiplatelet","rect":[301.37816848000006,216.62573154000006,455.9842358799999,224.62563154000006],"fontSize":7.9999},{"text":"therapy.","rect":[301.3781684800001,204.66348107000005,327.0658473800001,212.66338107000004],"fontSize":7.9999},{"text":"I","rect":[497.59091579000017,222.91845288000002,500.13488399000016,230.91835288000001],"fontSize":7.9999},{"text":"A","rect":[531.8336877500001,222.91845288000002,538.0416101500001,230.91835288000001],"fontSize":7.9999},{"text":"Clopidogrel 75 mg daily following appropriate loading","rect":[42.859800000000114,191.62444406000003,213.09127208000015,199.62434406000003],"fontSize":7.9999},{"text":"(e.g. 600 mg or","rect":[42.859800000000114,179.66219359000002,89.28961962000011,187.66209359],"fontSize":7.9999},{"text":">","rect":[90.93439906000012,179.66219359000002,96.41433056000012,187.66209359],"fontSize":7.9999},{"text":"5 days of maintenance therapy) should","rect":[96.41433056000011,179.66219359000002,216.13763400000016,187.66209359],"fontSize":7.9999},{"text":"be considered for 3 months in patients with a higher risk","rect":[42.859800000000114,167.64314382999999,216.15283381000017,175.64304382999998],"fontSize":7.9999},{"text":"of life-threatening bleeding.","rect":[42.85980000000014,155.62489405999997,128.77952599000017,163.62479405999997],"fontSize":7.9999},{"text":"IIa","rect":[235.78458841000014,173.8798658699999,245.08047221000015,181.8797658699999],"fontSize":7.9999},{"text":"A","rect":[273.4849171500002,173.8798658699999,279.69283955000014,181.8797658699999],"fontSize":7.9999},{"text":"Stopping DAPT after 1–3 months from PCI-stenting","rect":[301.37816848000017,191.62444405999992,467.6144905,199.6243440599999],"fontSize":7.9999},{"text":"may be considered in patients who are not at high","rect":[301.37816848000017,179.6621935899999,461.37536849,187.6620935899999],"fontSize":7.9999},{"text":"bleeding risk nor at high risk of ischaemic events.","rect":[301.37816848000017,167.64314382999987,456.0962344799999,175.64304382999987],"fontSize":7.9999},{"text":"IIb","rect":[493.90616185000016,173.8798658699999,503.77803845000017,181.8797658699999],"fontSize":7.9999},{"text":"B","rect":[532.2304827900001,173.8798658699999,537.6944144900001,181.8797658699999],"fontSize":7.9999},{"text":"Continued","rect":[521.4586174400001,141.67786839999997,551.7622386400001,149.67776839999996],"fontSize":7.9999},{"text":"16","rect":[36.8503,760.422,48.1703,770.422],"fontSize":10},{"text":"ESC Guidelines","rect":[501.392,760.422,552.76964555,768.9219],"fontSize":8.4999},{"text":"Downloaded from https://academic.oup.com/eurheartj/advance-article/doi/10.1093/eurheartj/ehae177/7743115 by guest on 20 September 2024","rect":[573.1,650.2,1079.7959999999994,658.2],"fontSize":8}]}