		{"text": "K.K.H. (email:", "rect": [218.12501387162638, 608.0340895219281, 257.9772845181551, 615.0340867476029], "fontSize": 6.999997225674861},
		{"text": "Horst.Kelly@mayo.edu", "rect": [259.5113858309658, 608.0340895219281, 316.7386592518199, 615.0340867476029], "fontSize": 6.999997225674861},
