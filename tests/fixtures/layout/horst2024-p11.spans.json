		{"text": "patients has shown the", "rect": [47.97727411443536, 111.28409021550961, 143.62499583851206, 121.28409368341613], "fontSize": 10.000003467906524},
		{"text": "Bl64 kernel to yield im-", "rect": [47.97727411443536, 99.30682858553804, 143.63636710427022, 109.30683205344458], "fontSize": 10.000003467906538},
