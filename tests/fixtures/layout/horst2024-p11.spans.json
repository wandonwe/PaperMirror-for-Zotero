		{"text": "kernels.", "rect": [113.9545440673828, 147.2954427545721, 143.5340881347656, 157.29544622247872], "fontSize": 10.000003467906623},
		{"text": "It is acknowledged that", "rect": [47.97727411443536, 135.31818112460053, 143.64772796630857, 145.31818459250707], "fontSize": 10.000003467906538},
		{"text": "the", "rect": [47.97727411443536, 123.26135184548116, 60.181815407492884, 133.2613553133878], "fontSize": 10.000003467906652},
