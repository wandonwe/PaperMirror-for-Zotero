		{"text": "for soft tissues, except in", "rect": [47.97727411443536, 243.2613518454812, 143.62499583851206, 253.26135531338772], "fontSize": 10.000003467906538},
		{"text": "chest", "rect": [47.97727411443536, 231.2840902155095, 67.42045315829189, 241.28409368341616], "fontSize": 10.000003467906652},
