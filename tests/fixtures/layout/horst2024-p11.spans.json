		{"text": "vessels (Table 3). Bl60", "rect": [47.97727411443536, 171.3181728016246, 143.63636710427022, 181.31817626953122], "fontSize": 10.000003467906623},
		{"text": "to", "rect": [47.97727411443536, 159.27274599942297, 55.92045177112925, 169.2727494673295], "fontSize": 10.000003467906538},
