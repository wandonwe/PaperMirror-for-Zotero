		{"text": "Horst et al", "rect": [514.1022699529474, 744.715913252397, 545.7954545454545, 752.7159056230024], "fontSize": 7.999992370605469},
		{"text": "Radiology:", "rect": [47.97727411443536, 21.693195689808217, 77.53408605402166, 28.69319291548298], "fontSize": 6.999997225674765},
		{"text": "Volume 31", "rect": [79.10226995294742, 21.693195689808217, 106.59090562300247, 28.69319291548298], "fontSize": 6.999997225674765},
		{"text": "1: Number 2—May 2024", "rect": [105.04544344815339, 21.693195689808217, 173.88635808771303, 28.69319291548298], "fontSize": 6.999997225674765},
		{"text": "■", "rect": [177.2045412930575, 23.70454684170811, 179.31818181818178, 27.20454545454544], "fontSize": 3.4999986128373273},
		{"text": "radiology.rsna.org", "rect": [182.84092296253547, 21.693195689808217, 231.05682719837532, 28.69319291548298], "fontSize": 6.999997225674765},
		{"text": "5", "rect": [541.6022560813209, 21.4773080999201, 546.4204372059214, 29.477300470525602], "fontSize": 7.999992370605501},
		{"text": "low 70- and 90-kV mode", "rect": [47.97727411443536, 722.2045419866387, 144.1363594748757, 732.2045454545454], "fontSize": 10.000003467906708},
		{"text": "provides", "rect": [47.97727411443536, 710.2272699529474, 80.23863705721767, 720.227273420854], "fontSize": 10.000003467906595},
		{"text": "basic", "rect": [88.06819568980823, 710.2272699529474, 106.94319638338953, 720.227273420854], "fontSize": 10.000003467906595},
		{"text": "spectral", "rect": [114.72726995294742, 710.2272699529474, 143.94318320534444, 720.227273420854], "fontSize": 10.000003467906595},
		{"text": "imaging", "rect": [47.97727411443536, 698.1818223433061, 79.25000277432527, 708.1818154074928], "fontSize": 9.999993064186697},
		{"text": "features,", "rect": [86.81816794655539, 698.1818223433061, 118.88635461980644, 708.1818154074928], "fontSize": 9.999993064186697},
		{"text": "such", "rect": [126.4318292791193, 698.1818223433061, 143.96591533314097, 708.1818154074928], "fontSize": 9.999993064186697},
		{"text": "as the ability to create", "rect": [47.97727411443536, 686.2045503096147, 144.05682303688738, 696.2045433738014], "fontSize": 9.999993064186697},
		{"text": "VMIs, but does not allow", "rect": [47.97727411443536, 674.2272678722035, 144.10227688876063, 684.22727134011], "fontSize": 10.000003467906481},
		{"text": "for the creation of VNC", "rect": [47.97727411443536, 662.249995838512, 144.1363594748757, 672.2499993064185], "fontSize": 10.000003467906595},
		{"text": "images or iodine maps.", "rect": [47.97727411443536, 650.1931769631125, 144.07954476096413, 660.1931804310191], "fontSize": 10.000003467906595},
		{"text": "The", "rect": [47.97727411443536, 638.215904929421, 62.62500416148792, 648.2159083973277], "fontSize": 10.000003467906708},
		{"text": "higher", "rect": [70.65908952192825, 638.215904929421, 95.32954476096411, 648.2159083973277], "fontSize": 10.000003467906708},
		{"text": "120-", "rect": [103.27273282137783, 638.215904929421, 121.52274045077235, 648.2159083973277], "fontSize": 10.000003467906708},
		{"text": "and", "rect": [129.51137195933947, 638.215904929421, 143.92046148126772, 648.2159083973277], "fontSize": 10.000003467906708},
		{"text": "140-kV", "rect": [47.97727411443536, 626.2386328957297, 77.82954129305752, 636.2386363636363], "fontSize": 10.000003467906595},
		{"text": "mode", "rect": [83.852275501598, 626.2386328957297, 105.68181818181816, 636.2386363636363], "fontSize": 10.000003467906595},
		{"text": "provides", "rect": [111.70453158291902, 626.2386328957297, 143.96589452570134, 636.2386363636363], "fontSize": 10.000003467906595},
		{"text": "additional spectral sepa-", "rect": [47.97727411443536, 614.2727321277964, 144.09090562300244, 624.2727251919832], "fontSize": 9.99999306418681},
		{"text": "ration, permitting more", "rect": [47.97727411443536, 602.215913252397, 144.10227688876063, 612.2159063165838], "fontSize": 9.99999306418681},
		{"text": "spectral", "rect": [47.97727411443536, 590.2386516224254, 77.19317696311255, 600.2386446866121], "fontSize": 9.999993064186697},
		{"text": "reformat", "rect": [83.72726440429686, 590.2386516224254, 117.04544760964131, 600.2386446866121], "fontSize": 9.999993064186697},
		{"text": "capa-", "rect": [123.57954545454544, 590.2386516224254, 143.98863705721766, 600.2386446866121], "fontSize": 9.999993064186697},
		{"text": "bilities (ie, VNC, iodine", "rect": [47.97727411443536, 578.2613587812943, 144.09090562300244, 588.2613622492008], "fontSize": 10.000003467906481},
		{"text": "map, and virtual noncal-", "rect": [47.97727411443536, 566.2045607133344, 144.11363775079897, 576.2045537775213], "fontSize": 9.99999306418681},
		{"text": "cium", "rect": [47.97727411443536, 554.2386391379615, 67.56818597966974, 564.2386322021483], "fontSize": 9.99999306418681},
		{"text": "images).", "rect": [74.52271894975141, 554.2386391379615, 106.42044067382811, 564.2386322021483], "fontSize": 9.99999306418681},
		{"text": "Spectral", "rect": [113.36363358931106, 554.2386391379615, 144.01135878129438, 564.2386322021483], "fontSize": 9.99999306418681},
		{"text": "shaping with tin (Sn140/", "rect": [47.97727411443536, 542.2613567005503, 144.09090562300244, 552.2613497647371], "fontSize": 9.99999306418681},
		{"text": "Sn100) filters out lower-", "rect": [47.97727411443536, 530.2840950705788, 144.09090562300244, 540.2840881347656], "fontSize": 9.99999306418681},
		{"text": "energy photons that do", "rect": [47.97727411443536, 518.2272657914594, 144.09090562300244, 528.2272588556463], "fontSize": 9.99999306418681},
		{"text": "not contribute to image", "rect": [47.97727411443536, 506.2500041614878, 144.07954476096413, 516.2499972256746], "fontSize": 9.99999306418681},
		{"text": "signal,", "rect": [47.97727411443536, 494.2727425315163, 72.53408952192827, 504.272735595703], "fontSize": 9.999993064186697},
		{"text": "which", "rect": [82.1818126331676, 494.2727425315163, 105.70453990589488, 504.272735595703], "fontSize": 9.999993064186697},
		{"text": "reduces", "rect": [115.31818043101916, 494.2727425315163, 143.96590492942113, 504.272735595703], "fontSize": 9.999993064186697},
		{"text": "radiation", "rect": [47.97727411443536, 482.2954496903852, 82.85226995294742, 492.29545315829176], "fontSize": 10.000003467906538},
		{"text": "dose", "rect": [88.954551003196, 482.2954496903852, 106.12500624223186, 492.29545315829176], "fontSize": 10.000003467906538},
		{"text": "and", "rect": [112.29546286843038, 482.2954496903852, 126.70455239035864, 492.29545315829176], "fontSize": 10.000003467906538},
		{"text": "in-", "rect": [132.89774114435366, 482.2954496903852, 143.94319360906425, 492.29545315829176], "fontSize": 10.000003467906538},
		{"text": "creases the mean spectral", "rect": [47.97727411443536, 470.25001248446375, 144.09090562300244, 480.2500055486505], "fontSize": 9.999993064186754},
		{"text": "energy", "rect": [47.97727411443536, 458.2727300470525, 73.36364052512428, 468.27272311123926], "fontSize": 9.999993064186754},
		{"text": "of", "rect": [79.63635531338778, 458.2727300470525, 87.42043928666546, 468.27272311123926], "fontSize": 9.999993064186754},
		{"text": "the", "rect": [93.64773143421517, 458.2727300470525, 105.8522727272727, 468.27272311123926], "fontSize": 9.999993064186754},
		{"text": "incident", "rect": [112.17045177112924, 458.2727300470525, 143.98863705721766, 468.27272311123926], "fontSize": 9.999993064186754},
		{"text": "beam", "rect": [47.97727411443536, 446.2954476096413, 68.88636849143288, 456.29544067382807], "fontSize": 9.999993064186754},
		{"text": "in", "rect": [79.39773559570311, 446.2954476096413, 87.22728382457385, 456.29544067382807], "fontSize": 9.999993064186754},
		{"text": "noncontrast", "rect": [97.73864052512428, 446.2954476096413, 144.03409090909088, 456.29544067382807], "fontSize": 9.999993064186754},
		{"text": "examinations", "rect": [47.97727411443536, 434.3181859796697, 99.09090562300247, 444.3181790438565], "fontSize": 9.99999306418681},
		{"text": "thus", "rect": [106.59089521928266, 434.3181859796697, 123.18181124600495, 444.3181790438565], "fontSize": 9.99999306418681},
		{"text": "op-", "rect": [130.76135808771303, 434.3181859796697, 143.9204406738281, 444.3181790438565], "fontSize": 9.99999306418681},
		{"text": "timizing", "rect": [47.97727411443536, 422.2613567005504, 80.14772935347122, 432.2613497647372], "fontSize": 9.99999306418681},
		{"text": "image", "rect": [87.22728382457385, 422.2613567005504, 110.17046148126774, 432.2613497647372], "fontSize": 9.99999306418681},
		{"text": "quality", "rect": [117.2840881347656, 422.2613567005504, 143.94318320534444, 432.2613497647372], "fontSize": 9.99999306418681},
		{"text": "(15,21–24).", "rect": [47.97727411443536, 410.29544552889735, 94.50000416148791, 420.29544899680394], "fontSize": 10.000003467906595},
		{"text": "In", "rect": [59.97726787220347, 398.31819430264557, 68.51136641068891, 408.3181873668323], "fontSize": 9.999993064186754},
		{"text": "our", "rect": [78.09090354225852, 398.31819430264557, 91.42044067382811, 408.3181873668323], "fontSize": 9.999993064186754},
		{"text": "experience,", "rect": [101.06818459250708, 398.31819430264557, 144.04545177112922, 408.3181873668323], "fontSize": 9.999993064186754},
		{"text": "most EID CT protocols", "rect": [47.97727411443536, 386.34093267267394, 144.10227688876063, 396.34092573686075], "fontSize": 9.99999306418681},
		{"text": "in pediatric patients are", "rect": [47.97727411443536, 374.28410339355463, 144.09090562300244, 384.28409645774144], "fontSize": 9.99999306418681},
		{"text": "performed at 70, 80, or", "rect": [47.97727411443536, 362.30684176358307, 144.14773074063385, 372.3068348277698], "fontSize": 9.999993064186754},
		{"text": "100", "rect": [47.97727411443536, 350.3295385187322, 63.011367104270235, 360.329531582919], "fontSize": 9.99999306418681},
		{"text": "kV,", "rect": [70.3636446866122, 350.3295385187322, 83.27273628928444, 360.329531582919], "fontSize": 9.99999306418681},
		{"text": "varying", "rect": [90.68181818181817, 350.3295385187322, 119.20454198663884, 360.329531582919], "fontSize": 9.99999306418681},
		{"text": "with", "rect": [126.54545870694245, 350.3295385187322, 143.96590492942113, 360.329531582919], "fontSize": 9.99999306418681},
		{"text": "patient size. We prefer-", "rect": [47.97727411443536, 338.3522768887606, 144.10227688876063, 348.3522699529474], "fontSize": 9.999993064186754},
		{"text": "entially use 120 kV over", "rect": [47.97727411443536, 326.30679806795985, 144.09090562300244, 336.30680153586644], "fontSize": 10.000003467906595},
		{"text": "70 or 90 kV because the", "rect": [47.97727411443536, 314.3295364379882, 144.11363775079897, 324.3295399058948], "fontSize": 10.000003467906595},
		{"text": "increased contrast of re-", "rect": [47.97727411443536, 302.3522852117365, 144.11363775079897, 312.35227827592325], "fontSize": 9.999993064186754},
		{"text": "duced tube potentials is", "rect": [47.97727411443536, 290.3750235817648, 144.07954476096413, 300.37501664595163], "fontSize": 9.99999306418681},
		{"text": "realized with low-energy VMIs. Moreover, the greater spectral", "rect": [47.97727411443536, 278.31819430264557, 288.46591602672225, 288.3181873668324], "fontSize": 9.99999306418681},
		{"text": "separation at 120 kV takes full advantage of the full array of", "rect": [47.97727411443536, 266.34093267267394, 288.4318334406072, 276.34092573686075], "fontSize": 9.99999306418681},
		{"text": "spectral reformat capabilities of the scanner. A tube potential", "rect": [47.97727411443536, 254.37497988614163, 288.4318334406072, 264.37498335404825], "fontSize": 10.000003467906623},
		{"text": "of 120 kV also allows for faster scanning speed and more tube", "rect": [47.97727411443536, 242.39771825617007, 288.46591602672225, 252.39772172407672], "fontSize": 10.000003467906652},
		{"text": "power capacity to accommodate larger pediatric patients. These", "rect": [47.97727411443536, 230.3408889770507, 288.44319430264557, 240.34089244495735], "fontSize": 10.000003467906652},
		{"text": "advantages of the PCD detector permit protocol standardiza-", "rect": [47.97727411443536, 218.36362734707916, 288.46591602672225, 228.36363081498578], "fontSize": 10.000003467906623},
		{"text": "tion across the broad range of pediatric body sizes, yielding", "rect": [47.97727411443536, 206.3863761208274, 288.4318334406072, 216.38636918501422], "fontSize": 9.99999306418681},
		{"text": "greater operational simplicity and consistency.", "rect": [47.97727411443536, 194.40911449085576, 225.44317765669385, 204.40910755504257], "fontSize": 9.99999306418681},
		{"text": "Multienergy Scanning Mode: 120 kV versus 140 kV", "rect": [47.97727411443536, 170.69320054487747, 251.43181540749288, 180.69320401278412], "fontSize": 10.000003467906652},
		{"text": "Some studies have highlighted improved spectral separation", "rect": [47.97727411443536, 158.40907079523254, 288.4090909090909, 168.4090742631392], "fontSize": 10.000003467906652},
		{"text": "of multienergy imaging at 140 kV over 120 kV; however, the", "rect": [47.97727411443536, 146.43180916526097, 288.4090909090909, 156.43181263316762], "fontSize": 10.000003467906652},
		{"text": "effect of this increased spectral separation has generally been", "rect": [47.97727411443536, 134.37497988614172, 288.4204517711292, 144.37498335404825], "fontSize": 10.000003467906538},
		{"text": "limited to larger patients such as those with higher body mass", "rect": [47.97727411443536, 122.39771825617005, 288.3409049294211, 132.3977217240767], "fontSize": 10.000003467906637},
		{"text": "index (25,26). Thus, the theoretical increase in spectral separa-", "rect": [47.97727411443536, 110.4318174882368, 288.44319430264557, 120.43182095614344], "fontSize": 10.000003467906637},
		{"text": "tion may not be worth the reduction of contrast at 140 kV. In", "rect": [47.97727411443536, 98.37498820911755, 288.4204517711292, 108.37499167702418], "fontSize": 10.000003467906637},
		{"text": "fact, pediatric phantom studies have shown slight increases in", "rect": [47.97727411443536, 86.39772657914598, 288.3749875155362, 96.39773004705252], "fontSize": 10.000003467906538},
		{"text": "noise at 140 kV compared with 120 kV in 15-, 30-, 35-, and", "rect": [47.97727411443536, 74.42042333429511, 288.44319430264557, 84.42042680220175], "fontSize": 10.000003467906637},
		{"text": "40-cm phantoms, although a slight decrease in noise was seen", "rect": [47.97727411443536, 62.44316170432355, 288.4204517711292, 72.44316517223008], "fontSize": 10.00000346790653},
		{"text": "in 45-cm phantoms at 140 kV compared with 120 kV (27).", "rect": [47.97727411443536, 50.38633242520418, 279.53409368341613, 60.38633589311082], "fontSize": 10.000003467906637},
		{"text": "Spectral Beam Shaping: Added Tin Filter", "rect": [305.9545482288707, 276.8295364379882, 466.37499722567463, 286.8295399058949], "fontSize": 10.000003467906652},
		{"text": "We use 100Sn spectral shaping in applications where spec-", "rect": [305.9545482288707, 261.48862734707916, 546.3636224920099, 271.48863081498575], "fontSize": 10.000003467906595},
		{"text": "tral information is not required such as low-dose noncon-", "rect": [305.9545482288707, 249.52272657914588, 546.3750041614878, 259.5227300470525], "fontSize": 10.000003467906623},
		{"text": "trast examinations, some of which can be performed at", "rect": [305.9545482288707, 237.54546494917432, 546.4204684170809, 247.54546841708097], "fontSize": 10.000003467906652},
		{"text": "radiation doses that approach those of radiography (eg, for", "rect": [305.9545482288707, 225.48863567005506, 546.4204684170809, 235.4886391379616], "fontSize": 10.000003467906538},
		{"text": "pediatric cystic fibrosis) (16) (Fig 3). For larger pediatric pa-", "rect": [305.9545482288707, 213.5113740400834, 546.3750041614878, 223.51137750799003], "fontSize": 10.000003467906623},
		{"text": "tients, 140Sn can be used if 100Sn cannot provide sufficient", "rect": [305.9545482288707, 201.53407079523262, 546.3750041614878, 211.53407426313916], "fontSize": 10.000003467906538},
		{"text": "radiation dose.", "rect": [305.9545482288707, 189.55680916526097, 365.1136363636363, 199.5568126331676], "fontSize": 10.000003467906623},
		{"text": "Automatic Exposure Control", "rect": [305.9545482288707, 161.8522963090376, 417.36363497647363, 171.8522893732244], "fontSize": 9.99999306418681},
		{"text": "Similar to EID scanners from the same manufacturer, the auto-", "rect": [305.9545482288707, 146.590913252397, 546.4318292791193, 156.5909063165838], "fontSize": 9.99999306418681},
		{"text": "matic exposure control (AEC) system on the PCD CT scanner", "rect": [305.9545482288707, 134.53408397327775, 546.4090867476028, 144.53407703746444], "fontSize": 9.999993064186697},
		{"text": "includes both automatic tube current modulation and auto-", "rect": [305.9545482288707, 122.55682234330607, 546.3863650235262, 132.55681540749288], "fontSize": 9.99999306418681},
		{"text": "matic tube potential selection. The applied tube current adjusts", "rect": [305.9545482288707, 110.57956071333452, 546.3750041614878, 120.57955377752131], "fontSize": 9.999993064186796},
		{"text": "to maintain similar image quality across different anatomies", "rect": [305.9545482288707, 98.6022470647638, 546.3181790438564, 108.60225053267044], "fontSize": 10.000003467906637},
		{"text": "despite variable patient anatomy (ie, thicknesses) at different", "rect": [305.9545482288707, 86.556830666282, 546.3522616299715, 96.55682373046871], "fontSize": 9.999993064186711},
		{"text": "view angles during scanning (28). This can result in an over-", "rect": [305.9545482288707, 74.57956903631033, 546.4318292791193, 84.57956210049714], "fontSize": 9.99999306418681},
		{"text": "all radiation dose reduction, while maintaining similar image", "rect": [305.9545482288707, 62.602307406338774, 546.3409007679331, 72.60230047052558], "fontSize": 9.999993064186803},
		{"text": "quality (28–30).", "rect": [305.9545482288707, 50.54547812721952, 369.11363775079894, 60.54547119140622], "fontSize": 9.999993064186704},
		{"text": "Figure 6:", "rect": [161.88637473366472, 364.9318043101917, 193.67046702991829, 372.931807084517], "fontSize": 8.00000277432531},
		{"text": "Images in a 7-year-old male child (same patient as in Figure 5) with shortness of breath. Noncontrast chest photon-", "rect": [201.55681956898079, 364.9318043101917, 533.7386460737748, 372.931807084517], "fontSize": 8.00000277432531},
		{"text": "counting detector scans (Flash + ultrahigh resolution, 120 × 0.2, 120 kV; automatic exposure control image quality index [vendor", "rect": [161.88637473366472, 354.92042957652694, 530.9431873668323, 362.9204323508522], "fontSize": 8.000002774325253},
		{"text": "term: Care keV IQ] level 29; pitch, 3.2) with reconstruction performed at 0.2 mm in", "rect": [161.88637473366472, 344.89773559570307, 399.7841158780184, 352.8977383700283], "fontSize": 8.000002774325253},
		{"text": "(A)", "rect": [401.6817959872158, 344.89773559570307, 412.8408882834694, 352.8977383700283], "fontSize": 8.000002774325253},
		{"text": "Bl60 kernel and QIR1,", "rect": [414.5681762695312, 344.89773559570307, 479.88634976473713, 352.8977383700283], "fontSize": 8.000002774325253},
		{"text": "(B)", "rect": [481.61365855823857, 344.89773559570307, 492.0341075550425, 352.8977383700283], "fontSize": 8.000002774325253},
