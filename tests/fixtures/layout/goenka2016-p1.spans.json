"fontSize": 6.9977760314941975}, {"text": "goenka.ajit@mayo.edu", "rect": [128.82812363760812, 89.01560047694612, 187.9352637699672, 96.01337650844032], "fontSize": 6.9977760314941975}, {"text": ").", "rect": [189.05132838657923, 89.01560047694612, 192.3995426722935, 96.01337650844032], "fontSize": 6.9977760314941975}, {"text": "Supported by an institutional grant from Siemens Health-", "rect": [50.01116139548165, 73.04464490073063, 196.8191998345511, 80.04241071428568], "fontSize": 6.9977658135550485}, {"text": "care, Forchheim, Germany.", "rect": [50.01116139548165, 63.491117068699374, 118.92857551574707, 70.48888288225442], "fontSize": 6.997765813555041}, {"text": "q", "rect": [50.01116139548165, 47.30800642286022, 52.54463808877127, 51.86157989501955], "fontSize": 4.553573472159336}, {"text": "RSNA, 2016", "rect": [54.642861230032786, 44.55130863189697, 85.58035918644497, 51.549074445452014], "fontSize": 6.997765813555041}, {"text": "Purpose:", "rect": [251.95312499999997, 476.8504457473754, 284.8102671759469, 485.84598214285705], "fontSize": 8.995536395481679}, {"text": "To assess image noise, contrast-to-noise ratio (CNR) and de-", "rect": [302.979918888637, 477.6428571428571, 533.9843886239188, 485.84598214285705], "fontSize": 8.203124999999943}, {"text": "tectability of low-contrast, low-attenuation liver lesions in a", "rect": [302.979918888637, 467.0736661638532, 533.9620726449148, 475.2767911638532], "fontSize": 8.203125}, {"text": "semianthropomorphic phantom by using either a discrete cir-", "rect": [302.979918888637, 456.59373910086487, 533.9843886239188, 464.796864100865], "fontSize": 8.203125000000114}, {"text": "cuit (DC) detector and filtered back projection (FBP) or an", "rect": [302.979918888637, 446.1026744842529, 533.9620726449148, 454.3057994842529], "fontSize": 8.203125}, {"text": "integrated circuit (IC) detector and iterative reconstruction (IR)", "rect": [302.979918888637, 435.6116098676408, 534.0067046029227, 443.8147348676409], "fontSize": 8.203125000000057}, {"text": "with changes in radiation exposure and phantom size.", "rect": [302.979918888637, 425.12052481515065, 500.6026881081717, 433.3236498151506], "fontSize": 8.203124999999943}, {"text": "Materials and", "rect": [233.48215648106165, 402.9553728103637, 284.75447722843717, 411.9509092058454], "fontSize": 8.995536395481679}, {"text": "Methods:", "rect": [250.4687445504325, 391.91742365700856, 284.8214149475097, 400.9129600524902], "fontSize": 8.995536395481622}, {"text": "An anthropomorphic phantom without or with a 5-cm-thick", "rect": [302.979918888637, 403.5915314810616, 533.9843886239188, 411.7946564810616], "fontSize": 8.203125}, {"text": "fat-mimicking ring (widths, 30 and 40 cm) containing liver", "rect": [302.979918888637, 393.1004464285714, 533.9843886239188, 401.3035714285714], "fontSize": 8.203125}, {"text": "inserts with four spherical lesions was scanned with five expo-", "rect": [302.979918888637, 382.60936137608115, 533.9843886239188, 390.81248637608115], "fontSize": 8.203125}, {"text": "sure settings on each of two computed tomography scanners,", "rect": [302.979918888637, 372.04017039707725, 533.9843886239188, 380.24329539707725], "fontSize": 8.203125}, {"text": "one equipped with a DC detector and the other with an IC", "rect": [302.979918888637, 361.5602842058454, 533.9843886239188, 369.7634092058454], "fontSize": 8.203125}, {"text": "detector. Images from the DC and IC detector scanners were", "rect": [302.979918888637, 351.06919915335516, 533.9620726449148, 359.27232415335516], "fontSize": 8.203125}, {"text": "reconstructed with FBP and IR, respectively. Image noise and", "rect": [302.979918888637, 340.57811410086487, 533.9620726449148, 348.7812391008649], "fontSize": 8.203125000000057}, {"text": "lesion CNR were measured. Four radiologists evaluated lesion", "rect": [302.979918888637, 330.0870699201311, 533.9955466134207, 338.2901949201311], "fontSize": 8.203125}, {"text": "presence", "rect": [302.979918888637, 319.5959848676408, 336.2276928765433, 327.7991098676409], "fontSize": 8.203125000000057}, {"text": "on", "rect": [341.1718777247837, 319.5959848676408, 350.4352671759469, 327.7991098676409], "fontSize": 8.203125000000057}, {"text": "a", "rect": [355.3683144705636, 319.5959848676408, 359.00670800890236, 327.7991098676409], "fontSize": 8.203125000000057}, {"text": "five-point", "rect": [364.5759037562779, 319.5959848676408, 398.90625817435125, 327.7991098676409], "fontSize": 8.203125000000057}, {"text": "diagnostic", "rect": [403.83927481515065, 319.5959848676408, 441.1941902978079, 327.7991098676409], "fontSize": 8.203125000000057}, {"text": "confidence", "rect": [446.12723759242465, 319.5959848676408, 485.6138501848493, 327.7991098676409], "fontSize": 8.203125000000057}, {"text": "scale.", "rect": [490.55802481515065, 319.5959848676408, 511.20534283774236, 327.7991098676409], "fontSize": 8.203125000000057}, {"text": "Data", "rect": [516.160706111363, 319.5959848676408, 533.9397260120937, 327.7991098676409], "fontSize": 8.203125000000057}, {"text": "analyses", "rect": [302.979918888637, 309.1048998151506, 333.80581651415145, 317.30802481515065], "fontSize": 8.203125000000057}, {"text": "included", "rect": [339.5647185189383, 309.1048998151506, 370.84820611136297, 317.30802481515065], "fontSize": 8.203125000000057}, {"text": "receiver", "rect": [376.6294751848493, 309.1048998151506, 406.54019287654324, 317.30802481515065], "fontSize": 8.203125000000057}, {"text": "operating", "rect": [412.3325892857143, 309.1048998151506, 447.56696564810613, 317.30802481515065], "fontSize": 8.203125000000057}, {"text": "characteristic", "rect": [453.3705302647182, 309.1048998151506, 503.77231325422014, 317.30802481515065], "fontSize": 8.203125000000057}, {"text": "(ROC)", "rect": [509.5647403172084, 309.1048998151506, 533.9955466134207, 317.30802481515065], "fontSize": 8.203125000000057}, {"text": "curve analysis and noninferiority analysis.", "rect": [302.979918888637, 298.6138556344168, 459.2187574931553, 306.8169806344168], "fontSize": 8.203125}, {"text": "Results:", "rect": [254.98883383614674, 276.3816739491054, 284.8548991339547, 285.37721034458707], "fontSize": 8.995536395481679}, {"text": "The combination of IC and IR significantly reduced image noise", "rect": [302.979918888637, 277.0066746303013, 533.9843886239188, 285.2097996303013], "fontSize": 8.203125}, {"text": "(", "rect": [302.979918888637, 266.5267884390695, 305.7143007005964, 274.72991343906943], "fontSize": 8.203124999999943}, {"text": "P", "rect": [306.12724849155967, 266.5267884390695, 310.6919799532209, 274.72991343906943], "fontSize": 8.203124999999943}, {"text": ",", "rect": [314.33037349155967, 266.44868251255576, 319.2745787756784, 274.6518075125557], "fontSize": 8.203124999999943}, {"text": ".001) (with the greatest reduction in the 40-cm phantom", "rect": [324.3638174874442, 266.5267884390695, 533.9955057416643, 274.72991343906943], "fontSize": 8.203124999999943}, {"text": "and at lower exposures) and improved lesion CNR (", "rect": [302.979918888637, 256.0357033865792, 495.04464013235906, 264.2388283865792], "fontSize": 8.203125}, {"text": "P", "rect": [494.88838740757535, 256.0357033865792, 499.4531188692365, 264.2388283865792], "fontSize": 8.203125}, {"text": ",", "rect": [502.96873365129744, 255.8794506617955, 507.912928717477, 264.0825756617955], "fontSize": 8.203125}, {"text": ".001).", "rect": [512.9464285714286, 256.0357033865792, 533.9955363954816, 264.2388283865792], "fontSize": 8.203125}, {"text": "There was no significant difference in area under the ROC curve", "rect": [302.979918888637, 245.54465920584542, 533.9732306344167, 253.74778420584542], "fontSize": 8.203125}, {"text": "between detector-reconstruction combinations at fixed exposure", "rect": [302.979918888637, 235.05357415335516, 533.9732306344167, 243.25669915335513], "fontSize": 8.203124999999972}, {"text": "for either phantom. Reader accuracy with IC-IR was noninferior", "rect": [302.979918888637, 224.5624891008649, 533.9620726449148, 232.76561410086487], "fontSize": 8.203124999999972}, {"text": "at 50% (100 mAs [effective]) and 25% (300 mAs [effective])", "rect": [302.979918888637, 214.0714449201311, 533.9843886239188, 222.27456992013109], "fontSize": 8.203124999999972}, {"text": "exposure reduction for the 30- and 40-cm phantoms, respectively", "rect": [302.979918888637, 203.58035986764085, 533.9732306344167, 211.78348486764082], "fontSize": 8.203124999999972}, {"text": "(adjusted", "rect": [302.979918888637, 193.08927481515067, 336.29465103149414, 201.29239981515067], "fontSize": 8.203125}, {"text": "P", "rect": [338.2031168256487, 193.08927481515067, 342.7678482873099, 201.29239981515067], "fontSize": 8.203125}, {"text": ",", "rect": [345.0892720903669, 192.93302209036688, 350.03346715654646, 201.13614709036685], "fontSize": 8.203124999999972}, {"text": ".001 and .04 respectively). IC-IR improved readers\u2019", "rect": [353.82810320172985, 193.08927481515067, 533.9397157941545, 201.29239981515067], "fontSize": 8.203125}, {"text": "confidence in the presence of a lesion (", "rect": [302.979918888637, 182.60938862391876, 444.2522457667759, 190.81251362391873], "fontSize": 8.203124999999972}, {"text": "P", "rect": [444.0513610839844, 182.60938862391876, 448.61609254564553, 190.81251362391873], "fontSize": 8.203124999999972}, {"text": "= .029) independent of", "rect": [451.5290124075753, 182.60938862391876, 533.9620419910975, 190.81251362391873], "fontSize": 8.203124999999972}, {"text": "phantom size or exposure level.", "rect": [302.979918888637, 172.11830357142858, 416.4955411638532, 180.32142857142858], "fontSize": 8.203125}, {"text": "Conclusion:", "rect": [241.61829267229353, 149.87501498631065, 284.77677277156283, 158.87054116385318], "fontSize": 8.99552617754253}, {"text": "IC-IR improved objective image quality and lesion detection", "rect": [302.979918888637, 150.51116343906946, 533.9955466134207, 158.71428843906946], "fontSize": 8.203125}, {"text": "confidence but did not result in superior diagnostic accuracy", "rect": [302.979918888637, 140.0200783865792, 533.9955466134207, 148.22320338657917], "fontSize": 8.203124999999972}, {"text": "when compared with DC-FBP. Moderate exposure reductions", "rect": [302.979918888637, 129.52903420584542, 533.9620726449148, 137.73215920584542], "fontSize": 8.203125}, {"text": "maintained comparable diagnostic accuracy for both detector-", "rect": [302.979918888637, 119.03794915335516, 533.9843886239188, 127.24107415335514], "fontSize": 8.203124999999986}, {"text": "reconstruction combinations. Lesion detection in the 40-cm", "rect": [302.979918888637, 108.5468641008649, 533.9620726449148, 116.74998910086498], "fontSize": 8.203125000000085}, {"text": "phantom was inferior at smaller exposure reduction than in", "rect": [302.979918888637, 98.05581992013111, 533.9843886239188, 106.2589449201311], "fontSize": 8.203124999999986}, {"text": "the 30-cm phantom.", "rect": [302.979918888637, 87.5758928571428, 378.90625681195934, 95.77901785714288], "fontSize": 8.203125000000071}, {"text": "q", "rect": [302.979918888637, 68.60269219534733, 305.5134057998657, 73.15625544956752], "fontSize": 4.553563254220194}, {"text": "RSNA, 2016", "rect": [307.667418888637, 65.75672027042928, 346.3504518781389, 72.75448608398432], "fontSize": 6.997765813555034}, {"text": "Online supplemental material is available for this article.", "rect": [302.979918888637, 42.36386244637622, 533.6384092058454, 51.15850394112725], "fontSize": 8.794641494751033}, {"text": "Ajit H. Goenka, MD", "rect": [47.99107483455113, 483.1897471291677, 107.48883656093052, 492.18527330671037], "fontSize": 8.995526177542672}, {"text": "Brian R. Herts, MD", "rect": [47.99107483455113, 471.13617570059637, 106.50669847215924, 480.13170187813887], "fontSize": 8.995526177542502}, {"text": "Frank Dong, PhD", "rect": [47.99107483455113, 459.1606999805995, 101.51786123003278, 468.1562363760812], "fontSize": 8.995536395481736}, {"text": "Nan